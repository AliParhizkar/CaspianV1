@page "/Warehouse/Scope"
@inherits BasePage

@{
    base.BuildRenderTree(__builder);
}
<div style="width:600px;margin:10px auto" class="row align-items-center">
    <div class="col-md-1 d-tree-icon text-center pb-1">
        <span @onclick="async () => await ShowEditForm(null, false)" class="fa fa-plus"></span>
    </div>
    <div class="col-md-11 pb-1">
        <StringTextBox @bind-Value="@scopeSearch" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو ..." />
    </div>
    <div>
        <TreeView @ref="tree" TEntity="Scope" style="height:500px"
                  TextFunc="t => t.Title" FilterFunc="t => !scopeSearch.HasValue() || t.Title.StartsWith(scopeSearch)">
            <AfterNodeTemplate>
                <span class="d-tree-icon">
                    <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                    <span class="fa fa-pencil"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await DeleteScope(context)">
                    <span class="fa fa-trash"></span>
                </span>
            </AfterNodeTemplate>
        </TreeView>
    </div>
</div>
<Window @bind-Status="status" Style="width:450px;" OnOpen="async () => await firstControl.FocusAsync()" Title="حوزه">
    <CaspianForm Model="scope" TEntity="Scope" OnValidSubmit="UpsertAddress">
        <StringTextBox @ref="firstControl" @bind-Value="context.Title" ColSpan="9" />
        <WindowCommandButtons ColSpan="9" />
    </CaspianForm>
</Window>
@code
{
    int? scopeId;
    string scopeSearch;
    WindowStatus status;
    Scope scope;
    TreeView<Scope> tree;
    IControl firstControl;

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        if (isUpdate)
        {
            ///Edit mode
            var scopeId = Convert.ToInt32(nodeView.Value);
            using var service = CreateScope().GetService<ScopeService>();
            scope = await service.SingleAsync(scopeId);
        }
        else
        {
            ///Insert mode
            scope = new Scope();
            scope.ParentId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
        }
        status = WindowStatus.Open;
    }

    async Task DeleteScope(NodeView node)
    {
        var scopeId = Convert.ToInt32(node.Value);
        using var service = CreateScope().GetService<ScopeService>();
        var scope = await service.SingleAsync(scopeId);
        var result = await service.ValidateRemoveAsync(scope);
        if (result.IsValid)
        {
            service.Remove(scope);
            await service.SaveChangesAsync();
            tree.RemoveFromTree(scope);
        }
        else
            ShowMessage(result.Errors.First().ErrorMessage);
    }

    async Task<bool> UpsertAddress()
    {
        using var service = CreateScope().GetService<ScopeService>();
        if (scope.Id == 0)
            await service.AddAsync(scope);
        else
            await service.UpdateAsync(scope);
        await service.SaveChangesAsync();
        tree.UpsertInTree(scope);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }
}
