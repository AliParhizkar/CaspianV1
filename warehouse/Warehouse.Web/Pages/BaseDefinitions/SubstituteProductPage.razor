@page "/Warehouse/SubstituteProduct/{ProductId:int}"
@attribute [Source(32, "کالا های جایگزین")]
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div class="row p-3">
    <div class="col-md-5">
        <div>
            <EntitySearch TEntity="Goods" Service="Service">
                <StringTextBox @bind-Value="context.Code" ColSpan="8" SearchType="SearchType.StartWith" Style="direction:ltr" />
                <StringTextBox @bind-Value="context.Name" ColSpan="8" />
            </EntitySearch>
            <div class="col-md-12 text-center">
                <hr class="mt-0" />
                <span class="d-membership">لیست کالاها</span>
            </div>
        </div>
        <DataGrid TEntity="Goods" ContentHeight="250" Service="Service">
            <Columns>
                <GridColumn Field="t => t.Name" />
                <GridColumn Field="t => t.Code" />
                <GridColumn Field="t => t.ProductClass.Name" Title="طبقه کالا" />
            </Columns>
        </DataGrid>
    </div>
    <div class="col-md-1" style="width:60px;">
        <div class="align-content-center text-center h-100">
            <div class="d-btn-container">
                <IconButton IconType="IconType.AngleLeft" @onclick="async () => await Service.Form.SubmitAsync()"/>
                <div class="pt-3">
                    <IconButton type="button" @onclick="async () => await Service.RemoveAsync()" IconType="IconType.AngleRight" />
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div>
            <EntitySearch TEntity="Goods" Service="Service">
                <StringTextBox @bind-Value="context.Code" ColSpan="8" SearchType="SearchType.StartWith" Style="direction:ltr" />
                <StringTextBox @bind-Value="context.Name" ColSpan="8" />
            </EntitySearch>
            <div class="col-md-12 text-center">
                <hr class="mt-0" />
                <span class="d-membership">کالاهای جایگزین</span>
            </div>
        </div>

        <DataGrid TEntity="SubstituteProduct" Service="Service" ContentHeight="250" DeleteMessage="">
            <Columns>
                <GridColumn Field="t => t.SubstituteGoods.Name" />
                <GridColumn Field="t => t.SubstituteGoods.Code" />
                <GridColumn Field="t => t.Rate.DigitGrouping()" />
                <GridColumn Field="t => t.DuplicateRelation" Title="رابطه عکس" style="width:100px;" />
                <GridCommandColumns HideEdit />
            </Columns>
        </DataGrid>
    </div>
    <CaspianForm Service="Service">
        <div class="row pt-3">
            <div class="col-md-2"></div>
            <NumericTextBox @bind-Value="context.Rate" ColSpan="2" TotalSpan="4" />
            <CheckBox @bind-Value="context.DuplicateRelation" ColSpan="2" TotalSpan="4" />
        </div>
    </CaspianForm>
</div>

@code
{
    [Parameter]
    public int ProductId { get; set; }
    MembershipService<Goods, SubstituteProduct, Goods> Service;

    protected override void OnInitialized()
    {
        Service = new MembershipService<Goods, SubstituteProduct, Goods>(base.ServiceProvider, t => t.Goods);
        Service.MasterId = ProductId; /// Set Product Id for service
        base.OnInitialized();
    }
}
