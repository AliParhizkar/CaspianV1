@page "/Warehouse/Branch"
@attribute [Source(1, "شعبه")]
@inherits BasePage
@inject IUIService<Branch> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4 pb-0">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="9" TotalSpan="12" />
    </EntitySearch>
</div>
<div class="p-4 pt-1">
    <DataGrid TEntity="Branch" Service="Service" ContentHeight="350">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="شعبه" Style="width:450px">
    <CaspianForm TEntity="Branch" Service="Service" >
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
        <FormCommandButton ColSpan="8" />
    </CaspianForm>
</Window>

