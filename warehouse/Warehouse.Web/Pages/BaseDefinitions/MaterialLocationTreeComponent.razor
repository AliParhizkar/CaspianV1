<div class="row align-items-center">
    <div class="col-md-1 d-tree-icon text-center pb-1">
        <span @onclick="async () => await ShowEditForm(null, false)" class="fa fa-plus"></span>
    </div>
    <div class="col-md-6 pb-1 ps-3 pe-3">
        <StringTextBox @bind-Value="@titleSearch" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو عنوان" />
    </div>
    <div class="col-md-5 pb-1 ps-3 pe-3">
        <StringTextBox @bind-Value="@codeSearch" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو کذ" />
    </div>
    <div class="ps-3 pe-3">
        <TreeView @ref="tree" TEntity="MaterialLocation" style="height: calc(100vh - 135px) " TextFunc="t => t.Code + ' ' + t.Title"
                  FilterFunc="t => (!titleSearch.HasValue() || t.Title.Contains(titleSearch)) && (!codeSearch.HasValue() || t.Code?.StartsWith(codeSearch) == true)">
            <AfterNodeTemplate>
                <span class="d-tree-icon">
                    <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                    <span class="fa fa-pencil"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await DeleteLocation(context)">
                    <span class="fa fa-trash"></span>
                </span>
                <span class="d-tree-icon" title="کالاها">
                    <a href="/Warehouse/MaterialLocationGoodsPlacement/@(context.Value)">
                        <span class="fa fa-wpforms"></span>
                    </a>
                </span>
            </AfterNodeTemplate>
        </TreeView>
    </div>
</div>
<Window @bind-Status="status" Style="width:475px;" OnOpen="async () => await firstControl.FocusAsync()" Title="محل استقرار کالا">
    <CaspianForm Model="location" TEntity="MaterialLocation" OnValidSubmit="UpsertLocation">
        @if (parentLocation != null)
        {
            <StringTextBox Value="@parentLocation.Code" ColSpan="8" Style="direction:ltr" Title="کد محل استقرار کالا اصلی" Disabled />
            <StringTextBox Value="@parentLocation.Title" ColSpan="8" Style="direction:ltr" Title="نام محل استقرار کالا اصلی" Disabled />
        }
        <StringTextBox @ref="firstControl" @bind-Value="context.Code" ColSpan="8" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
        <WindowCommandButtons ColSpan="9" />
    </CaspianForm>
</Window>

@code
{
    string titleSearch, codeSearch;
    MaterialLocation location;
    WindowStatus status;
    TreeView<MaterialLocation> tree;
    MaterialLocation parentLocation;
    IControl firstControl;

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        parentLocation = null;
        if (isUpdate)
        {
            ///Edit mode
            var locationId = Convert.ToInt32(nodeView.Value);
            using var service = Page.CreateScope().GetService<MaterialLocationService>();
            location = await service.SingleAsync(locationId);
        }
        else
        {
            ///Insert mode
            location = new MaterialLocation();
            location.StockroomId = StockRoomId;
            int? parentId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
            if (parentId == null)
            {
                parentLocation = null;
            }
            else
            {
                using var service = Page.CreateScope().GetService<MaterialLocationService>();
                parentLocation = (await service.SingleAsync(parentId.Value));
                location.ParentLocationId = parentId;
            }
        }
        status = WindowStatus.Open;
    }

    async Task DeleteLocation(NodeView node)
    {
        var locationId = Convert.ToInt32(node.Value);
        using var service = Page.CreateScope().GetService<MaterialLocationService>();
        var location = await service.SingleAsync(locationId);
        var result = await service.ValidateRemoveAsync(location);
        if (result.IsValid)
        {
            service.Remove(location);
            await service.SaveChangesAsync();
            tree.RemoveFromTree(location);
        }
        else
            Page.ShowMessage(result.Errors.First().ErrorMessage);
    }

    async Task<bool> UpsertLocation()
    {
        using var service = Page.CreateScope().GetService<MaterialLocationService>();
        if (location.Id == 0)
            await service.AddAsync(location);
        else
            await service.UpdateAsync(location);
        await service.SaveChangesAsync();
        tree.UpsertInTree(location);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }

    [Parameter]
    public BasePage Page { get; set; }

    [Parameter]
    public int StockRoomId { get; set; }
}

