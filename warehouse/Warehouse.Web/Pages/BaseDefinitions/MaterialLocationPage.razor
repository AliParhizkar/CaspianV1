@page "/Warehouse/MaterialLocation"
@page "/Warehouse/MaterialLocation/{StockroomId:int}"
@inherits BasePage
@attribute [Source(2, "محل فیزیکی کالا")]

@{
    base.BuildRenderTree(__builder);
}

<div style="width:600px;margin:10px auto">
    @if (StockroomId == null)
    {
        <div class="c-controls c-header row ">
            <ComboBox TValue="int?" TEntity="StockRoom" @bind-Value="stockroomId" TextExpression="t => t.Title" ColSpan="9" TotalSpan="12"
                      Title="انبار" OnChange="ReloadData" />
        </div>
    }

    <div class="c-body">
        @if (stockroomId.HasValue)
        {
            <div class="row p-1">
                <div class="col-md-1 text-center">
                    <div class="d-tree-icon ">
                        <span @onclick="async () => await ShowEditForm(null, false)" class="fa fa-plus"></span>
                    </div>
                </div>
                <div class="col-md-11">
                    <StringTextBox @bind-Value="@addressSearch" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو ..." />
                </div>
            </div>
            <div class="p-1">
                <TreeView @ref="tree" TEntity="MaterialLocation" style="height:400px" ConditionExpression="t => t.StockroomId == stockroomId"
                          TextFunc="t => t.Title" FilterFunc="t => !addressSearch.HasValue() || t.Title.StartsWith(addressSearch)">
                    <AfterNodeTemplate>
                        <span class="d-tree-icon">
                            <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
                        </span>
                        <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                            <span class="fa fa-pencil"></span>
                        </span>
                        <span class="d-tree-icon" @onclick="async () => await DeleteAddress(context)">
                            <span class="fa fa-trash"></span>
                        </span>
                    </AfterNodeTemplate>
                </TreeView>
            </div>
        }
    </div>
</div>

<Window @bind-Status="status" Style="width:450px;" OnOpen="async () => await firstControl.FocusAsync()" Title="محل فیزیکی کالا">
    <CaspianForm Model="materialLocation" TEntity="MaterialLocation" OnValidSubmit="UpsertAddress">
        @if (parentNode != null)
        {
            <StringTextBox Value="@parentNode.Code" ColSpan="9" Title="کد" Style="direction:ltr" Disabled />
            <StringTextBox Value="@parentNode.Title" ColSpan="9" Title="عنوان" Disabled />
        }
        <StringTextBox @ref="firstControl" @bind-Value="context.Code" ColSpan="9" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Title" ColSpan="9" />
        <WindowCommandButtons ColSpan="9" />
    </CaspianForm>
</Window>

@code
{
    int? stockroomId;
    string addressSearch;
    WindowStatus status;
    MaterialLocation materialLocation;
    TreeView<MaterialLocation> tree;
    IControl firstControl;
    MaterialLocation parentNode;

    async Task ReloadData()
    {
        if (tree != null)
            await tree.ReloadAsync();
    }

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        using var service = CreateScope().GetService<MaterialLocationService>();
        if (isUpdate)
        {
            ///Edit mode
            var locationId = Convert.ToInt32(nodeView.Value);
            materialLocation = await service.GetAll().Include(t => t.ParentLocation).SingleAsync(locationId);
            parentNode = materialLocation;

        }
        else
        {
            ///Insert mode
            materialLocation = new MaterialLocation();
            materialLocation.ParentLocationId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
            if (materialLocation.ParentLocationId.HasValue)
                parentNode = (await service.SingleAsync(materialLocation.ParentLocationId.Value));
            else
                parentNode = null;
        }
        materialLocation.StockroomId = stockroomId.Value;
        status = WindowStatus.Open;
    }

    async Task DeleteAddress(NodeView node)
    {
        var locationId = Convert.ToInt32(node.Value);
        using var service = CreateScope().GetService<MaterialLocationService>();
        var location = await service.SingleAsync(locationId);
        var result = await service.ValidateRemoveAsync(location);
        if (result.IsValid)
        {
            if (await Confirm("آیا با حذف موافقید؟"))
            {
                service.Remove(location);
                await service.SaveChangesAsync();
                tree.RemoveFromTree(location);
            }
        }
        else
            ShowMessage(result.Errors.First().ErrorMessage);
    }

    async Task<bool> UpsertAddress()
    {
        using var service = CreateScope().GetService<MaterialLocationService>();
        if (materialLocation.Id == 0)
            await service.AddAsync(materialLocation);
        else
            await service.UpdateAsync(materialLocation);
        await service.SaveChangesAsync();
        tree.UpsertInTree(materialLocation);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }

    protected override void OnInitialized()
    {
        if (StockroomId.HasValue)
            stockroomId = StockroomId;
        base.OnInitialized();
    }

    [Parameter]
    public int? StockroomId { get; set; }
}
