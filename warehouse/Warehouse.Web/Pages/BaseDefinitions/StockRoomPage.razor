@page "/Warehouse/StockRoom"
@inherits BasePage
@attribute [Source(20, "انبار")]
@inject IUIService<StockRoom> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4 pb-0">
    <EntitySearch Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        <DropdownList @bind-Value="context.StockRoomType" ColSpan="4" />
    </EntitySearch>
</div>
<div class="p-4 pt-1">
    <DataGrid TEntity="StockRoom" Service="Service" ContentHeight="350">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.StockRoomType.EnumText()" />
            <GridColumn Field="t => t.PricingMethodType.EnumText()" />
            <GridColumn Field="t => t.Code" />
            <GridColumn style="width:60px" Title="آدرس ها">
                <Template>
                    <IconButton IconType="IconType.Wpforms" Href='@($"/Warehouse/MaterialAddress/{context.Data.Id}")' />
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="انبار" Style="width:800px">
    <CaspianForm TEntity="StockRoom" Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        <StringTextBox @bind-Value="context.Code" ColSpan="4" />
        <DropdownList @bind-Value="context.StockRoomType" ColSpan="4" />
        <DropdownList @bind-Value="context.PricingMethodType" ColSpan="4" />
        <ComboBox TValue="int?" TEntity="SimpleData" @bind-Value="context.FinancialUnitId" TextExpression="t => t.Title"
                  ConditionExpression="t => t.DataType == SimpleDataType.FinancialUnit" ColSpan="4" />
        <ComboBox TValue="int?" TEntity="SimpleData" @bind-Value="context.BudgetUnitId" TextExpression="t => t.Title"
                  ConditionExpression="t => t.DataType == SimpleDataType.BudgetUnit" ColSpan="4" />
        <Lookup TValue="int?" TEntity="User" @bind-Value="context.ManagerId" TextExpression='t => t.FName + " " + t.LName' ColSpan="4">
            <UserLookupWindow TValue="int?" />
        </Lookup>
        <LookupTree @bind-Value="context.ScopeId" ColSpan="4">
            <ChildContent Context="scopetitle">
                <TreeView TEntity="Scope" TextFunc="t => t.Title"
                          FilterFunc="t => (!scopetitle.HasValue() || t.Title.StartsWith(scopetitle))" />
            </ChildContent>
        </LookupTree>        <StringTextBox @bind-Value="context.Tel" ColSpan="4" />
        <StringTextBox @bind-Value="context.Mobile" ColSpan="4" />
        <StringTextBox @bind-Value="context.Address" ColSpan="4" MultiLine Rows="3" />
        <StringTextBox @bind-Value="context.Description" ColSpan="4" MultiLine Rows="3" />
        <FormCommandButton ColSpan="12" />
    </CaspianForm>
</Window>

@code
{
    bool IsLeef(Scope scope)
    {
        if (scope.Scopes == null || scope.Scopes.Count() == 0)
            return true;
        return false;
    }
}
