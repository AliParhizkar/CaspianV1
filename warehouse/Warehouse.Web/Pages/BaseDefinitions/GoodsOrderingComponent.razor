@inject IUIService<GoodsOrdering> Service
<div class="p-3">
    <EntitySearch Service="Service" ColumnsCount="2">
        <ComboBox TValue="int" @bind-Value="context.KeepCenterId" TEntity="KeepCenter" TextExpression="t => t.Name" ColSpan="4" 
                  ConditionExpression="t => t.Stocks.Any(u => u.GoodsPlacements.Any(v => v.GoodsId == context.GoodsId))"/>
        <NumericTextBox @bind-Value="context.OrderingPoint" ColSpan="4" />
    </EntitySearch>
    <DataGrid TEntity="GoodsOrdering" Service="Service">
        <Columns>
            <GridColumn Field="t => t.KeepCenter.Name" Title="مرکز نگهداری" />
            <GridColumn Field="t => t.MinimumInventory.DigitGrouping()"  />
            <GridColumn Field="t => t.MaximumInventory.DigitGrouping()"  />
            <GridColumn Field="t => t.OrderingPoint.DigitGrouping()"  />
            <GridColumn Field="t => t.EconomicOrder.DigitGrouping()"  />
            <GridColumn Field="t => t.ConsumeUltimate.DigitGrouping()"  />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Title="اطلاعات سفارش گذاری" Style="width:500px;">
        <CaspianForm Service="Service">
            <ComboBox TValue="int" @bind-Value="context.KeepCenterId" TEntity="KeepCenter" TextExpression="t => t.Name" ColSpan="8"
                      ConditionExpression="t => t.Stocks.Any(u => u.GoodsPlacements.Any(v => v.GoodsId == context.GoodsId))" />
            <NumericTextBox @bind-Value="context.MinimumInventory" DigitGrouping ColSpan="8" />
            <NumericTextBox @bind-Value="context.MaximumInventory" DigitGrouping ColSpan="8" />
            <NumericTextBox @bind-Value="context.OrderingPoint" DigitGrouping ColSpan="8" />
            <NumericTextBox @bind-Value="context.EconomicOrder" DigitGrouping ColSpan="8" />
            <NumericTextBox @bind-Value="context.ConsumeUltimate" ColSpan="8" />
            <FormCommandButton ColSpan="8" />
        </CaspianForm>
    </Window>
</div>

