@page "/Warehouse/Supplier"
@inherits BasePage
@attribute [Source(21, "کارپرداز")]
@inject IUIService<Supplier> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4 pb-0">
    <EntitySearch Service="Service" ColumnsCount="2">
        @{
            context.RelatedUser = context.RelatedUser ?? new();
        }

        <StringTextBox @bind-Value="context.RelatedUser.LName" ColSpan="4" Title="نام خانوادگی" />
        <StringTextBox @bind-Value="context.IdCard" ColSpan="4" />
    </EntitySearch>
</div>
<div class="p-4 pt-1">
    <DataGrid TEntity="Supplier" Service="Service" ContentHeight="350">
        <Columns>
            <GridColumn Field="t => t.RelatedUser.FName" Title="نام" />
            <GridColumn Field="t => t.RelatedUser.LName" Title="نام خانوادگی" />
            <GridColumn Field="t => t.ParentName" />
            <GridColumn Field="t => t.RelatedUser.MobileNumber" Title="همراه" />
            <GridColumn Field="t => t.RelatedUser.UserName" Title="نام کاربری" />
            <GridColumn Field="t => t.IdCard" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="کارپرداز" Style="width:450px">
    <CaspianForm TEntity="Supplier" Service="Service">
        <Lookup TValue="int" TEntity="User" @bind-Value="context.RelatedUserId" TextExpression='t => t.FName + " " + t.LName' ColSpan="8">
            <UserLookupWindow TValue="int" />
        </Lookup>
        <StringTextBox @bind-Value="context.ParentName" ColSpan="8" />
        <StringTextBox @bind-Value="context.IdCard" MaxLength="10" ColSpan="8" />
        <FormCommandButton ColSpan="8" />
    </CaspianForm>
</Window>

