@page "/Warehouse/Goods"
@inherits BasePage
@inject IUIService<Goods> Service
@attribute [Source(4, "تعریف کالا")]
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4 pb-0">
    <EntitySearch Service="Service" ColumnsCount="3">
        <StringTextBox @bind-Value="context.Name" ColSpan="3" TotalSpan="4" />
        <StringTextBox @bind-Value="context.Code" ColSpan="3" TotalSpan="4" Style="direction:ltr" />
        <ComboBox TValue="int" TEntity="MeasurementUnit" @bind-Value="context.MeasurementUnitId" TextExpression="t => t.Name" ColSpan="3" TotalSpan="4" Title="واحد سنجش" />
        <ComboBox TValue="int" TEntity="ProductClass" @bind-Value="context.ProductClassId" TextExpression="t => t.Name" ColSpan="3" TotalSpan="4" />
        <DropdownList @bind-Value="context.GoodsNature" ColSpan="3" TotalSpan="4" />
        <DropdownList @bind-Value="context.ReservationLevel" ColSpan="3" TotalSpan="4" />
    </EntitySearch>
</div>
<div class="p-4 pt-1">
    <DataGrid TEntity="Goods" Service="Service" ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.MeasurementUnit.Name" Title="واحد سنجش" />
            <GridColumn Field="t => t.ProductClass.Name" Title="طبقه کالا" />
            <GridColumn Field="t => t.GoodsNature.EnumText()" />
            <GridColumn Field="t => t.ReservationLevel.EnumText()" />
            <GridColumn Title="کالاهای مشابه" style="width:90px;">
                <Template>
                    <IconButton Href='@($"/Warehouse/SubstituteProduct/{context.Data.Id}")' IconType="IconType.WpfForms" />
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="تعریف کالا" Style="width:850px" >
    <EntityTabPanel TEntity="Goods" Service="Service" Vertical>
        <Content Context="goods">
            <ChildTabPanelItem Child="t => t" ColumnsCount="2">
                <div class="row p-2 ps-0">
                    <ComboBox TValue="int?" TEntity="BarcodePattern" @bind-Value="goods.BarcodePatternId" TextExpression="t => t.Name" ColSpan="4" />
                    <StringTextBox @bind-Value="goods.Code" ColSpan="4" Style="direction:ltr" />
                    <StringTextBox @bind-Value="goods.Name" ColSpan="4" />
                    <ComboBox TValue="int" TEntity="MeasurementUnit" @bind-Value="goods.MeasurementUnitId" TextExpression="t => t.Name" ColSpan="4" />
                    <ComboBox TValue="int" TEntity="ProductClass" @bind-Value="goods.ProductClassId" TextExpression="t => t.Name" ColSpan="4" />
                    <DropdownList @bind-Value="goods.ReservationLevel" ColSpan="4" />
                    <div class="col-md-6 row">
                        <DropdownList @bind-Value="goods.GoodsNature" ColSpan="8" TotalSpan="12" />
                        <RadioList @bind-Value="goods.GoodsType" ShowTitle>
                            <div class="row">
                                <div class="col-md-6">
                                    <RadioItem Value="GoodsType.Purchased" />
                                </div>
                                <div class="col-md-6">
                                    <RadioItem Value="GoodsType.Salable" />
                                </div>
                                <div class="col-md-6">
                                    <RadioItem Value="GoodsType.Construction" />
                                </div>
                                <div class="col-md-6">
                                    <RadioItem Value="GoodsType.OutOfStockItem" />
                                </div>
                            </div>
                        </RadioList>
                    </div>
                    <div class="col-md-6">
                        <CheckBox @bind-Value="goods.SuspendedInIncoming" ColSpan="12" TotalSpan="12" />
                        <CheckBox @bind-Value="goods.SuspendedInOutcoming" ColSpan="12" TotalSpan="12" />
                    </div>
                    <FormCommandButton ColSpan="8" />
                </div>
            </ChildTabPanelItem>
            <ChildrenTabPanelItem Children="t => t.GoodsPlacements">
                <GoodsPlacementComponent />
            </ChildrenTabPanelItem>
        </Content>
    </EntityTabPanel>
</Window>

@code
{
    StringTextBox txtItem;
    IList<PropertyList> list;
    string item;
    PropertyList selectedItem;

    async Task LoadData()
    {
        list = new List<PropertyList>();
        var id = Service.UpsertData.Id;
        if (id > 0)
        {
            using var service = CreateScope().GetService<PropertyListService>();
            list = await service.GetAll().Where(t => t.GoodsPropertyId == id).ToListAsync();
        }
    }

    void InitializeValue(CancelableEvent<GoodsProperties> e)
    {
        var property = e.Entity;
        switch (property.PropertyType)
        {
            case PropertyType.String:
                property.MaximumValue = property.MinimumValue = property.NumberDigit = null;
                if (property.FixLength != true)
                    property.Length = null;
                break;
            case PropertyType.Number:
                property.Length = property.MaxLength = null;
                property.FixLength = null;
                break;
            default:
                property.MaximumValue = property.MinimumValue = property.NumberDigit = property.Length = property.MaxLength = null;
                property.FixLength = null;
                break;
        }
    }
}
