@page "/Warehouse/KeepCenter"
@attribute [Source(2, "مرکز نگهداری")]
@inherits BasePage
@inject IUIService<KeepCenter> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4 pb-0">
    <EntitySearch Service="Service" ColumnsCount="2">
        <ComboBox TValue="int" TEntity="Branch" @bind-Value="context.BranchId" TextExpression="t => t.Title" ColSpan="4" />
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
    </EntitySearch>
</div>
<div class="p-4 pt-1">
    <DataGrid TEntity="KeepCenter" Service="Service" ContentHeight="350">
        <Columns>
            <GridColumn Field="t => t.Branch.Title" Title="شعبه" />
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.Location.Title" Title="محل جغرافیایی" />
            <GridColumn Field="t => t.Tell" />
            <GridColumn Field="t => t.PostCode" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="مرکز نگهداری" Style="width:800px">
    <CaspianForm TEntity="KeepCenter" Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Code" ColSpan="4" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
        <ComboBox TValue="int" TEntity="Location" @bind-Value="context.LocationId" TextExpression="t => t.ParentLocation.Title + ' ' + t.Title" ColSpan="4" />
        <StringTextBox @bind-Value="context.Tell" ColSpan="4" Style="direction:ltr" MaxLength="11" />
        <ComboBox TValue="int" TEntity="Branch" @bind-Value="context.BranchId" TextExpression="t => t.Title" ColSpan="4" />
        <StringTextBox @bind-Value="context.PostCode" ColSpan="4" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Address" ColSpan="10" MultiLine Rows="3" />
        <FormCommandButton ColSpan="4" />
    </CaspianForm>
</Window>

@code
{

}
