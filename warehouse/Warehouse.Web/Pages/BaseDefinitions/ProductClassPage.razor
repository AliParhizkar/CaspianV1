@page "/Warehouse/ProductClass"
@attribute [Source(25, "طبقه کالا")]
@inherits BasePage
@inject IUIService<ProductClass> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4 pb-0">
    <EntitySearch Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
        <StringTextBox @bind-Value="context.Code" ColSpan="4" Style="direction:ltr" />
        <DropdownList @bind-Value="context.PricingMethod" ColSpan="4" />
    </EntitySearch>
</div>
<div class="p-4 pt-1">
    <DataGrid TEntity="ProductClass" Service="Service" ContentHeight="350">
        <Columns>
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.PricingMethod.EnumText()" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="طبقه کالا" Style="width:450px">
    <CaspianForm TEntity="ProductClass" Service="Service">
        <StringTextBox @bind-Value="context.Code" ColSpan="8" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Name" ColSpan="8" />
        <DropdownList @bind-Value="context.PricingMethod" ColSpan="8" />
        <FormCommandButton ColSpan="8" />
    </CaspianForm>
</Window>

