@page "/Warehouse/Product"
@attribute [Source(15, "کالا")]
@inject UIService<Product, ProductDescription> Service
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div class="p-3">
    <DataGrid TEntity="Product" Service="Service" ContentHeight="400"
              DeleteMessage="با حذف کالا ویژگی های آن نیز حذف می شود آیا با حذف موافقید؟">
        <Columns>
            <GridColumn Field="t => t.ProductCategory.Title" Title="گروه کالا" />
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.StandardCode" />
            <GridColumn Field="t => t.MaterialUnit.Title" Title="واحد کالا" />
            <GridColumn Field="t => t.ProductType.EnumText()" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="کالا - ویژگی های کالا" Style="width:850px;">
    <CaspianForm Service="Service" ColumnsCount="2">
        <Lookup TValue="int" TEntity="ProductCategory" @bind-Value="context.CategoryId" TextExpression='t => t.Code + " : " + t.Title'
                CloseFunc="t => t.Code.Length == 8" ColSpan="4" Title="گروه محصول">
            <CategoryCodingLookup TValue="int" />
        </Lookup>
        <StringTextBox @bind-Value="context.Code" Style="direction:ltr" ColSpan="4" />
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
        <StringTextBox @bind-Value="context.StandardCode" Style="direction:ltr" ColSpan="4" />
        <ComboBox TValue="int" TEntity="MaterialUnit" @bind-Value="context.MaterialUnitId" TextExpression="t => t.Title" ColSpan="4" />
        <NumericTextBox @bind-Value="context.OrderPoint" ColSpan="4" />
        <NumericTextBox @bind-Value="context.Maximum" ColSpan="4" />
        <DropdownList @bind-Value="context.ProductType" ColSpan="4" />
        <StringTextBox @bind-Value="context.TechnicalCode" ColSpan="4" Style="direction:ltr" />
        <NumericTextBox @bind-Value="context.WarningDate" ColSpan="2" TotalSpan="4" />
        <div class="col-md-2">روز قبل</div>
        <NumericTextBox @bind-Value="context.StandardPrice" ColSpan="4" Title="قیمت استاندارد" />
        <FormCommandButton ColSpan="6" TotalSpan="6" />
    </CaspianForm>
    <DataGrid TEntity="ProductDescription" DetailsService="Service" PageSize="5" ContentHeight="150" Inline AutoHide>
        <Columns Context="description">
            <GridColumn Field="t => t.Name">
                <EditTemplate>
                    <StringTextBox @bind-Value="description.Data.Name" />
                </EditTemplate>
            </GridColumn>
            <GridColumn Field="t => t.DescriptionType.EnumText()">
                <EditTemplate>
                    <DropdownList @bind-Value="description.Data.DescriptionType" />
                </EditTemplate>
            </GridColumn>
            <GridColumn Field="t => t.Value">
                <EditTemplate>
                    @switch (description.Data.DescriptionType)
                    {
                        case DescriptionType.String:
                            <StringTextBox @bind-Value="description.Data.Value" />
                            break;
                        case DescriptionType.Numerical:
                            decimal value = 0;
                            decimal.TryParse(description.Data.Value, out value);
                            description.Data.Value = value.ToString();
                            <NumericTextBox Id="Ali12345" TValue="decimal" Value="value" ValueChanged="t => description.Data.Value = t.ToString()" />
                            break;
                        case DescriptionType.Date:
                            DateOnly date = DateTime.Now.ToDateOnly();
                            DateOnly.TryParse(description.Data.Value, out date);
                            <DatePicker TValue="DateOnly" Value="date" ValueChanged="t => description.Data.Value = t.ToShortDateString()" />
                            break;
                    }
                </EditTemplate>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</Window>

