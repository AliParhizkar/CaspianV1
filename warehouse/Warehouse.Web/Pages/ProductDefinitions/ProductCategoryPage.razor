@page "/Warehouse/ProductCategory"
@attribute [Source(14, "گروه محصول")]
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div style="width:600px;margin:10px auto" class="row align-items-center">
    <div class="col-md-1 d-tree-icon text-center pb-1">
        <span @onclick="async () => await ShowEditForm(null, false)" class="fa fa-plus"></span>
    </div>
    <div class="col-md-11 pb-1">
        <StringTextBox @bind-Value="@categorySearch" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو ..." />
    </div>
    <div>
        <TreeView @ref="tree" TEntity="ProductCategory" style="height:500px"
                  TextFunc='t => t.Code + " : " + t.Title' FilterFunc="t => !categorySearch.HasValue() || t.Title.StartsWith(categorySearch)">
            <AfterNodeTemplate>
                <span class="d-tree-icon">
                    <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                    <span class="fa fa-pencil"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await DeleteScope(context)">
                    <span class="fa fa-trash"></span>
                </span>
            </AfterNodeTemplate>
        </TreeView>
    </div>
</div>
<Window @bind-Status="status" Style="width:450px;" OnOpen="async () => await firstControl.FocusAsync()" Title="گروه بندی کالا">
    <CaspianForm Model="category" TEntity="ProductCategory" OnValidSubmit="UpsertAddress">
        <StringTextBox @ref="firstControl" @bind-Value="context.Title" ColSpan="9" />
        <StringTextBox @bind-Value="context.Code" ColSpan="9" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Description" MultiLine Rows="3" ColSpan="9" />
        <WindowCommandButtons ColSpan="9" />
    </CaspianForm>
</Window>
@code
{
    int? categoryId;
    string categorySearch;
    WindowStatus status;
    ProductCategory category;
    TreeView<ProductCategory> tree;
    IControl firstControl;

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        if (isUpdate)
        {
            ///Edit mode
            var scopeId = Convert.ToInt32(nodeView.Value);
            using var service = CreateScope().GetService<ProductCategoryService>();
            category = await service.SingleAsync(scopeId);
        }
        else
        {
            ///Insert mode
            category = new();
            category.CategoryId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
        }
        status = WindowStatus.Open;
    }

    async Task DeleteScope(NodeView node)
    {
        var categoryId = Convert.ToInt32(node.Value);
        using var service = CreateScope().GetService<ProductCategoryService>();
        var old = await service.SingleAsync(categoryId);
        var result = await service.ValidateRemoveAsync(old);
        if (result.IsValid)
        {
            if (await Confirm("آیا با حذف گروه محصول موافقید؟"))
            {
                await service.RemoveAsync(categoryId);
                await service.SaveChangesAsync();
                tree.RemoveFromTree(category);
            }
        }
        else
            ShowMessage(result.Errors.First().ErrorMessage);
    }

    async Task<bool> UpsertAddress()
    {
        using var service = CreateScope().GetService<ProductCategoryService>();
        if (category.Id == 0)
            await service.AddAsync(category);
        else
            await service.UpdateAsync(category);
        await service.SaveChangesAsync();
        tree.UpsertInTree(category);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }
}
