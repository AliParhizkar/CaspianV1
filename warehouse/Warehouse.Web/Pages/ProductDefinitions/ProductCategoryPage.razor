@page "/Warehouse/ProductCategory"
@attribute [Source(14, "گروه محصول")]
@inherits BasePage
@inject IUIService<ProductCategory> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="row">
    <div style="width:80px">
        <RadioList @bind-Value="treeView" DefaultLayout="DefaultLayout.FlexStart">
            <RadioItem Value="true" IconType="IconType.Tree" />
            <RadioItem Value="false" IconType="IconType.Outdent" />
        </RadioList>
    </div>
    <div style="width:calc(100% - 80px)">
        @if (treeView)
        {
            <ProductCategoryTreeComponent Page="this" />
        }
        else
        {
            <div style="width:800px;margin:10px auto;">
                <EntitySearch Service="Service" ColumnsCount="2">
                    <StringTextBox @ref="textBox" @bind-Value="context.Code" ColSpan="4" TotalSpan="6" Style="direction:ltr" Title="کد" SearchType="SearchType.StartWith" />
                    <DropdownList @bind-Value="searchLevel" Source="source" SingleSelect NoSelectText="همه سطوح" ColSpan="4" TotalSpan="6" Title="سطح" />
                    <StringTextBox @bind-Value="context.Title" ColSpan="10" />
                </EntitySearch>
                <DataGrid TEntity="ProductCategory" Service="Service" ConditionExpr="t => searchLevel == null || t.Level == searchLevel">
                    <Columns>
                        <GridColumn Field="t => t.Code" />
                        <GridColumn Field="t => t.Title" />
                        <GridColumn Field="t => t.Level" DataField />
                        <GridColumn style="width:40px">
                            <Template>
                                <IconButton @onclick="async() => await MoveUpCategory(context.Data)" IconType="IconType.AngleDoubleUp" Disabled="context.Data.Level == 1" />
                            </Template>
                        </GridColumn>
                        <GridColumn style="width:80px" Title="گروه فرعی">
                            <Template>
                                <IconButton @onclick="async () => await MoveDownCategoryAndOpenWindow(context.Data)" IconType="IconType.Plus" Disabled="context.Data.Level == 5" />
                            </Template>
                        </GridColumn>
                        <GridColumn style="width:40px">
                            <Template>
                                <IconButton @onclick="async() => await MoveDownCategory(context.Data)" IconType="IconType.AngleDoubleDown" Disabled="context.Data.Level == 5" />
                            </Template>
                        </GridColumn>
                    </Columns>
                </DataGrid>
            </div>
            <Window Service="Service" Title="گروه کالا" Style="width:450px" OnOpen="OpenWindow">
                <CaspianForm Service="Service">
                    @{
                        var maskedText = parentCategory?.Code ?? "";
                        for (var index = 0; index < ProductCategoryService.LevelsLength[context.Level - 1]; index++)
                            maskedText += '_';
                        if (parentCategory != null)
                        {
                            <StringTextBox Value="@parentCategory.Code" Style="direction:ltr" ColSpan="8" Disabled Title="کد گروه اصلی" />
                            <StringTextBox Value="@parentCategory.Title" Disabled Title="نام گروه اصلی" ColSpan="8" />
                        }
                    }

                    <StringTextBox @bind-Value="context.Code" ColSpan="8" MaskedText="@maskedText" Style="direction:ltr" />
                    <StringTextBox @bind-Value="context.Title" ColSpan="8" />
                    <FormCommandButton ColSpan="8" />
                </CaspianForm>
            </Window>
        }
    </div>
</div>

@code
{
    bool treeView = false;
    StringTextBox textBox;
    int? searchLevel;
    IList<SelectListItem> source;
    ProductCategory parentCategory;

    async Task OpenWindow()
    {
        var category = Service.UpsertData;
        category.Level = searchLevel ?? 1;
        if (category.Id == 0)
        {
            if (searchLevel > 0)
            {
                using var service = CreateScope().GetService<ProductCategoryService>();
                parentCategory = await service.GetAll().SingleAsync(t => t.Code == Service.Search.Code);
                category.CategoryId = parentCategory.Id;
            }
        }
    }

    protected override void OnInitialized()
    {
        source = SelectListItem.CreateList("سطح اول", "سطح دوم", "سطح سوم", "سطح چهارم", "سطح پنجم");
        foreach (var item in source)
            item.Value = $"{Convert.ToInt32(item.Value) + 1}";
        source.Insert(0, new SelectListItem(null, "همه سطوح"));
        base.OnInitialized();
    }

    async Task MoveDownCategory(ProductCategory category)
    {
        await textBox.SetValueOnClientAsync(category.Code);
        searchLevel = category.Level + 1;
        await Service.DataView.ReloadAsync();
    }

    async Task MoveUpCategory(ProductCategory category)
    {
        var length = ProductCategoryService.LevelsLength[category.Level - 1];
        var code = category.Code;
        code = code.Substring(0, code.Length - length);
        await textBox.SetValueOnClientAsync(code);
        await Service.DataView.ReloadAsync();
    }

    async Task MoveDownCategoryAndOpenWindow(ProductCategory category)
    {
        await MoveDownCategory(category);
        await Service.OpenWindow(null);
    }
}
