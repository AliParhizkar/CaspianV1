@page "/Warehouse/ReceiptDetails"
@page "/Warehouse/ReceiptDetails/{ReceiptId:int}"
@inherits BasePage

@attribute [Source(4, "چزئیات حواله")]
@inject UIService<Receipt, ReceiptDetails> Service
<div class="p-3">
    <CaspianForm Service="Service" ColumnsCount="2">
        <DatePicker @bind-Value="context.ReceiptDate" ColSpan="4" />
        <StringTextBox @bind-Value="context.No" ColSpan="4" />
        <ComboBox TEntity="Seller" TValue="int?" @bind-Value="context.SellerId" TextExpression="t => t.Name" ColSpan="4" />
        <ComboBox TEntity="Supplier" TValue="int?" @bind-Value="context.SupplierId" TextExpression="t => t.RelatedUser.FName + ' ' + t.RelatedUser.LName" ColSpan="4" />
        <div class="col-md-6 row pb-2">
            <StringTextBox @bind-Value="context.Description" MultiLine Rows="3" ColSpan="8" TotalSpan="12" />
        </div>
        <div class="col-md-6 row pb-2">
            <DropdownList @bind-Value="context.ReceiptType" ColSpan="8" TotalSpan="12" />
            <div class="row">
                <div class="col-md-4"></div>
                <div class="col-md-8 row align-items-center">
                    <div class="col-md-3 text-center">
                        <span class="fa fa-chevron-right c-small-icon" @onclick="SelectNextReceipt"></span>
                    </div>
                    <div class="col-md-6 text-center">
                        <FormCommandButton ColSpan="12" TotalSpan="12" />
                    </div>
                    <div class="col-md-3 text-center">
                        <span class="fa fa-chevron-left c-small-icon" @onclick="SelectPreReceipt"></span>
                    </div>
                </div>
            </div>
        </div>
    </CaspianForm>

    <DataGrid DetailsService="Service" TEntity="ReceiptDetails" ContentHeight="250" Inline>
        <Columns Context="con">
            <GridColumn Field="t => t.Product.Name" Title="کالا">
                <EditTemplate>
                    <Lookup TEntity="Product" TValue="int" @bind-Value="con.Data.ProductId" 
                            HideHeader AutoHide TextExpression="t => t.Name">
                        <ProductLookupWindow />
                    </Lookup>
                </EditTemplate>
            </GridColumn>
            <GridColumn Field="t => t.Quantity">
                <EditTemplate>
                    <NumericTextBox @bind-Value="con.Data.Quantity" />
                </EditTemplate>
            </GridColumn>
            <GridColumn Field="t => t.Price">
                <EditTemplate>
                    <NumericTextBox @bind-Value="con.Data.Price" DigitGrouping />
                </EditTemplate>
            </GridColumn>
            <GridColumn Field="t => t.ExpireDate">
                <EditTemplate>
                    <DatePicker @bind-Value="con.Data.ExpireDate" />
                </EditTemplate>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

@code
{
    int curentReceiptId;

    async Task SelectNextReceipt()
    {
        using var service = CreateScope().GetService<ReceiptService>();
        var query = service.GetAll();
        if (curentReceiptId > 0)
        {
            query = query.Where(t => t.Id < curentReceiptId);
            var maxId = await query.MaxAsync(t => (int?)t.Id);
            if (maxId.HasValue)
            {
                curentReceiptId = maxId.Value;
                await Service.ReloadForUpdate(curentReceiptId);
            }
        }
    }

    async Task SelectPreReceipt()
    {
        using var service = CreateScope().GetService<ReceiptService>();
        var query = service.GetAll();
        if (curentReceiptId > 0)
            query = query.Where(t => t.Id > curentReceiptId);
        var minId = await query.MinAsync(t => (int?)t.Id);
        if (minId.HasValue)
        {
            curentReceiptId = minId.Value;
            await Service.ReloadForUpdate(curentReceiptId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ReceiptId > 0)
            await Service.ReloadForUpdate(ReceiptId);
        curentReceiptId = ReceiptId;
        await base.OnParametersSetAsync();
    }

    [Parameter]
    public int ReceiptId { get; set; }

}
