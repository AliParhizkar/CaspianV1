<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @if (HttpContext.Request.Path.StartsWithSegments("/ReportPage"))
    {
        <link rel="stylesheet" href="/css/Report.css" />
        <link rel="stylesheet" href="/css/app.css" />
        <link href="/_content/UIComponent.Client/bootstrap/bootstrap.min.css" rel="stylesheet" />
        <link href="/_content/UIComponent.Client/2011.1.315/Caspian.common1.css" rel="stylesheet" type="text/css" />
        <link href="/_content/UIComponent.Client/2011.1.315/Caspian.silver.css" rel="stylesheet" type="text/css" />
        <link href="/_content/UIComponent.Client/2011.1.315/Caspian.rtl.css" rel="stylesheet" type="text/css" />
        <link href="/_content/UIComponent.Client/css/font-awesome.min.css" rel="stylesheet" />
        <script src="/_content/UIComponent.Client/caspian.bundle.js"></script>
    }
    else
    {
        <link href="/_content/Demo.Web/css/site.css" rel="stylesheet" />
        <link href="/_content/UIComponent/Content/bootstrap/bootstrap.min.css" rel="stylesheet" />
        <link href="/css/site.css" rel="stylesheet" />
        <link href="/_content/UIComponent/Content/2011.1.315/Caspian.common1.css" rel="stylesheet" type="text/css" />
        <link href="/_content/UIComponent/Content/Caspian.common.css" rel="stylesheet" type="text/css" />
        <link href="/_content/UIComponent/Content/2011.1.315/Caspian.silver.css" rel="stylesheet" type="text/css" />
        <link href="/_content/UIComponent/Content/2011.1.315/Caspian.rtl.css" rel="stylesheet" type="text/css" />
        <link href="/Main.styles.css" rel="stylesheet">
        <link href="/_content/UIComponent/Content/css/font-awesome.min.css" rel="stylesheet" />
        <link href="/_content/UIComponent/Content/2011.1.315/jquery.ui.accordion.min.css" rel="stylesheet" />
        <script src="/_content/UIComponent/caspian.bundle.js"></script>
    }
    <link href="Main.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@RenderModeForPage" />
</head>
<body class="t-ltr">
    <Routes @rendermode="@RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    IComponentRenderMode RenderModeForPage
    {
        get
        {
            var path = HttpContext.Request.Path;
            if (path.StartsWithSegments("/Account") || path.StartsWithSegments("/ReportPage"))
                return null;
            return InteractiveServer;
        }
    }
}
