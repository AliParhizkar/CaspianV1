@namespace Test
@using System.Linq.Expressions
@using System.Reflection
@using Caspian.Common.Service
@using Demo.Service

@typeparam TEntity where TEntity : class
@typeparam TDetail where TDetail : class
@inject IServiceScopeFactory Factory
@{
    var detail = GetDetail();
}
<Caspian.UI.TabPanelItem Title="@Title">
    <Caspian.UI.CaspianForm Model="detail" OnValidSubmit="OnValidSubmit">
        <Caspian.UI.CaspianValidationValidator ValidatorType="GetServiceType()" />
        @if (Content != null)
        {
            @Content(detail)
        }
    </Caspian.UI.CaspianForm>
</Caspian.UI.TabPanelItem>


