@namespace Test
@using Demo.Service
@typeparam TEntity where TEntity:class
@attribute [CascadingTypeParameter(nameof(TEntity))]
<Caspian.UI.TabPanel>
    <Tabs>
        <CascadingValue Value="Entity">
            @ChildContent(Entity)
        </CascadingValue>
    </Tabs>
</Caspian.UI.TabPanel>


@code 
{
    [Parameter]
    public TEntity Entity { get; set; }

    [Parameter]
    public RenderFragment<TEntity> ChildContent { get; set; }
}
