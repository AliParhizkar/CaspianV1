@namespace Test
@using Demo.Service
@typeparam TEntity where TEntity:class
@attribute [CascadingTypeParameter(nameof(TEntity))]

<Caspian.UI.TabPanel Vertical="Vertical" Style="height:500px">
    <Tabs>
        <CascadingValue Value="this">
            @ChildContent(Service.UpsertData)
        </CascadingValue>
    </Tabs>
</Caspian.UI.TabPanel>


@code 
{


    [Parameter]
    public RenderFragment<TEntity> ChildContent { get; set; }

    [Parameter]
    public IUIService<TEntity> Service { get; set; }

    [Parameter]
    public bool Vertical { get; set; }

    public void ChangeState()
    {
        StateHasChanged();
    }
}
