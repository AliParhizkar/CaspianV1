@namespace Test
@using Demo.Service
@typeparam TEntity where TEntity:class
@attribute [CascadingTypeParameter(nameof(TEntity))]
<Caspian.UI.TabPanel>
    <Tabs>
        <CascadingValue Value="entity">
            @ChildContent(entity)
        </CascadingValue>
    </Tabs>
</Caspian.UI.TabPanel>


@code 
{
    TEntity entity;
    protected override void OnInitialized()
    {
        entity = Activator.CreateInstance<TEntity>();
        base.OnInitialized();
    }

    [Parameter]
    public RenderFragment<TEntity> ChildContent { get; set; }
}
