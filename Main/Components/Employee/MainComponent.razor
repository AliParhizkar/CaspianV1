@namespace Test
<div class="row p-3 c-controls">
    <div class="col-md-2">
        <label>First Name</label>
    </div>
    <div class="col-md-4">
        <StringTextBox @bind-Value="Employee.FName" />
    </div>
    <div class="col-md-2 ps-3">
        <label>Last Name</label>
    </div>
    <div class="col-md-4">
        <StringTextBox @bind-Value="Employee.LName" />
    </div>
    <div>
        <FormCommandButton />
    </div>
</div>
@code 
{
    [Parameter]
    public Employee Employee { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }
}
