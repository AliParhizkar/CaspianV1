@page "/Test"
@inherits BasePage
@{ 
    base.BuildRenderTree(__builder);
}

@inject IUIService<Test> Service
<button @onclick="async() => await UpsertAsync()">Test</button>

@code
{
    async Task UpsertAsync()
    {
        for (var index1 = 0; index1 < 1000; index1++)
        {
            var list = new List<Test>();
            for (var index = 0; index < 100; index++)
            {
                var guid = Guid.NewGuid().ToString().Replace("-", "");
                list.Add(new Test() { Name = guid });
            }
            using var service = CreateScope().GetService<TestService>();
            await service.AddRangeAsync(list);
        }
    }
}
