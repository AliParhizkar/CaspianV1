@page "/Test"
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
@if (flag)
{
    <div style="width:500px; margin:5px auto">
        <StringTextBox @bind-Value="text" @ref="txt" MultiLine />
    </div>
}

<button @onclick="FocuseAsync">Add</button>

@code
{
    bool flag;
    string text;
    StringTextBox txt;

    async Task FocuseAsync()
    {
        flag = true;
        await Task.Delay(1);
        await txt.FocusAsync();
    }
}
