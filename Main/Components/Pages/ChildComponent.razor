@page "/Test111"
@using Caspian.UI
@using Demo.Model
@using Microsoft.EntityFrameworkCore
@using Stimulsoft.Report
@using Stimulsoft.Report.Blazor
@using Syncfusion.Blazor.DropDowns



<Stimulsoft.Report.Blazor.StiBlazorDesigner  />


@code
{
    StiReport report;

    protected override void OnInitialized()
    {
        var customers = new Context().Customers.AsQueryable().ToList();
        report = new StiReport();
        report.RegBusinessObject("list", customers);
        base.OnInitialized();
    }

    [CascadingParameter]
    public int Value { get; set; }

}
