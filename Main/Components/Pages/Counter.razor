@page "/counter"
@using Caspian.Common
@using Caspian.Common.Extension
@using Caspian.Engine.Service
@using Caspian.UI
@using Demo.Model
@using Demo.Service
@using Microsoft.EntityFrameworkCore
@inject IServiceProvider provider

@inject UIService<Employee> Service
@inject UIService<Family> FamilyService
@inject UIService<Address> AddressService

@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}






