@inherits BasePage
@using Microsoft.EntityFrameworkCore 
@page "/counter"
@namespace Main.Test

<button @onclick="UpdateDataBase">Update DataBase</button>



@code
{
    void UpdateDataBase()
    {
        using var eContext = new Caspian.Engine.Model.Context();
        eContext.Database.Migrate();
        using var dContext = new Demo.Model.Context();
        dContext.Database.Migrate();
        using var mContext = new Marketing.Model.MarketingContext();
        mContext.Database.Migrate();
    }

    string code;

    bool CloseFunc(AccountCoding coding)
    {
        code = coding.Code;
        return coding.Level == 3;
    }
}
