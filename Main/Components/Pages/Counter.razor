@inherits BasePage
@page "/counter"
@namespace Main.Test

<div style="width:400px;margin:5px auto">
    <Lookup TValue="int?" TEntity="AccountCoding" TextExpression="t => t.Title" CloseFunc="CloseFunc">
        <Main.Components.Pages.CodingLookup />
    </Lookup>
</div>



@code
{
    string code;

    bool CloseFunc(AccountCoding coding)
    {
        code = coding.Code;
        return coding.Level == 3;
    }
}
