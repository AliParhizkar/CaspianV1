@page "/counter"
<div style="width:350px;margin: 5px auto; height:150px">
    <StringTextBox @bind-Value="str" MultiLine Rows="3" />
</div>
<button @onclick="() => IncCounter()">Inc</button>
@code 
{
    string str;
    int counter;
    void IncCounter()
    {
        counter++;
        str = counter.ToString();
    }
}
