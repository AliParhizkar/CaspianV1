@page "/counter"
@using Caspian.Engine.Service
@using Demo.Service
@inject IServiceProvider provicer;
@inherits BasePage
@inject ISearchService<Customer> customerEnumSearch
<div style="width:600px;margin:0 auto">
    <EntitySearch Service="customerEnumSearch">
        <DropdownList @bind-Value="context.CustomerType" ColSpan="8" />
        <DropdownList @bind-Value="context.Gender" ColSpan="8" />
    </EntitySearch>
    <DataGrid TEntity="Customer" ShowInsertIcon="false" Service="customerEnumSearch">
        <Columns>
            <GridColumn Field='t => t.CustomerType == CustomerType.Real ? t.FName + " " + t.LName : t.CompanyName' Title="Name" />
            <GridColumn Field="t => t.CustomerType.EnumText()" />
            <GridColumn Field="t => t.Gender.EnumText()" />
        </Columns>
    </DataGrid>
</div>


