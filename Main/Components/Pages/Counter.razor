<div style="width:80%;margin:10px auto">
    <Test.TabPaneEntity TEntity="Employee" Service="Service">
        <Test.ChildTabPanelItem Child="t => t" Title="مشخصات اصلی">
            <Content Context="emp">
                <Test.MainComponent Employee="emp" />
            </Content>
        </Test.ChildTabPanelItem>
        <Test.ChildTabPanelItem Child="t => t.Family" Title="مشخصات خانوادگی">
            <Content Context="family">
                <Test.FamilyComponent Family="family" />
            </Content>
        </Test.ChildTabPanelItem>
        <Test.ChildrenTabPanelItem Children="t => t.CourseStudies" Title="تحصیلات">
            <Content Context="service">
                <Test.CourseStudyComponent Service="service" />
            </Content>
        </Test.ChildrenTabPanelItem>
    </Test.TabPaneEntity>
</div>



