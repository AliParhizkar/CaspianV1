@inherits BasePage
@page "/Default"
@using Caspian.UI
@using Demo.Model
@using Demo.Service
@using Microsoft.EntityFrameworkCore
@implements IDisposable

<button @onclick="Cancel">Operate</button>

@code 
{
    System.Timers.Timer timer;

    protected override void OnInitialized()
    {
        if (timer == null)
        {
            timer = new System.Timers.Timer();
            timer.Interval = 10_000;
            timer.Enabled = true;

            timer.Elapsed += (sender, e) =>
            {
               
            };
            timer.Start();
        }

        base.OnInitialized();
    }



    void Cancel()
    {
        timer.Stop();
        timer.Start();
    }

    void IDisposable.Dispose()
    {
        timer?.Dispose();
    }
}
