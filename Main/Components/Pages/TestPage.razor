@page "/Test1"
@inject IUIService<Product> Service
@{ 
    var title = $"Category{counter}";
}
<span>@(title)</span>
<button @onclick="IncCounter">Test</button>
<div class="p-4">
<EntitySearch Service="Service" ColumnsCount="2">
    <CheckBox @bind-Value="context.OutofStock" ColSpan="4" />
</EntitySearch>
    <DataGrid Service="Service" TEntity="Product">
        <Columns>
            <GridColumn Field="t => t.ProductCategory.Title" Id="1" Title="@(title)" />
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.OutofStock" />
            <GridColumn Field="t => t.Price.DigitGrouping()" />
            <GridColumn Field="t => t.Discount.DigitGrouping()" />
        </Columns>
    </DataGrid>
</div>

@code
{
    int counter = 50;

    void IncCounter()
    {
        counter++;
    }
}
