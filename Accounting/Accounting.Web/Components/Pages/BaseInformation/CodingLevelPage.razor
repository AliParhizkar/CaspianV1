@page "/Accounting/CodingLevel"
@attribute [Source(36, "تعریف سطوح کدینگ")]
@inherits BasePage
@{ 
    base.BuildRenderTree(__builder);
}

@inject IUIService<CodingLevel> Service

<div style="width:80%;margin:5px auto">
    <DataGrid TEntity="CodingLevel" Service="Service">
        <Columns>
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.Length" />
            <GridColumn Field="t => t.CodingLevelType.EnumText()" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Title="عنوان سطوح کدینگ" Style="width:400px;" Service="Service" OnOpen="FilleCodingLevels">
        <CaspianForm Service="Service" TEntity="CodingLevel">
            <StringTextBox @bind-Value="context.Name" ColSpan="8" />
            <NumericTextBox @bind-Value="context.Length" ColSpan="8" />
            <DropdownList @bind-Value="context.CodingLevelType" ColSpan="8" FilterFunc="t => levelTypes?.Contains(t) != true" />
            <StringTextBox @bind-Value="context.Description" ColSpan="8" MultiLine Rows="3" />
            <FormCommandButton ColSpan="8" />
        </CaspianForm>
    </Window>
</div>


@code
{
    IList<CodingLevelType> levelTypes;
    async Task FilleCodingLevels()
    {
        using var service = CreateScope().GetService<CodingLevelService>();
        levelTypes = await service.GetAll().Select(t => t.CodingLevelType).ToListAsync();
    }
}
