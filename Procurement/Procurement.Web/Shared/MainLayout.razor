@namespace Procurement.Web
@inherits LayoutComponentBase
@using Caspian.Engine.Shared
@using System.Reflection
<MainLayoutComponent PageId="pageId" RightToLeft>
    @Body
</MainLayoutComponent>

@code
{
    int? pageId;
    protected override void OnParametersSet()
    {
        pageId = (Body.Target as RouteView)?.RouteData.PageType.GetCustomAttribute<SourceAttribute>()?.Id;
        base.OnParametersSet();
    }
}