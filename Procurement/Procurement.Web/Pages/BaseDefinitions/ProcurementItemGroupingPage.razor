@page "/Procurement/ProcurementItemGrouping/{GroupId:int}"
@attribute [Source(19, "گروه بندی اقلام خریدنی")]
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<div class="row p-3">
    <div class="col-md-5">
        <div>
            <EntitySearch TEntity="ProcurementItem" Service="Service">
                <DropdownList @bind-Value="context.ProcurementItemType" ColSpan="8" SingleSelect />
                @if (context.ProcurementItemType == ProcurementItemType.Goods)
                {
                    <Lookup TValue="int?" TEntity="Warehouse.Model.Goods" @bind-Value="context.GoodsId" TextExpression="t => t.Name" 
                            ColSpan="8" HideHeader OpenOnFocus>
                        <GoodsLookupWindow />
                    </Lookup>
                }
                else
                {
                    <Lookup TValue="int?" TEntity="Service" @bind-Value="context.ServiceId" TextExpression="t => t.Name" ColSpan="8"
                            HideHeader OpenOnFocus>
                        <ServiceLookupWindow />
                    </Lookup>
                }
                <CheckBox @bind-Value="context.ISActive" ColSpan="8" />
            </EntitySearch>
            <div class="col-md-12 text-center">
                <hr class="mt-0" />
                <span class="d-membership">سایر اقلام خریدنی</span>
            </div>
        </div>
        <DataGrid TEntity="ProcurementItem" ContentHeight="250" Service="Service">
            <Columns>
                <GridColumn Field="t => t.ProcurementItemType.EnumText()" />
                <GridColumn Field="t => t.ProcurementItemType == ProcurementItemType.Goods ? t.Goods.Code : t.Service.Code" Title="کد" />
                <GridColumn Field="t => t.ProcurementItemType == ProcurementItemType.Goods ? t.Goods.Name : t.Service.Name" Title="نام" />
                <GridColumn Field="t => t.ProcurementItemType == ProcurementItemType.Goods ? t.Goods.MeasurementUnit.Name : t.Service.MeasurementUnit.Name" Title="واحد سنجش" />
                <GridColumn Field="t => t.ISActive" />
            </Columns>
        </DataGrid>
    </div>
    <div class="col-md-1">
        <div class="align-content-center h-100 text-center">
            <CaspianForm Service="Service">
                <div class="d-btn-container">
                    <div>
                        <IconButton @onclick="AddSelectedSuppliersToGroup" type="button" IconType="IconType.AngleDoubleLeft" />
                    </div>
                    <div>
                        <IconButton IconType="IconType.AngleLeft" />
                    </div>
                    <div>
                        <IconButton type="button" @onclick="async () => await Service.RemoveAsync()" IconType="IconType.AngleRight" />
                    </div>
                    <div>
                        <IconButton type="button" @onclick="DeleteSelectedSuppliersFromGroup" IconType="IconType.AngleDoubleRight" />
                    </div>
                </div>
            </CaspianForm>
        </div>
    </div>
    <div class="col-md-6">
        <div>
            <EntitySearch TEntity="ProcurementItemGrouping" Service="Service">
                <DropdownList @bind-Value="context.ProcurementItem.ProcurementItemType" ColSpan="8" SingleSelect />
                @if (context.ProcurementItem.ProcurementItemType == ProcurementItemType.Goods)
                {
                    <Lookup TValue="int?" TEntity="Warehouse.Model.Goods" @bind-Value="context.ProcurementItem.GoodsId" TextExpression="t => t.Name" ColSpan="8">
                        <GoodsLookupWindow />
                    </Lookup>
                }
                else
                {
                    <Lookup TValue="int?" TEntity="Service" @bind-Value="context.ProcurementItem.ServiceId" TextExpression="t => t.Name" ColSpan="8">
                        <ServiceLookupWindow />
                    </Lookup>
                }
                <CheckBox @bind-Value="context.ProcurementItem.ISActive" ColSpan="8" />
            </EntitySearch>
            <div class="col-md-12 text-center">
                <hr class="mt-0" />
                <span class="d-membership">اقلام عضو گروه</span>
            </div>
        </div>
        <DataGrid TEntity="ProcurementItemGrouping" Service="Service" ContentHeight="250" DeleteMessage="">
            <Columns>
                <GridColumn Field="t => t.ProcurementItem.ProcurementItemType.EnumText()" />
                <GridColumn Field="t => t.ProcurementItem.ProcurementItemType == ProcurementItemType.Goods ? t.ProcurementItem.Goods.Code : t.ProcurementItem.Service.Code" Title="کد" />
                <GridColumn Field="t => t.ProcurementItem.ProcurementItemType == ProcurementItemType.Goods ? t.ProcurementItem.Goods.Name : t.ProcurementItem.Service.Name" Title="نام" />
                <GridColumn Field="t => t.ProcurementItem.ProcurementItemType == ProcurementItemType.Goods ? t.ProcurementItem.Goods.MeasurementUnit.Name : t.ProcurementItem.Service.MeasurementUnit.Name" Title="واحد سنجش" />
                <GridColumn Field="t => t.ProcurementItem.ISActive" />
                <GridCommandColumns HideEdit />
            </Columns>
        </DataGrid>
    </div>
</div>
@code
{
    MembershipService<ProcurementItemGroup, ProcurementItemGrouping, ProcurementItem> Service;

    protected override void OnInitialized()
    {
        Service = new MembershipService<ProcurementItemGroup, ProcurementItemGrouping, ProcurementItem>(base.ServiceProvider);
        Service.MasterId = GroupId;
        base.OnInitialized();
    }

    async Task AddSelectedSuppliersToGroup()
    {
        using var scope = CreateScope();
        var query = Service.GetFilteredOthers(scope);
        var count = await query.CountAsync();
        if (await Confirm($"آیا با افزودن {count} قلم خریدنی به گروه موافقید؟"))
        {
            count = await query.ExecuteInsertAsync(t => new ProcurementItemGrouping()
            {
                ProcurementItemGroupId = GroupId,
                ProcurementItemId = t.Id
            }, scope);
            await Service.DataView.ReloadAsync();
            await Service.OtherDataView.ReloadAsync();
            ShowMessage($"تعداد {count} قلم خریدنی با موفقیت به گروه اضافه شد");
        }
    }

    async Task DeleteSelectedSuppliersFromGroup()
    {
        using var scope = CreateScope();
        var query = Service.GetFilteredAccess(scope);
        var count = await query.CountAsync();
        if (await Confirm($"آیا با حذف {count} قلم خریدنی از گروه موافقید؟"))
        {
            count = await query.ExecuteDeleteAsync();
            await Service.DataView.ReloadAsync();
            await Service.OtherDataView.ReloadAsync();
            ShowMessage($"تعداد {count} ق با موفقیت از گروه حذف شدند");
        }
    }

    [Parameter]
    public int GroupId { get; set; }
}
