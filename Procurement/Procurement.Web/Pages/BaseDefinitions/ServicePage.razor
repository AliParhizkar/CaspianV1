@page "/Procurement/Service"
@inject IUIService<Service> Service
@attribute [Source(15, "تعریف خدمت")]
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<div class="p-3">
    <EntitySearch Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Code" SearchType="SearchType.StartWith" ColSpan="4" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
        <ComboBox TValue="int" TEntity="Warehouse.Model.MeasurementUnit" @bind-Value="context.MeasurementUnitId" 
                  TextExpression="t => t.Name" ColSpan="4" />
    </EntitySearch>
    <DataGrid TEntity="Service" Service="Service">
        <Columns>
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.MeasurementUnit.Name" Title="واحد سنجش" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Title="خدمت" Style="width:450px">
        <CaspianForm Service="Service">
            <StringTextBox @bind-Value="context.Code" SearchType="SearchType.StartWith" ColSpan="8" Style="direction:ltr" />
            <StringTextBox @bind-Value="context.Name" ColSpan="8" />
            <ComboBox TValue="int" TEntity="Warehouse.Model.MeasurementUnit" @bind-Value="context.MeasurementUnitId"
                      TextExpression="t => t.Name" ColSpan="8" />
            <FormCommandButton ColSpan="8" />
        </CaspianForm>
    </Window>
</div>

