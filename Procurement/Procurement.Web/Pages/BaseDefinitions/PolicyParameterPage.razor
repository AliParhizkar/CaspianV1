@page "/Procurement/PolicyParameter"
@inject IUIService<PolicyParameter> Service
@inherits BasePage
@attribute [Source(24, "پارامترهای سیاست خرید")]
@{
    base.BuildRenderTree(__builder);
}

<div class="p-3">
    <EntitySearch Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        <DropdownList @bind-Value="context.Property" ColSpan="4" />
    </EntitySearch>
    <DataGrid TEntity="PolicyParameter" Service="Service">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.Property.EnumText()" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Style="width:450px" Title="پارامترهای سیاست خرید">
        <CaspianForm Service="Service">
            <StringTextBox @bind-Value="context.Title" ColSpan="8" />
            <DropdownList @bind-Value="context.Property" ColSpan="8" />
            <FormCommandButton ColSpan="8" />
        </CaspianForm>
    </Window>
</div>

