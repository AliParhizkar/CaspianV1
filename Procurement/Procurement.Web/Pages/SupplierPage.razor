@page "/Procurement/Supplier"
@inject IUIService<Supplier> Service
@inherits BasePage
<div class="p-3">
    <EntitySearch Service="Service" ColumnsCount="2">
        @{
            if (Service.Search.User == null)
                Service.Search.User = new User();
        }
        <StringTextBox @bind-Value="context.Code" Style="direction:ltr" ColSpan="4" SearchType="SearchType.StartWith" />
        <DropdownList @bind-Value="context.ActivityType" ColSpan="4" SingleSelect />
        <StringTextBox @bind-Value="context.User.FName" ColSpan="4" Title="نام" />
        <StringTextBox @bind-Value="context.User.LName" ColSpan="4" Title="نام خانوادگی" />
    </EntitySearch>
    <DataGrid TEntity="Supplier" Service="Service">
        <Columns>
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.User.Name" Title="نام" />
            <GridColumn Field="t => t.StartDate.ToPersianDateString()" />
            <GridColumn Field="t => t.ActivityType.EnumText()" />
            <GridColumn Field="t => t.IsActive" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Title="تامین کننده" Style="width:450px" OnOpen="OnOpenWindow">
        <CaspianForm Service="Service">
            <StringTextBox @bind-Value="context.Code" ColSpan="8" Style="direction:ltr" />
            <Lookup TValue="int" TEntity="User" TextExpression="t => t.Name" ColSpan="8" @bind-Value="context.UserId" OpenOnFocus Title="نام">
                <UserLookupWindow />
            </Lookup>
            <DatePicker @bind-Value="context.StartDate" ColSpan="8" />
            <DropdownList @bind-Value="context.ActivityType" ColSpan="8" />
            <CheckBox @bind-Value="context.IsActive" ColSpan="8" />
            <FormCommandButton ColSpan="8" />
        </CaspianForm>
    </Window>
</div>
@code
{
    void OnOpenWindow()
    {
        if (Service.UpsertData.Id == 0)
        {
            Service.UpsertData.StartDate = DateTime.Now.ToDateOnly();
            Service.UpsertData.IsActive = true;
        }
    }
}
