@namespace Procurement.Web
@typeparam TValue
@inherits LookupWindow<SupplyingUnit, TValue>
<div class="c-lookup-page" style="width:600px;">
    <EntitySearch Service="Service" ColumnsCount="2">
        <div class="row mb-2 p-1" style="border: 1px solid #d2d2d2; border-radius: 8px;">
            <StringTextBox @bind-Value="context.Code" ColSpan="4" Style="direction:ltr" SearchType="SearchType.StartWith" />
            <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        </div>
    </EntitySearch>
    <DataGrid Service="Service" TEntity="SupplyingUnit" ContentHeight="230">
        <Columns>
            <GridColumn Field='t => t.ParentUnit.Title' Title="واحد بالاتر" />
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.CodingLevels.EnumText()" />
        </Columns>
    </DataGrid>
</div>

@code
{
    protected override void OnInitialized()
    {
        InitialSearchExpression(t => LookupStringSearchValue == null || t.Code.StartsWith(LookupStringSearchValue) || t.Title.Contains(LookupStringSearchValue));
        base.OnInitialized();
    }
}
