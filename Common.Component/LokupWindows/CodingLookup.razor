@typeparam TValue
@inherits LookupWindow<AccountingCode, TValue>
@namespace Common.Component
<div class="c-lookup-page" style="width:700px;">
    <EntitySearch TEntity="AccountingCode" Service="Service">
        <StringTextBox @ref="txtCode" @bind-Value="searchCode" Title="کد" ColSpan="2" TotalSpan="4" />
        <StringTextBox @ref="txtTitle" @bind-Value="context.Name" ColSpan="6" TotalSpan="8" />
    </EntitySearch>
    <div class="p-2">
        <DataGrid Service="Service" TEntity="AccountingCode" ContentHeight="200" 
                  ConditionExpr="t => t.CodingLevelType == (Accounting.Model.CodingLevelType)level && ((code + searchCode)== null || t.Code.StartsWith(code + searchCode))">
            <Columns>
                <GridColumn Field="t => t.Code" Title="کد حساب">
                    <Template>
                        <span>@context.Data.Code.Substring(lenth)</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="t => t.Name" />
                <GridColumn DataField Field="t => t.CodingLevelType.EnumText()" />
            </Columns>
        </DataGrid>
    </div>

    <div class="a-titles ps-3" style="height:32px">
        @for (var i = 1; i < level; i++)
        {
            <span style="font-size:14px;">@(titles[i - 1])</span>
            if (i < level - 1)
            {
                <span class="fa fa-angle-double-left ps-2 pe-2" style="color: #df4b4b; font-size: 20px; "></span>
            }
        }
    </div>
</div>

@code
{
    StringTextBox txtTitle, txtCode;
    string code, searchCode;
    int level = 1, lenth;
    string[] titles = new string[5];

    protected override void OnInitialized()
    {
        OnSelect = async t =>
        {
            var grid = Service.DataView as DataGrid<AccountingCode>;
            var coding = grid.GetSelectedData();
            code = coding.Code;
            lenth = code.Length;
            titles[level - 1] = coding.Name;
            level = coding.CodingLevelType.ConvertToInt().Value + 1;
            await grid.ReloadAsync();
            grid.SelectFirstRow();
            if (Service.Search.Code.HasValue())
                await txtCode.SetValueOnClientAsync("");
            if (Service.Search.Name.HasValue())
                await txtTitle.SetValueOnClientAsync("");

        };
        base.OnInitialized();
    }
}
