@namespace Common.Component
@typeparam TValue
@inherits LookupWindow<Goods, TValue>
<div class="c-lookup-page" style="width:600px;">
    <EntitySearch Service="Service" ColumnsCount="2">
        <div class="row mb-2 p-1" style="border: 1px solid #d2d2d2; border-radius: 8px;">
            <StringTextBox @bind-Value="context.Code" ColSpan="4" Style="direction:ltr" />
            <StringTextBox @bind-Value="context.Name" ColSpan="4" />
            <ComboBox TValue="int" @bind-Value="context.ProductClassId" TEntity="ProductClass" TextExpression="t => t.Name" ColSpan="4" />
            <DropdownList @bind-Value="context.GoodsType" ColSpan="4" />
        </div>
    </EntitySearch>
    <DataGrid Service="Service" TEntity="Goods" ContentHeight="230" OnDataBinding="BindGrid">
        <Columns Context="customer">
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.ProductClass.Name" Title="طبقه کالا" />
            <GridColumn Field="t => t.GoodsNature.EnumText()" />
            <GridColumn Field="t => t.MeasurementUnit.Name" Title="واحد سنجش" />
        </Columns>
    </DataGrid>
</div>

@code
{
    IQueryable<Goods> BindGrid(IQueryable<Goods> query)
    {
        if (IsReservation)
        {
            if (StockRoomId.HasValue)
                return query.Where(t => t.ReservationLevel == ReservationLevel.StockRoom && t.GoodsPlacements.Any(u => u.StockRoomId == StockRoomId.Value));
            return query.Where(t => t.ReservationLevel == ReservationLevel.KeepCenter && t.GoodsPlacements.Any(u => u.StockRoom.KeepCenterId == KeepCenterId.Value));
        }
        return query;
    }

    protected override void OnInitialized()
    {
        InitialSearchExpression(t => LookupStringSearchValue == null || t.Code.StartsWith(LookupStringSearchValue) || t.Name.Contains(LookupStringSearchValue));
        base.OnInitialized();
    }

    [Parameter]
    public bool IsReservation { get; set; }

    [Parameter]
    public int? KeepCenterId { get; set; }

    [Parameter]
    public int? StockRoomId { get; set; }
}
