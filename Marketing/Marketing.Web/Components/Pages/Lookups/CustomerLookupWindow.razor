@namespace Marketing.Web
@typeparam TValue
@inherits LookupWindow<Customer, int>
<div class="c-lookup-page" style="width:550px;">
    <EntitySearch TEntity="Customer" Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Name" ColSpan="4" BindingType="BindingType.OnChange" />
        <StringTextBox @bind-Value="context.MobileNumber" ColSpan="4" Style="direction:ltr" SearchType="SearchType.StartWith" />
        <NumericTextBox @bind-Value="context.CustomerNumber" ColSpan="4"  />
        @if (ConfigService.Config.CustomerHasManyAddresses)
        {
            <StringTextBox @bind-Value="address" ColSpan="4" Title="آدرس" />
        }
        else
        {
            <StringTextBox @bind-Value="context.Address1" ColSpan="4" />

        }
    </EntitySearch>
    <DataGrid Service="Service" TEntity="Customer" ContentHeight="200" 
              ConditionExpr="t => address == null || t.Addresses.Any(u => u.Address.Contains(address))">
        <Columns Context="customer">
            <GridColumn Field='t => t.Name' Title="نام مشتری" />
            <GridColumn Field="t => t.MobileNumber.CallFormat('-')" style="width:120px" />
            <GridColumn Field="t => t.CustomerNumber" style="width:100px" />
        </Columns>
    </DataGrid>
</div>

@code
{
    string address;
    protected override void OnInitialized()
    {
        InitialSearchExpression(t => LookupStringSearchValue == null || t.MobileNumber.StartsWith(LookupStringSearchValue) ||
            t.CustomerNumber.ToString().StartsWith(LookupStringSearchValue));
        base.OnInitialized();
    }
}
