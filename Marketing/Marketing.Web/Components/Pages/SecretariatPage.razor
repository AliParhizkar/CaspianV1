@page "/Marketing/Secretariat"
@using Marketing.Service
@inherits BasePage
<div class="row align-items-center" style="width:500px;margin:10px auto;">
    <div class="col-md-1 d-tree-icon text-center pb-1">
        <span @onclick="async () => await ShowEditForm(null, false)" class="fa fa-plus"></span>
    </div>
    <div class="col-md-11 pb-1">
        <StringTextBox @bind-Value="@secretariatTitle" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو ..." />
    </div>
    <div>
        <TreeView @ref="tree" TEntity="Secretariat" style="height:500px"
        TextFunc="t => t.Name" FilterFunc="t => !secretariatTitle.HasValue() || t.Name.Contains(secretariatTitle)">
            <AfterNodeTemplate>
                <span class="d-tree-icon">
                    <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                    <span class="fa fa-pencil"></span>
                </span>
                <span class="d-tree-icon" @onclick="async () => await DeleteOrganUnit(context)">
                    <span class="fa fa-trash"></span>
                </span>
            </AfterNodeTemplate>
        </TreeView>
    </div>
</div>
<Window @bind-Status="status" Style="width:600px;" OnOpen="async () => await firstControl.FocusAsync()" Title="دبیرخانه">
    <CaspianForm Model="secretariat" TEntity="Secretariat" OnValidSubmit="UpsertSecretariat" ColumnsCount="2">
        <StringTextBox @ref="firstControl" @bind-Value="context.Name" ColSpan="9" />
        <StringTextBox @bind-Value="context.PreCodeReceivedLetter" ColSpan="3" />
        <StringTextBox @bind-Value="context.PreCodeSendedLetter" ColSpan="3" />
        <StringTextBox @bind-Value="context.PreCodeTempLetter" ColSpan="3" />
        <NumericTextBox @bind-Value="context.Periority" ColSpan="3" />
        <CheckBox @bind-Value="context.IsActive" ColSpan="3" />
        <CheckBox @bind-Value="context.IsIConfidential" ColSpan="3" />
        <StringTextBox @bind-Value="context.Descript" MultiLine Rows="3" ColSpan="9" />
        <div class="col-md-3"></div>
        <div class="col-md-9 text-center pn-3 pt-3">
            <WindowCommandButtons />
        </div>
    </CaspianForm>
</Window>
@code 
{
    TreeView<Secretariat> tree;
    Secretariat secretariat;
    string secretariatTitle;
    WindowStatus status;
    IControl firstControl;

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        if (isUpdate)
        {
            ///Edit mode
            var secretariatId = Convert.ToInt32(nodeView.Value);
            using var service = CreateScope().GetService<SecretariatService>();
            secretariat = await service.SingleAsync(secretariatId);
        }
        else
        {
            ///Insert mode
            secretariat = new Secretariat();
            secretariat.IsActive = true;
            secretariat.ParentId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
        }
        status = WindowStatus.Open;
    }

    async Task<bool> UpsertSecretariat()
    {
        using var service = CreateScope().GetService<SecretariatService>();
        if (secretariat.Id == 0)
            await service.AddAsync(secretariat);
        else
            await service.UpdateAsync(secretariat);
        await service.SaveChangesAsync();
        tree.UpsertInTree(secretariat);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }

