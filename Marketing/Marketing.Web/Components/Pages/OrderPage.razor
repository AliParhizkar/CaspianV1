@page "/Marketing/Order"
@using Marketing.Web.OrderComponents
@inject IUIService<Customer> CustomerService
@inject UIService<Customer, CustomerAddress> CustomerAddressService
@inject UIService<Customer, CustomerGroupMembership> CustomerGroupService
@inject UIService<Customer, CustomerGroupMembership, CustomerAddress> CustomerAddressGroupsService
@inject UIService<Order, OrderDetail> OrderService
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<ProductComponent @ref="productComponent" Page="this" OrderService="OrderService" OnChange="() => { }" Customer="customer" Products="products" />


<CaspianForm TEntity="Order" Service="OrderService" OnSubmit="async order => await OnSubmit(order)">
    <div class="pe-2 row">
        <div class="col-md-4">
            @if (OrderService.DetailDataView != null)
            {
                <OtherCostComponent OrderService="OrderService" Products="products" OnChange="() => { }" />
            }
        </div>
        <div class="col-md-5 row c-controls">
            <div class="col-md-3">
                <label>مشتری</label>
            </div>
            <div class="col-md-8">
                <Lookup TValue="int?" TEntity="Customer" Value="OrderService.UpsertData.CustomerId" HideHeader OpenOnFocus
                        ValueChanged="ChangeCustomer" TextExpression="t => t.Name" PlaceHolder="جستجو با شماره همراه/شماره مشتری">
                    <CustomerLookupWindow />
                </Lookup>
            </div>
            <div class="col-md-1">
                @if (OrderService.UpsertData.CustomerId == null)
                {
                    <span @onclick="async () => await customerComponent.OpenWindowAsync()" class="me-2 fa fa-plus c-small-icon"></span>
                }
                else
                {
                    <span @onclick="async () => await customerComponent.OpenWindowAsync()" class="me-2 fa fa-pencil c-small-icon"></span>
                }
            </div>
            <RadioList @bind-Value="OrderService.UpsertData.OrderType" ColSpan="9" TotalSpan="12" />
            <div class="col-md-3 pt-5 ">
                <label>سفارش</label>
            </div>
            <div class="col-md-2 text-center pt-5">
                <OrderComponent Page="this" OnChange="InitializeOrder" />
            </div>
            <div class="col-md-3 text-center pt-5">
                <button class="c-btn c-primary">ثبت<span class="me-1 ms-1 fa fa-save"></span></button>
            </div>
            <div class="col-md-3 text-center pt-5">
                <button type="button" class="c-btn c-primary">چاپ<span class="me-1 ms-1 fa fa-print"></span></button>
            </div>
            <div class="col-md-1 text-center pt-5">
                <span title="سفارش جدید" class="fa fa-plus c-small-icon"></span>
            </div>
        </div>
        <div class="col-md-3 row c-controls">
            <PaymentComponent Customer="customer" Order="OrderService.UpsertData" />
        </div>
    </div>
</CaspianForm>
<SimpleCustomerComponent @ref="customerComponent" Page="this" CustomerId="OrderService.UpsertData.CustomerId" CustomerService="CustomerService"
                         CustomerAddressService="CustomerAddressService" CustomerGroupService="CustomerGroupService"
                         CustomerAddressGroupsService="CustomerAddressGroupsService" />
@code
{
    WindowStatus status;
    Customer customer;
    IList<Product> products;
    ProductComponent productComponent;
    SimpleCustomerComponent customerComponent;

    async Task ChangeCustomer(int? customerId)
    {
        using var service = CreateScope().GetService<CustomerService>();
        OrderService.UpsertData.CustomerId = customerId;
        if (customerId > 0)
            customer = await service.SingleAsync(customerId.Value);
        else
            customer = null;
        OrderService.UpsertData.IsSpecialCustomer = customer?.IsSpecial == true;
    }

    void NewOrder()
    {

    }

    async Task OnSubmit(CancelableEvent<Order> e)
    {
        var order = e.Entity;
        if (order.Id == 0)
        {
            //if (order.CashAmount > 0)
            //{
            //    using var service = CreateScope().GetService<CashierService>();
            //    var cashhier = await service.GetAll().SingleOrDefaultAsync(t => t.RelatedUserId == UserId);
            //    if (cashhier == null || cashhier.ActiveType != ActiveType.Active)
            //    {
            //        e.Cancel = true;
            //        ShowMessage("برای ثبت سفارش نقد، کاربر باید بعنوان صندوقدار فعال باشد.");
            //    }
            //    else
            //        order.CashierId = cashhier.Id;
            //}
        }
        if (order.Id > 0)
        {
            using var service = CreateScope().GetService<OrderDetailToppingService>();
            var toppings = await service.GetAll().Where(t => t.OrderDetail.OrderId == order.Id).ToListAsync();
            if (order.OrderDetails != null)
            {
                foreach (var detail in order.OrderDetails)
                    if (detail.OrderDetailToppings == null)
                        detail.OrderDetailToppings = toppings.Where(t => t.OrderDetailId == detail.Id).ToList();
            }
        }
    }

    protected override void OnInitialized()
    {
        OrderService.ThirdDataLevelToIgnoreOnRemove(t => t.OrderDetailToppings);
        OrderService.OnCreate = order =>
        {
            order.DiscountType = ConfigService.Config.DiscountType;
            order.PercentDiscount = ConfigService.Config.PercentDiscount;
            order.RoundType = ConfigService.Config.RoundType;
            order.RoundAmount = ConfigService.Config.RoundAmount;
            order.OrderType = ConfigService.Config.DefaultOrderType;
            productComponent.ClearToppingService();
        };
        OrderService.OnUpsert = async (provider, order) =>
        {
            await provider.GetCaspianService<MarketingContext>().Database.BeginTransactionAsync();
            var deletedToppings = productComponent.DeletedToppings;
            ///Delete Topping
            var service = provider.GetCaspianService<OrderDetailToppingService>();
            foreach (var topping in deletedToppings)
            {
                service.Remove(topping);
                await service.SaveChangesAsync();
            }
            return true;
        };
        OrderService.OnAfterUpsertAsync = async (provider, order) =>
        {
            var service = provider.GetCaspianService<OrderDetailToppingService>();
            var toppingsChange = productComponent.ChangedToppings;
            /// Updated Toppings
            foreach (var topping in toppingsChange.Where(t => t.Id > 0))
            {
                await service.UpdateAsync(topping);
                await service.SaveChangesAsync();
            }
            /// Insert Toppings
            /// using Distinct is very impotant to uniqu OrderDetailId
            var insertedItemsId = toppingsChange.Where(t => t.OrderDetailId < 0).Select(t => t.OrderDetailId).Distinct().ToList();
            foreach (var topping in toppingsChange.Where(t => t.Id < 0))
            {
                topping.Id = 0;
                /// Order-details that inserted now
                if (topping.OrderDetailId < 0)
                {
                    /// In this case we should Obtain Order-detail-id after insert
                    var index = insertedItemsId.IndexOf(topping.OrderDetailId);
                    // Set OrderDetailId by Id that create after OrderDetail insert
                    topping.OrderDetailId = order.OrderDetails.ElementAt(index).Id;
                }
                await service.AddAsync(topping);
                await service.SaveChangesAsync();
            }
            await service.Context.Database.CurrentTransaction.CommitAsync();
        };
        base.OnInitialized();
    }

    async Task InitializeOrder(int orderId)
    {
        await OrderService.ReloadForUpdate(orderId);
    }

    protected override async Task OnInitializedAsync()
    {
        using var service = CreateScope().GetService<ProductService>();
        products = await service.GetAll().ToListAsync();
        await base.OnInitializedAsync();
    }
}