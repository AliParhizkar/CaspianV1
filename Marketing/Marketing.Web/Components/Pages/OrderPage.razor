@page "/Marketing/Order"
@inject IUIService<Customer> CustomerService
@inject BatchService<Customer, CustomerAddress> CustomerAddressService
@inject BatchService<Customer, CustomerGroupMembership> CustomerGroupService
@inject BatchService<Customer, CustomerGroupMembership, CustomerAddress> CustomerAddressGroupsService
@inject BatchService<Order, OrderDetail> OrderService
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div class="m-main">
    <div class="m-order-details">
        <DataGrid PageSize="100" DetailsService="OrderService" TEntity="OrderDetail" ConditionExpr="t => t.Id == orderId" HideFooter="true" ShowInsertIcon="false" Batch>
            <Columns>
                <GridColumn Field="t => t.Product.Title" />
                <GridColumn Field="t => t.Quantity" Title="تعداد" >
                    <Template>
                        <div class="m-quantity">
                            <div class="m-counter-icon" @onclick="async async => await UpdateQuantity(context.Data.ProductId, 1)">
                                <span class="fa fa-plus"></span>
                            </div>
                            <NumericTextBox TValue="double" Value="context.Data.Quantity" ValueChanged="async value => await ChangeQuantity(context.Data.ProductId, value)"  Style="width:50px;" maxlength="3" />
                            <div class="m-counter-icon" @onclick="async async => await UpdateQuantity(context.Data.ProductId, -1)">
                                <span class="fa fa-minus"></span>
                            </div>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="t => t.Price - t.Discount" Title="قیمت">
                    <Template>
                        @if (context.Data.Discount == 0)
                        {
                            <span class="m-price">@context.Data.Price.DigitGrouping()</span>
                        }
                        else
                        {
                            <span class="m-price-discount">@context.Data.Price.DigitGrouping()</span>
                            <span class="m-price">@((context.Data.Price - context.Data.Discount).DigitGrouping())</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="t => ((t.Price - t.Discount) * t.Quantity).DigitGrouping()" Title="قیمت کل" />
            </Columns>
        </DataGrid>
    </div>
    <div class="m-product-panel">
        <div class="m-categories">
            @if (categories != null)
            {
                foreach (var category in categories)
                {
                    var className = category.Id == categoryId ? "m-category m-selected" : "m-category";
                    <div class="@className" @onclick="async e => await SelectCategory(e, category)">
                        @if (category.Categories != null && category.Categories.Count > 0)
                        {
                            <span>@category.Name</span>
                            <i class="c-icon fa fa-chevron-left"></i>
                        }
                        else
                        {
                            <span>@category.Name</span>
                        }
                    </div>
                }
            }
        </div>
        <div class="m-products">
            @if (products != null)
            {
                foreach (var product in products)
                {
                    var className = product.Id == selectedProductId ? "m-product m-selected" : "m-product";
                    <div @onclick="async () => await AddToOrder(product)" class="@className">@product.Title</div>
                }
            }
        </div>
    </div>
</div>

<div style="width:50%;margin: 5px auto">
    <Lookup TValue="int" TEntity="Customer" @bind-Value="customerId" HideHeader TextExpression="t => t.Name" PlaceHolder="جستجو با شماره همراه/مشتری">
        <CustomerLookupWindow />
    </Lookup>
</div>
<button @onclick="OpenCustomerWindow">
    Customer
    <i class="c-icon fa fa-chevron-left"></i>
</button>


<PopupWindow Top="top" Left="left" @bind-Status="popupStatus" Style="min-width:200px;min-height:50px">
    <div class="m-subcategories">
        @foreach (var category in categories.Single(t => t.Id == categoryId).Categories)
        {
            var className = category.Id == subCategoryId ? "m-subcategory m-selected" : "m-subcategory";
            <div class="@className" @onclick="async() =>await SelectCategory(category)" @onclick:stopPropagation>@category.Name</div>
        }
    </div>

</PopupWindow>



<SimpleCustomerComponent @ref="customerComponent" Page="this" CustomerId="customerId" CustomerService="CustomerService"
                         CustomerAddressService="CustomerAddressService" CustomerGroupService="CustomerGroupService"
                         CustomerAddressGroupsService="CustomerAddressGroupsService" />

@code
{
    int orderId;
    WindowStatus popupStatus;
    int customerId;
    SimpleCustomerComponent customerComponent;

    IList<ProductCategory> categories;
    IList<Product> products;
    int? categoryId, subCategoryId, selectedProductId, left, top;

    async Task AddToOrder(Product product)
    {
        var grid = OrderService.DetailDataView;
        var old = grid.GetBatchEntities().SingleOrDefault(t => t.ProductId == product.Id);
        if (old == null)
        {
            await grid.InsertAsync(new OrderDetail()
            {
                OrderId = orderId,
                ProductId = product.Id,
                Quantity = 1,
                Price = product.Price,
                Discount = product.Discount
            });
        }
        else
        {
            old.Quantity++;
            await grid.UpdateAsync(old);
        }
        await grid.ScrollIntoViewSelectedRow();
    }

    async Task SelectCategory(ProductCategory category)
    {
        subCategoryId = category.Id;
        popupStatus = WindowStatus.Close;
        await GetProducts(category.Id);
    }

    async Task GetProducts(int productId)
    {
        using var service = CreateScope().GetService<ProductService>();
        products = await service.GetAll().Where(t => t.CategoryId == productId).ToListAsync();
    }

    async Task SelectCategory(MouseEventArgs args, ProductCategory category)
    {
        categoryId = category.Id;
        if (category.Categories != null)
        {
            popupStatus = WindowStatus.Open;
            left = (int)(args.PageX - args.OffsetX - 205);
            top = (int)(args.PageY - args.OffsetY);
        }
        else
        {
            subCategoryId = category.Id;
            await GetProducts(category.Id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        using var service = CreateScope().GetService<ProductCategoryService>();
        categories = (await service.GetAll().ToListAsync()).Where(t => t.CategoryId == null).ToList();
        await base.OnInitializedAsync();
    }

    async Task OpenCustomerWindow()
    {
        await customerComponent.OpenWindowAsync();
    }

    async Task UpdateQuantity(int productId, int value)
    {
        var grid = OrderService.DetailDataView;
        var old = grid.GetBatchEntities().SingleOrDefault(t => t.ProductId == productId);
        old.Quantity = old.Quantity + value;
        if (old.Quantity == 0)
            await grid.RemoveAsync(old);
        else
            await grid.UpdateAsync(old);
    }

    async Task ChangeQuantity(int productId, double value)
    {
        if (value >= 0)
        {
            var grid = OrderService.DetailDataView;
            var old = grid.GetBatchEntities().SingleOrDefault(t => t.ProductId == productId);
            old.Quantity = value;
            if (old.Quantity == 0)
                await grid.RemoveAsync(old);
            else
                await grid.UpdateAsync(old);
        }
        else
            ShowMessage("تعداد نمی تواند منفی باشد");
    }
}
