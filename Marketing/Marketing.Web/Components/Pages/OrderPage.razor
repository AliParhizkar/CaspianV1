@page "/Marketing/Order"
@inject BatchService<Customer, CustomerAddress> Service
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<ComboBox @bind-Value="customerId" TValue="int?" TEntity="Customer" TextExpression="t => t.Name" />
<button @onclick="OpenCustomerWindow">Customer</button>
<Window @bind-Status="status" Style="width:600px;" Title="مشتری">
    <Marketing.Web.Components.Customer.CustomerComponent DefaultAddressManagementType="3" Page="this" />
</Window>
@code 
{
    protected override void OnInitialized()
    {
        Service.OnUpsert = async (IServiceProvider provider, Customer customer) =>
        {
            var hasDefaultAddress = Service.DetailDataView.GetBatchEntities().Any(t => t.IsDefault);
            if (hasDefaultAddress || await Confirm("هیچ آدرسی بعنوان آدرس پیشفرض انتخاب نشده است آیا با ثبت موافقید؟"))
            {
                status = WindowStatus.Close;
                StateHasChanged();
                return await Task.FromResult(true);
            }
            return await Task.FromResult(false);
        };
        base.OnInitialized();
    }
    WindowStatus status;
    void OpenCustomerWindow()
    {
        status = WindowStatus.Open;
        Service.MasterId = customerId ?? 1;
    }
    int? customerId;
}
