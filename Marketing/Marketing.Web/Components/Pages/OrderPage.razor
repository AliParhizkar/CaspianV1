@page "/Marketing/Order"
@using Marketing.Web.OrderComponents;
@inject IUIService<Customer> CustomerService
@inject BatchService<Customer, CustomerAddress> CustomerAddressService
@inject BatchService<Customer, CustomerGroupMembership> CustomerGroupService
@inject BatchService<Customer, CustomerGroupMembership, CustomerAddress> CustomerAddressGroupsService
@inject BatchService<Order, OrderDetail> OrderService
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<ProductComponent @ref="productComponent" Page="this" OrderService="OrderService" OnChange="ChangeOnOrderDetails" />
<div class="pe-2" style="display:flex;">
    <OrderComponent Page="this" />
    @if (order != null)
    {
        <SimpleCustomerComponent Page="this" CustomerId="order.CustomerId" CustomerIdChanged="ChangeCustomer" CustomerService="CustomerService"
                                 CustomerAddressService="CustomerAddressService" CustomerGroupService="CustomerGroupService"
                                 CustomerAddressGroupsService="CustomerAddressGroupsService" />
    }
</div>
@if (order != null)
{
    <OtherCostComponent Order="order" />
}

@*<CaspianForm Service="OrderService">
        <button>ثبت</button>
    </CaspianForm>*@

@code
{
    WindowStatus status;
    Customer customer;
    IList<Product> products;
    ProductComponent productComponent;
    Order order;

    async Task ChangeCustomer(int? customerId)
    {
        using var service = CreateScope().GetService<CustomerService>();
        order.CustomerId = customerId;
        if (customerId > 0)
            customer = await service.SingleAsync(customerId.Value);
        else
            customer = null;
    }

    void ChangeOnOrderDetails(IList<OrderDetail> orderDetails)
    {

    }

    protected override void OnInitialized()
    {
        OrderService.ThirdDataLevelToIgnoreOnRemove(t => t.OrderDetailToppings);
        OrderService.OnUpsert = async (provider, order) =>
        {
            await provider.GetCaspianService<MarketingContext>().Database.BeginTransactionAsync();
            var deletedToppings = productComponent.GetDeletedToppings();
            ///Delete Topping
            var service = provider.GetCaspianService<OrderDetailToppingService>();
            foreach (var topping in deletedToppings)
            {
                await service.RemoveAsync(topping);
                await service.SaveChangesAsync();
            }
            return true;
        };
        OrderService.OnAfterOpsertAsync = async (provider, order) =>
        {
            var service = provider.GetCaspianService<OrderDetailToppingService>();
            var toppingsChange = productComponent.GetToppingsChange();
            /// Updated Toppings
            foreach (var topping in toppingsChange.Where(t => t.Id > 0))
            {
                await service.UpdateAsync(topping);
                await service.SaveChangesAsync();
            }
            /// Insert Toppings
            /// using Distinct is very impotant to uniqu OrderDetailId
            var insertedItemsId = toppingsChange.Where(t => t.OrderDetailId < 0).Select(t => t.OrderDetailId).Distinct().ToList();
            foreach (var topping in toppingsChange.Where(t => t.Id < 0))
            {
                topping.Id = 0;
                /// Order-details that inserted now
                if (topping.OrderDetailId < 0)
                {
                    /// In this case we should Obtain Order-detail-id after insert
                    var index = insertedItemsId.IndexOf(topping.OrderDetailId);
                    // Set OrderDetailId by Id that create after OrderDetail insert
                    topping.OrderDetailId = order.OrderDetails.ElementAt(index).Id;
                }
                await service.AddAsync(topping);
                await service.SaveChangesAsync();
            }

            await service.Context.Database.CurrentTransaction.CommitAsync();
        };
        base.OnInitialized();
    }

    async Task InitializeOrderAsync(int orderId)
    {
        OrderService.MasterId = orderId;
        if (orderId == 0)
        {
            customer = null;
            order = new Order()
            {
                Id = orderId,
                DiscountType = ConfigService.Config.DiscountType,
                PercentDiscount = ConfigService.Config.PercentDiscount,
                RoundType = ConfigService.Config.RoundType,
                RoundAmount = ConfigService.Config.RoundAmount
            };
        }
        else
        {
            using var service = CreateScope().GetService<OrderService>();
            order = await service.SingleAsync(orderId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        using var service = CreateScope().GetService<ProductService>();
        products = await service.GetAll().ToListAsync();
        await InitializeOrderAsync(0);
        await base.OnInitializedAsync();
    }
}