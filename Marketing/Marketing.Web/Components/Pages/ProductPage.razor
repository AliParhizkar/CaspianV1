@page "/Marketing/Product"
@page  "/Marketing/Product/{CategoryId:int}"

@inject BatchService<Product, ProductTopping, ProductDescription> Service
@inherits BasePage
@{
        base.BuildRenderTree(__builder);
}
<div class="p-4 pt-2 pb-2">
    @if (productCategory != null)
    {
        <div class="row c-controls">
            <div class="col-md-2">
                <label>گروه محصول</label>
            </div>
            <div class="col-md-4 ps-3">
                <span class="c-data-field">@productCategory.Name</span>
            </div>
            <div class="col-md-4 pe3">
                <span class="c-data-field">@(productCategory.Category?.Name ?? "---")</span>
            </div>
            <div class="col-md-2 text-center">
                <a href="/Marketing/ProductCategory">
                    <span class="fa fa-arrow-left c-back-icon"></span>
                </a>
            </div>
        </div>
    }
    <hr />
    <EntitySearch TEntity="Product" Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        @if (CategoryId == 0)
        {
            <ComboBox TEntity="ProductCategory" TValue="int" TextExpression="t => t.Name" @bind-Value="context.CategoryId" ColSpan="4" />
        }
    </EntitySearch>
    <DataGrid TEntity="Product" Service="Service" ConditionExpr="t => CategoryId == 0 || t.CategoryId == CategoryId">
        <Columns>
            @if (CategoryId == 0)
            {
                <GridColumn Field="t=> t.Category.Category.Name ?? t.Category.Name" Title="گروه اصلی" />
                <GridColumn Field="t=> t.Category.Name" Title="گروه فرعی" />
            }
            <GridColumn Field="t=> t.Title" Title="عنوان" />
            <GridColumn Field="t=> t.Price.DigitGrouping()" />
            <GridColumn Field="t=> t.Discount.DigitGrouping()" />
            <GridColumn Field="t=> t.Code" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Style="width:700px" Service="Service" Title="محصول/تاپینگهای محصول /شرح های پیشفرض" OnOpen="OnOpen">
        <TabPanel>
            <Tabs>
                <TabPanelItem Title="محصول/تاپینگ">
                    <CaspianForm TEntity="Product" Service="Service" OnSubmit="FormSubmitted">
                        <div class="row ps-2 pe-2">
                            <div class="col-md-8 row">
                                <fieldset class="c-container pb-2 mb-2">
                                    <legend>مشخصات محصول</legend>
                                    <div class="row">
                                        @if (CategoryId == 0)
                                        {
                                            switch (ConfigService.Config.CategoryType)
                                            {
                                                case CategoryType.Single:
                                                    <ComboBox @bind-Value="context.CategoryId" TValue="int" TEntity="ProductCategory" TextExpression="t => t.Name" ConditionExpression="t => t.CategoryId == null"
                                                              ColSpan="8" />
                                                    break;
                                                case CategoryType.Couple:
                                                    <ComboBox @bind-Value="parentCategoryId" TValue="int" Validate='() => parentCategoryId == 0 ? "لطفا گروه اصلی را مشخص نمایید" : null' TEntity="ProductCategory" TextExpression="t => t.Name" ConditionExpression="t => t.CategoryId == null"
                                                              ColSpan="8" Title="گروه اصلی" OnChange="() => cmbCategory.EnableLoading()" />
                                                    <ComboBox @ref="cmbCategory" Validate="ValidateSubCategory" TValue="int" @bind-Value="categoryId" TEntity="ProductCategory" TextExpression="t => t.Name" ConditionExpression="t => t.CategoryId == parentCategoryId"
                                                              ColSpan="8" Title="گروه فرعی" />
                                                    break;
                                                case CategoryType.Multiple:
                                                    <LookupTree @bind-Value="context.CategoryId" ColSpan="8">
                                                        <ChildContent Context="search">
                                                            <TreeView TEntity="ProductCategory" TextFunc="t => t.Name"
                                                                      ParentNodeFilterFunc="t => t.Category == null"
                                                                      FilterFunc="t => (!search.HasValue() || t.Name.StartsWith(search))" />
                                                        </ChildContent>
                                                    </LookupTree>
                                                    break;
                                            }
                                        }
                                        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
                                        <NumericTextBox @bind-Value="context.Price" ColSpan="8" OnChange="() => PriceChanged(context)" DigitGrouping />
                                        <NumericTextBox @bind-Value="context.TakeOutPrice" ColSpan="8" DigitGrouping />
                                        <NumericTextBox @bind-Value="context.SpecialCustomerPrice" ColSpan="8" DigitGrouping />
                                        <NumericTextBox @bind-Value="context.Discount" ColSpan="8" DigitGrouping />
                                        <StringTextBox @bind-Value="context.Code" ColSpan="8" Style="direction:ltr" />
                                    </div>
                                </fieldset>
                            </div>
                            <div class="col-md-4 pe-3 pb-2 text-center pt-1">
                                <label class="d-membership">تاپینکهای محصول</label>
                                <CheckedListbox TEntity="Topping" TDetails="ProductTopping" Service="Service" Style="height: 280px"
                                                TextExpression="t => t.Name" />
                            </div>
                        </div>
                    </CaspianForm>
                </TabPanelItem>
                <TabPanelItem Title="شرح های پیشفرض">
                    <div class="p-3 text-center pt-0">
                        <label class="d-membership">شرح های پیش فرض</label>
                        <DataGrid TEntity="ProductDescription" DetailsService="Service" ContentHeight="200">
                            <Columns>
                                <GridColumn Field="t => t.Description" />
                                <GridCommandColumns />
                            </Columns>
                        </DataGrid>
                    </div>
                    <TypeWindow TEntity="ProductDescription" Service="Service" Title="شرح پیش فرض" Style="width:400px;">
                        <StringTextBox @bind-Value="context.Description" ColSpan="9" MultiLine Rows="2" />
                        <FormCommandButton ColSpan="9" Class="pt-2" />
                    </TypeWindow>
                </TabPanelItem>
            </Tabs>
        </TabPanel>
        <div class="p-2 pb-0 text-center c-form-action">
            @if (Service.Form != null)
            {
                <button class="c-btn c-primary" @onclick="async () => await Service.Form.SubmitAsync()">ثبت</button>
                <button class="c-btn c-danger" @onclick="async () => await Service.Form.ResetAsync()">بازنشانی</button>
            }
        </div>
    </Window>
</div>

@code
{
    ProductCategory productCategory;
    ComboBox<ProductCategory, int> cmbCategory;
    int parentCategoryId, categoryId;

    void PriceChanged(Product product)
    {
        if (product.Id == 0 && product.TakeOutPrice == 0)
            product.TakeOutPrice = product.Price;
    }

    protected override void OnInitialized()
    {
        Service.OnUpsert = async (IServiceProvider provider, Product product) =>
        {
            if (product.Id == 0 && (product.Price == 0 || product.TakeOutPrice == 0))
                return await Confirm("آیا با ثبت محصول با مبلغ صفر موافقید؟");
            return true;
        };
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        using var service = CreateScope().GetService<ProductCategoryService>();
        if (CategoryId > 0)
            productCategory = await service.GetAll().Include(t => t.Category).SingleAsync(t => t.Id == CategoryId);
        await base.OnInitializedAsync();
    }

    string ValidateSubCategory()
    {
        if (parentCategoryId > 0)
        {
            using var service = CreateScope().GetService<ProductCategoryService>();
            var parentsId = service.GetAll().Where(t => t.CategoryId == parentCategoryId).Select(t => t.Id).ToList();
            if (parentsId.Any())
            {
                if (categoryId == 0)
                    return "گروه اصلی دارای زیرگروه است لطفا زیرگروه را مشخص نمایید.";
                if (!parentsId.Contains(categoryId))
                    return "زیرگروه درست انتخاب نشده است.";
            }
        }
        return null;
    }

    async Task FormSubmitted(CancelableEvent<Product> e)
    {
        if (CategoryId > 0)
            e.Entity.CategoryId = CategoryId;
        else if (ConfigService.Config.CategoryType == CategoryType.Couple)
        {
            using var service = CreateScope().GetService<ProductCategoryService>();
            if (await service.AnyAsync(t => t.CategoryId == parentCategoryId))
                e.Entity.CategoryId = categoryId;
            else
                e.Entity.CategoryId = parentCategoryId;
        }
    }

    async Task OnOpen()
    {
        if (ConfigService.Config.CategoryType == CategoryType.Couple)
        {
            var product = Service.UpsertData;
            if (product.Id > 0)
            {
                using var service = CreateScope().GetService<ProductCategoryService>();
                var category = await service.SingleAsync(product.CategoryId);
                parentCategoryId = category.Id;
                categoryId = category.CategoryId ?? 0;
            }
            else
                parentCategoryId = categoryId = 0;
        }
    }

    void ParentCategoryChanged()
    {
        cmbCategory.EnableLoading();
        categoryId = 0;
    }

    [Parameter]
    public int CategoryId { get; set; }
}
