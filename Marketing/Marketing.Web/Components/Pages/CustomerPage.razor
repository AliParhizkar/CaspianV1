@page "/Marketing/Customer"
@inject BatchService<Customer, CustomerAddress> Service

@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<div style="width:75%;margin: 10px auto">
    <div class="row c-controls">
        <div class="col-md-4">
            <label>روش مدیریت آدرس پیشفرض</label>
        </div>
        <div class="col-md-8">
            <RadioList @bind-Value="defaultAddressManagementType">
                <RadioItem Title="توسط کاربر" Value="1" />
                <RadioItem Title="پرسیده شود" Value="2" />
                <RadioItem Title="توسط سیستم" Value="3" />
            </RadioList>
        </div>
    </div>
    <DataGrid TEntity="Customer" Service="Service" DeleteMessage="می خواهید حذف شود">
        <Columns>
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.MobileNumber" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="Customer" Style="width:600px">
    <Marketing.Web.Components.Customer.CustomerComponent Page="this" DefaultAddressManagementType="defaultAddressManagementType" />
</Window>
@code
{
    int defaultAddressManagementType = 1;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }


}