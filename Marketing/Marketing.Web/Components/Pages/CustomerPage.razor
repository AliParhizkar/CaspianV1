@page "/Marketing/Customer"
@inject IUIService<Customer> CustomerService
@inject BatchService<Customer, CustomerAddress> CustomerAddressService
@inject BatchService<Customer, CustomerGroupMembership> CustomerGroupService
@inject BatchService<Customer, CustomerGroupMembership, CustomerAddress> CustomerAddressGroupsService

@namespace Marketing.Web

@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<div style="width:75%;margin: 10px auto">
    @if(ConfigService.Config.CustomerHasManyAddresses)
    {
        if (ConfigService.Config.CustomerIsMemberOfGroups)
        {
            <CustomerAddressGroupsComponent Service="CustomerAddressGroupsService" Page="this" />
        }
        else
        {
            <CustomerAddressComponent Service="CustomerAddressService" Page="this" />
        }
    }
    else
    {
        if (ConfigService.Config.CustomerIsMemberOfGroups)
        {
            <CustomerGroupsComponent Service="CustomerGroupService" Page="this" />
        }
        else
        {
            <CustomerComponent Service="CustomerService" Page="this" />
        }
    }
</div>

@code
{
    protected override void OnInitialized()
    {
        if (ConfigService.Config.CustomerHasManyAddresses)
        {
            if (ConfigService.Config.CustomerIsMemberOfGroups)
                CustomerAddressGroupsService.OnUpsert = ConfirmForAddress;
            else
                CustomerAddressService.OnUpsert = ConfirmForAddress;
        }
        base.OnInitialized();
    }

    async Task<bool> ConfirmForAddress(IServiceProvider provider, Customer customer)
    {
        var dataView = CustomerAddressGroupsService.DetailDataView ?? CustomerAddressService.DetailDataView;
        if (!dataView.GetBatchEntities().Any())
            return await Confirm("برای مشتری آدرس تعریف نشده است آیا با ثبت موافقید؟");
        if (!dataView.GetBatchEntities().Any(t => t.IsDefault))
            return await Confirm("هیچکدام از آدرس ها بعنوان آدرس پیش فرض تعیین نشده اند آیا با ثبت موافقید؟");
        return true;
    }

    public override void ChangeState()
    {
        StateHasChanged();
    }
}