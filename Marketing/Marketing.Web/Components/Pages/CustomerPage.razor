@page "/Marketing/Customer"
@inject BatchService<Customer, CustomerAddress> Service

@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<div style="width:75%;margin: 10px auto">
    <DataGrid TEntity="Customer" Service="Service" DeleteMessage="با حذف مشتری آدرس های وی نیز حذف می شود آیا با حذف موافقید؟">
        <Columns>
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.MobileNumber" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="مشتری" Style="width:600px">
    <Marketing.Web.Components.Customer.CustomerComponent Page="this" />
</Window>
@code
{
    protected override void OnInitialized()
    {
        Service.OnUpsert = async (IServiceProvider provider, Customer customer) =>
        {
            if (!Service.DetailDataView.GetBatchEntities().Any())
                return await Confirm("برای مشتری آدرس تعریف نشده است آیا با ثبت موافقید؟");
            if (!Service.DetailDataView.GetBatchEntities().Any(t => t.IsDefault))
                return await Confirm("هیچکدام از آدرس ها بعنوان آدرس پیش فرض تعیین نشده اند آیا با ثبت موافقید؟");
            return true;
        };
        base.OnInitialized();
    }

    public override void ChangeState()
    {
        StateHasChanged();
    }
}