@page "/Marketing"
@inherits BasePage
<button @onclick="Test">Test</button>


@code 
{
    async Task Test()
    {
        using var service = CreateScope().GetService<OrderDetailToppingService>();
        var data = await service.GetAll().GroupBy(t => t.OrderDetailId).Select(t => new 
        {
            t.Key,
            Sum = t.Sum(u => u.Quantity)
        }).ToListAsync();
    }
}
