@page "/Marketing/Archive"
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div class="c-controls c-header row align-items-center">
    <CaspianContainer>
        <LookupTree @bind-Value="SecretariatId" onchange="async () => await ReloadTree()">
            <TreeView TEntity="Secretariat" TextFunc="t => t.Name"
            FilterFunc="t => (!context.HasValue() || t.Name.Contains(context))"/>
        </LookupTree>
    </CaspianContainer>
</div>
<div class="c-body p-1">
    @if (SecretariatId.HasValue)
    {
        <div class="row align-items-center" style="width:500px;margin:10px auto;">
            <div class="col-md-1 d-tree-icon text-center pb-1">
                <span @onclick="async () => await ShowEditForm(null, false)" class="fa fa-plus"></span>
            </div>
            <div class="col-md-11 pb-1">
                <StringTextBox @bind-Value="@archiveTitle" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو ..." />
            </div>
            <div>
                <TreeView @ref="tree" TEntity="Archive" style="height:300px" ConditionExpression="t => t.SecretariatId == SecretariatId"
                TextFunc="t => t.Title" FilterFunc="t => !archiveTitle.HasValue() || t.Title.Contains(archiveTitle)">
                    <AfterNodeTemplate>
                        <span class="d-tree-icon">
                            <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
                        </span>
                        <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                            <span class="fa fa-pencil"></span>
                        </span>
                        <span class="d-tree-icon" @onclick="async () => await DeleteArchive(context)">
                            <span class="fa fa-trash"></span>
                        </span>
                    </AfterNodeTemplate>
                </TreeView>
            </div>
        </div>
        <Window @bind-Status="status" Title="بایگانی" Style="width:400px;">
            <CaspianForm TEntity="Archive" Model="archive" OnValidSubmit="UpsertArchive" OnSubmit="t => t.SecretariatId= SecretariatId.Value">
                <StringTextBox @bind-Value="context.Title" ColSpan="8" />
                <div class="col-md-4 pt-3 pb-2"></div>
                <div class="col-md-8 justify-content-center pt-3 pb-2">
                    <WindowCommandButtons />
                </div>
            </CaspianForm>
        </Window>
    }
</div>

@code 
{
    TreeView<Archive> tree;
    string archiveTitle;
    int? SecretariatId;
    Archive archive;
    WindowStatus status;

    async Task ReloadTree()
    {
        if (tree != null)
            await tree.ReloadAsync();
    }

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        if (isUpdate)
        {
            ///Edit mode
            var archiveId = Convert.ToInt32(nodeView.Value);
            using var service = CreateScope().GetService<ArchiveService>();
            archive = await service.SingleAsync(archiveId);
        }
        else
        {
            ///Insert mode
            archive = new Archive();
            archive.IsActive = true;
            archive.ParentId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
        }
        archive.UpsertUserId = base.UserId;
        archive.UpsertDate = DateTime.Now;
        status = WindowStatus.Open;
    }

    async Task<bool> UpsertArchive()
    {
        using var service = CreateScope().GetService<ArchiveService>();
        if (archive.Id == 0)
            await service.AddAsync(archive);
        else
            await service.UpdateAsync(archive);
        await service.SaveChangesAsync();
        tree.UpsertInTree(archive);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }

    async Task DeleteArchive(NodeView node)
    {
        var archiveId = Convert.ToInt32(node.Value);
        using var service = CreateScope().GetService<ArchiveService>();
        var old = await service.SingleAsync(archiveId);
        var result = await service.ValidateRemoveAsync(old);
        if (result.IsValid)
        {
            await service.RemoveAsync(old);
            await service.SaveChangesAsync();
            tree.RemoveFromTree(old);
        }
        else
            ShowMessage(result.Errors.First().ErrorMessage);
    }
}
