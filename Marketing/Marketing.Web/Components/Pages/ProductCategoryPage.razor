@page "/Marketing/ProductCategory"
@inherits BasePage
@using Caspian.UI
@{
    base.BuildRenderTree(__builder);
}

<div style="width:600px;margin:5px auto" class="row">
    <div class="col-md-1 text-center pt-1">
        <span class="d-tree-icon" @onclick="async () => await ShowEditForm(null, false)">
            <span class="fa fa-plus"></span>
        </span>
    </div>
    <div class="col-md-11 pb-1">
        <StringTextBox @bind-Value="@categrySearch" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو گروه محصول" />
    </div>
    <TreeView @ref="tree" TEntity="ProductCategory" style="height:500px" TextFunc="t => t.Name"
    FilterFunc="t => (!categrySearch.HasValue() || t.Name.StartsWith(categrySearch)) && t.ActiveType == ActiveType.Active">
        <AfterNodeTemplate>
            <span class="d-tree-icon">
                <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
            </span>
            <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                <span class="fa fa-pencil"></span>
            </span>
            <span class="d-tree-icon" @onclick="async () => await DeleteCategory(context)">
                <span class="fa fa-trash"></span>
            </span>
        </AfterNodeTemplate>
    </TreeView>
</div>

<Window @bind-Status="status" Style="width:450px;" OnOpen="async () => await firstControl.FocusAsync()" Title="گروه محصول">
    <CaspianForm Model="category" TEntity="ProductCategory" OnValidSubmit="UpsertCategory">
        <StringTextBox @ref="firstControl" @bind-Value="context.Name" ColSpan="9" />
        <DropdownList @bind-Value="context.ActiveType" ColSpan="9" />
        <WindowCommandButtons ColSpan="9" />
    </CaspianForm>
</Window>

@code 
{
    string categrySearch;
    TreeView<ProductCategory> tree;
    ProductCategory category;
    WindowStatus status;
    IControl firstControl;

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        if (isUpdate)
        {
            //For Edit
            var categoryId = Convert.ToInt32(nodeView.Value);
            using var service = CreateScope().GetService<ProductCategoryService>();
            category = await service.SingleAsync(categoryId);
        }
        else
        {
            category = new ProductCategory();
            category.ActiveType = ActiveType.Active;
            category.CategoryId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
        }
        status = WindowStatus.Open;
    }

    async Task DeleteCategory(NodeView node)
    {
        var categoryId = Convert.ToInt32(node.Value);
        using var service = CreateScope().GetService<ProductCategoryService>();
        var category = await service.SingleAsync(categoryId);
        var result = await service.ValidateRemoveAsync(category);
        if (result.IsValid)
        {
            await service.RemoveAsync(category);
            await service.SaveChangesAsync();
            tree.RemoveFromTree(category);
        }
        else
            ShowMessage(result.Errors.First().ErrorMessage);
    }

    async Task<bool> UpsertCategory()
    {
        using var service = CreateScope().GetService<ProductCategoryService>();
        if (category.Id == 0)
            await service.AddAsync(category);
        else
            await service.UpdateAsync(category);
        await service.SaveChangesAsync();
        tree.UpsertInTree(category);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }
}
