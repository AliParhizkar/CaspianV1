@namespace Marketing.Web
@if (!SimpleMode)
{
    <EntitySearch TEntity="Customer" Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Name" ColSpan="10" TotalSpan="12" />
        <StringTextBox @bind-Value="context.MobileNumber" Style="direction:ltr" MaxLength="11" ColSpan="4" />
        <StringTextBox @bind-Value="customerNumber" ColSpan="4" TotalSpan="6" Title="شماره مشتری" Style="direction:ltr" />
    </EntitySearch>

    <DataGrid TEntity="Customer" Service="Service" DeleteMessage="با حذف مشتری گروههای وی نیز حذف می شود آیا با حذف موافقید؟"
              ConditionExpr="t => customerNumber == null || t.CustomerNumber.ToString().StartsWith(customerNumber)">
        <Columns>
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.MobileNumber" />
            <GridColumn Field="t => t.CustomerNumber.DigitGrouping()" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
}


<Window Title="مشتری-آدرسهای مشتری-گروههای مشتری" Style="width:800px;" Service="Service" OnOpen="SetCustomerNumber">
    <CaspianForm Service="Service" ColumnsCount="2">
        <CaspianValidationValidator TModel="Customer" ValidatorType="typeof(CustomerAddressGroupsService)" />
        <fieldset class="c-container">
            <legend>مشخصات مشتری</legend>
            <div class="row">
                <StringTextBox @bind-Value="context.Name" ColSpan="4" TotalSpan="6" />
                <StringTextBox @bind-Value="context.MobileNumber" ColSpan="2" TotalSpan="3" MaxLength="11" Style="direction:ltr" />
                <FormCommandButton TotalSpan="3" ColSpan="3" />
                <NumericTextBox @bind-Value="context.CustomerNumber" Disabled DigitGrouping ColSpan="3" TotalSpan="5" />
                <div class="col-md-1 text-center">
                    <span class="c-small-icon fa fa-refresh" @onclick="SetCustomerNumber" title="برای دریافت شماره مشتری کلیک کنید"></span>
                </div>
                <CheckBox @bind-Value="context.IsSpecial" ColSpan="2" TotalSpan="4" />
            </div>
        </fieldset>
    </CaspianForm>
    <div class="row pt-2">
        <div class="col-md-9 text-center ps-2">
            <span class="d-membership">آدرسهای مشتری</span>
            <div class="text-end">
                <DataGrid TEntity="CustomerAddress" DetailsService="Service" ContentHeight="250" Inline AutoHide OnOpen="SetAddressAsDefault"
                          OnUpsertAsync="OnAddressInserted">
                    <Columns Context="address">
                        <GridColumn Field="t => t.Address" Title="آدرس">
                            <EditTemplate>
                                <StringTextBox MultiLine Rows="2" @bind-Value="address.Data.Address" />
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn Field="t => t.IsDefault" Title="پیشفرض" style="width:70px">
                            <EditTemplate>
                                <CheckBox @bind-Value="address.Data.IsDefault" />
                            </EditTemplate>
                        </GridColumn>
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
            </div>

        </div>
        <div class="col-md-3 text-center pe-2">
            <span class="d-membership">گروههای مشتری</span>
            <div class="text-end">
                <CheckedListbox TEntity="CustomerGroup" TDetails="CustomerGroupMembership" Service="Service" Style="height:324px;"
                                TextExpression="t => t.Name" />
            </div>
        </div>
    </div>
</Window>

@code
{
    string customerNumber;
    async Task SetCustomerNumber()
    {
        if (SimpleMode && Service.MasterId == 0 || Service.UpsertData.Id == 0)
        {
            using var service = Page.CreateScope().GetService<CustomerService>();
            var max = (await service.GetAll().MaxAsync(t => (int?)t.CustomerNumber)).GetValueOrDefault() + 1;
            Service.UpsertData.CustomerNumber = max;
        }
    }

    void SetAddressAsDefault(CustomerAddress address)
    {
        if (address.Id == 0)
            address.IsDefault = !Service.DetailDataView.GetBatchEntities().Any(t => t.IsDefault);
    }

    async Task<bool> OnAddressInserted(CustomerAddress address)
    {
        if (!address.IsDefault || !Service.DetailDataView.GetBatchEntities().Any(t => t.IsDefault))
            return true;
        switch (ConfigService.Config.DefaultAddressManagement)
        {
            case DefaultAddressManagement.User:
                return true;
            case DefaultAddressManagement.System:
                var defaultAddress = Service.DetailDataView.GetBatchEntities().Single(t => t.IsDefault);
                defaultAddress.IsDefault = false;
                Page.ShowMessage("آدرس جاری بعنوان آدرس پیشفرض انتخاب شد.");
                return true;
            case DefaultAddressManagement.Confirm:
                if (await Page.Confirm("آیا می خواهید آدرس جاری بعنوان آدرس پیشفرض انتخاب شود"))
                {
                    defaultAddress = Service.DetailDataView.GetBatchEntities().Single(t => t.IsDefault);
                    defaultAddress.IsDefault = false;
                    return true;
                }
                break;
        }
        return false;
    }

    [Parameter]
    public BatchService<Customer, CustomerGroupMembership, CustomerAddress> Service { get; set; }

    [Parameter]
    public BasePage Page { get; set; }

    [Parameter]
    public bool SimpleMode { get; set; }
}
