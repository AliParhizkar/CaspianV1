@namespace Marketing.Web

<EntitySearch TEntity="Customer" Service="Service" ColumnsCount="2">
    <StringTextBox @bind-Value="context.Name" ColSpan="4" />
    <StringTextBox @bind-Value="context.MobileNumber" Style="direction:ltr" MaxLength="11" ColSpan="4" />
    <ComboBox TValue="int?" TEntity="CustomerGroup" @bind-Value="context.GroupId" TextExpression="t => t.Name" ColSpan="4" />
</EntitySearch>

<DataGrid TEntity="Customer" Service="Service" DeleteMessage="با حذف مشتری آدرس های وی نیز حذف می شود آیا با حذف موافقید؟">
    <Columns>
        <GridColumn Field="t => t.Name" />
        <GridColumn Field="t => t.MobileNumber" />
        <GridColumn Field="t => t.CustomerGroup.Name" Title="گروه مشتری" />
        <GridCommandColumns />
    </Columns>
</DataGrid>

<Window Service="Service" Title="مشتری و آدرسهای مشتری" Style="width:750px">
    <CaspianForm Service="Service" TEntity="Customer" ColumnsCount="2">
        <fieldset class="c-container">
            <legend>مشخصات مشتری</legend>
            <div class="row ps-3 pe-3">
                <StringTextBox @bind-Value="context.Name" ColSpan="4" />
                <StringTextBox @bind-Value="context.MobileNumber" ColSpan="4" Style="direction:ltr" MaxLength="11" />
                <ComboBox TValue="int?" TEntity="CustomerGroup" @bind-Value="context.GroupId" TextExpression="t => t.Name" ColSpan="4" />
                <FormCommandButton ColSpan="6" TotalSpan="6" />
            </div>
        </fieldset>
    </CaspianForm>
    <div style="margin-bottom:-20px;" class="p-3 pb-0 text-center">
        <span class="d-membership">آدرس های مشتری</span>
    </div>
    <DataGrid TEntity="CustomerAddress" DetailsService="Service" ContentHeight="200">
        <Columns>
            <GridColumn Field="t => t.Address" />
            <GridColumn Field="t => t.IsDefault" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <TypeWindow TEntity="CustomerAddress" Service="Service" Title="آدرس" OnOpen="SetDefaultAddress" Style="width:400px;" OnSubmit="async t => await FormSubmit(t)">
        <StringTextBox @bind-Value="context.Address" Rows="3" MultiLine ColSpan="8" />
        <CheckBox @bind-Value="context.IsDefault" ColSpan="8" />
        <FormCommandButton ColSpan="8" />
    </TypeWindow>
</Window>

@code 
{
    void SetDefaultAddress(CustomerAddress address)
    {
        if (address.Id == 0)
            address.IsDefault = !Service.DetailDataView.GetBatchEntities().Any(t => t.IsDefault);
    }

    async Task FormSubmit(CustomerAddress address)
    {
        DefaultAddressManagement addressManagement = ConfigService.Config.DefaultAddressManagement;
        if (address.IsDefault && addressManagement > DefaultAddressManagement.User)
        {
            var old = Service.DetailDataView.GetBatchEntities().SingleOrDefault(t => t.IsDefault);
            if (old != null)
            {
                if (addressManagement == DefaultAddressManagement.System || await Page.Confirm("آیا می خواهید این آدرس بعنوان آدرس پیشفرض انتخاب شود؟"))
                {
                    old.IsDefault = false;
                    //await Service.DetailDataView.UpdateAsync(old);
                    if (addressManagement == DefaultAddressManagement.System)
                        Page.ShowMessage("آدرس جاری بعنوان آدرس پیشفرض انتخاب شد.");
                }
            }
        }
    }

    [Parameter]
    public BasePage Page { get; set; } 

    [Parameter]
    public BatchService<Customer, CustomerAddress> Service { get; set; }
}
