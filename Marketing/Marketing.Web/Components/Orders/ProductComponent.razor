@namespace Marketing.Web.OrderComponents

<div class="m-main">
    <div class="m-order-details">
       <FactorComponent @ref="factor" OrderService="OrderService" Page="Page" OnChange="CallbackForChange" Products="Products"
                        OrderType="OrderService.UpsertData.OrderType" IsSpecialCustomer="Customer?.IsSpecial" />
    </div>
    <div class="m-product-panel">
        <div class="m-categories">
            @if (categories != null)
            {
                foreach (var category in categories)
                {
                    var className = category.Id == categoryId ? "m-category m-selected" : "m-category";
                    <div class="@className" @onclick="async e => await SelectCategory(e, category)">
                        @if (category.Categories != null && category.Categories.Count > 0)
                        {
                            <span>@category.Name</span>
                            <i class="c-icon fa fa-chevron-left"></i>
                        }
                        else
                        {
                            <span>@category.Name</span>
                        }
                    </div>
                }
            }
        </div>
        <div class="m-products">
            @if (products != null)
            {
                foreach (var product in products)
                {
                    var className = product.Id == selectedProductId ? "m-product m-selected" : "m-product";
                    <div @onclick="async () => await factor.AddToOrder(product)" class="@className">@product.Title</div>
                }
            }
        </div>
    </div>
    <PopupWindow Top="top" Left="left" @bind-Status="productStatus" Style="min-width:200px;min-height:50px">
        <div class="m-subcategories">
            @foreach (var category in categories.Single(t => t.Id == categoryId).Categories)
            {
                var className = category.Id == subCategoryId ? "m-subcategory m-selected" : "m-subcategory";
                <div class="@className" @onclick="async() =>await SelectCategory(category)" @onclick:stopPropagation>@category.Name</div>
            }
        </div>
    </PopupWindow>

</div>
