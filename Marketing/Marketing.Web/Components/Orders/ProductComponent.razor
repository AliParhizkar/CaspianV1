@namespace Marketing.Web.OrderComponents

<div class="m-main">
    <div class="m-order-details">
        <DataGrid PageSize="100" DetailsService="OrderService" TEntity="OrderDetail" HideFooter="true" ShowInsertIcon="false" Batch>
            <Columns>
                <GridColumn Field="t => t.Product.Title" />
                <GridColumn Field="t => t.Quantity" Title="تعداد" style="width:125px">
                    <Template>
                        <div class="m-quantity">
                            <span @onclick="async async => await UpdateQuantity(context.Data, context.Data.Quantity + 1)" class="fa fa-plus c-small-icon ms-1"></span>
                            <NumericTextBox TValue="decimal" Value="context.Data.Quantity" ValueChanged="async value => await UpdateQuantity(context.Data, value)" Style="width:50px;" maxlength="3" />
                            <span @onclick="async async => await UpdateQuantity(context.Data, context.Data.Quantity - 1)" class="fa fa-minus c-small-icon me-1"></span>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Title="تاپینگ">
                    <Template>
                        @{var className = context.Data?.Id != selectedDetailId ? "c-btn c-primary" : "c-btn c-secondary"; }
                        <button @onclick="() => OpenTooping(context.Data.Id, context.Data.ProductId)" class="@className">@(GetSumTopping(context.Data.Id))</button>
                    </Template>
                </GridColumn>
                <GridColumn Field="t => ((t.Price - t.Discount) * t.Quantity).DigitGrouping()" Title="قیمت کل" />
            </Columns>
        </DataGrid>
    </div>
    <div class="m-product-panel">
        <div class="m-categories">
            @if (categories != null)
            {
                foreach (var category in categories)
                {
                    var className = category.Id == categoryId ? "m-category m-selected" : "m-category";
                    <div class="@className" @onclick="async e => await SelectCategory(e, category)">
                        @if (category.Categories != null && category.Categories.Count > 0)
                        {
                            <span>@category.Name</span>
                            <i class="c-icon fa fa-chevron-left"></i>
                        }
                        else
                        {
                            <span>@category.Name</span>
                        }
                    </div>
                }
            }
        </div>
        <div class="m-products">
            @if (products != null)
            {
                foreach (var product in products)
                {
                    var className = product.Id == selectedProductId ? "m-product m-selected" : "m-product";
                    <div @onclick="async () => await AddToOrder(product)" class="@className">@product.Title</div>
                }
            }
        </div>
    </div>
    <PopupWindow Top="top" Left="left" @bind-Status="productStatus" Style="min-width:200px;min-height:50px">
        <div class="m-subcategories">
            @foreach (var category in categories.Single(t => t.Id == categoryId).Categories)
            {
                var className = category.Id == subCategoryId ? "m-subcategory m-selected" : "m-subcategory";
                <div class="@className" @onclick="async() =>await SelectCategory(category)" @onclick:stopPropagation>@category.Name</div>
            }
        </div>
    </PopupWindow>
    <PopupWindow Top="10" Left="350" Status="toppingStatus" StatusChanged="status => { toppingStatus = status; selectedDetailId = null; }" >
        <ToppingComponent Service="toppingService" Page="Page" ProductId="toppingProductId.Value" OnChange="sum => sumToppings[toppingService.MasterId] = sum" />
    </PopupWindow>
</div>

