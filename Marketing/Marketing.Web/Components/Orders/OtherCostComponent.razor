@namespace Marketing.Web.OrderComponents
<div class="row c-controls" >
    <NumericTextBox Value="order.RoundAmount" ColSpan="7" TotalSpan="12" Title="مبلغ رند" DigitGrouping />
    <RadioList @bind-Value="order.DiscountType" ColSpan="7" TotalSpan="12" />
    @if (order.DiscountType == DiscountType.Amount)
    {
        <NumericTextBox @bind-Value="order.DiscountAmount" OnChange="OnChange" ColSpan="7" TotalSpan="12" DigitGrouping />
    }
    else
    {
        <NumericTextBox TValue="decimal" Value="order.PercentDiscount" ValueChanged="ChangePercentDiscount" BindingType="BindingType.OnInput" ColSpan="3" TotalSpan="8" Total="3" Title="درصد تخفیف" />
        <NumericTextBox Value="order.DiscountAmount" ColSpan="4" TotalSpan="4" DigitGrouping readonly />
    }
    <NumericTextBox Value="order.ProductAmount"  ColSpan="7" TotalSpan="12" Title="مبلغ غذا" readonly DigitGrouping  />
    <NumericTextBox Value="order.PaymentAmount"  ColSpan="7" TotalSpan="12" Title="جمع کل" readonly DigitGrouping />
</div>


@code
{
    Order order;
    [Parameter]
    public BatchService<Order, OrderDetail> OrderService { get; set; }

    async Task ChangePercentDiscount(decimal discount)
    {
        order.PercentDiscount = discount;
        order.DiscountAmount = GetDiscount();
        await OnChange.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        order = OrderService.UpsertData;
        order.ProductAmount = GetSumProductAmount();
        order.RoundAmount = GetRoundAmount();
        order.DiscountAmount = GetDiscount();
        order.PaymentAmount = order.ProductAmount - order.DiscountAmount + order.RoundAmount.Value;
        base.OnParametersSet();
    }

    [Parameter]
    public IList<Product> Products { get; set; }

    decimal GetSumProductAmount()
    {
        return OrderService.DetailDataView.GetBatchEntities().Sum(t => t.Quantity * (t.ToppingAmount + t.Price - t.Discount));
    }

    [Parameter]
    public EventCallback OnChange { get; set; }

    decimal GetDiscount()
    {
        if (order.DiscountType == DiscountType.Amount)
            return order.DiscountAmount;
        if (order.PercentDiscount > 0)
        {
            var sumProductAmount = GetSumProductAmount();
            return order.PercentDiscount * sumProductAmount / 100;
        }
        return 0;
    }

    decimal GetRoundAmount()
    {
        return ConfigService.GetRoundValue(GetSumProductAmount() - GetDiscount());
    }
}
