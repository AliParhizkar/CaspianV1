@namespace Marketing.Web.OrderComponents
<span @onclick="OpenLevel1" class="fa fa-bars c-small-icon"></span>

<PopupWindow @bind-Status="statusLevel1" Right="50" Top="60">
    <div class="m-orders">
        @foreach (var order in orders)
        {
            var className = order.Id == selectedOrderId? "m-order-item selected" : "m-order-item";
            <div @onmouseenter="e => OpenLevel2(e, order.Id)" class="@className">
                <span class="m-order-number">@order.OrderNumber</span>
                <span @onclick="async () => await SelectOrder(order)" class="fa fa-pencil c-small-icon"></span>
                <span class="m-order-type">@order.OrderType.EnumText()</span>
                <span class="m-total-amount">@(order.PaymentAmount.DigitGrouping())</span>
                <span  class="fa fa-print c-small-icon"></span>
            </div>
        }
    </div>
</PopupWindow>

<PopupWindow @bind-Status="statusLevel2" Right="365" Top="Level2Top" Style="transform:translateY(calc(-50% + 25px))">
    <div class="m-orders-step1">
        <button class="m-action">Click</button>
        <button class="m-action">Click</button>
        <button class="m-action">Click</button>
    </div>
</PopupWindow>

