@namespace Caspian.UI
<div class="main">
    <div class="days-week">
        <div class="c-day-week">ایام هفته</div>
        @foreach (var item in DayOfPersianWeek.Tus.DisplayNames().Select(t => t.Key))
        {
            <div class="c-day-week">@(item)</div>
        }
    </div>
    <div class="weeks">
        <div class="weeks-title">
            @for (var i = 0; i < weeksCount; i++)
            {
                <div class="week-title week-@(weeksCount)">هفته @weeksName[i]</div>
            }
        </div>
        <div class="d-calendar">
            @foreach (var date in dates)
            {
                var className = $"day-month week-{weeksCount}";
                @if (date.HasValue)
                {
                    if (selectedDates.Contains(date.Value))
                        className += " d-Selected";
                    <div class="@className" @onclick="e => ToggleDate(e, date.Value)">
                        @Template(date.Value)
                    </div>
                }
                else
                {
                    <div class="@(className)"></div>
                }
            }
        </div>
    </div>
</div>


@code 
{
    List<DateTime> selectedDates = new();
    int weeksCount, oldYear;
    string[] weeksName = { "اول", "دوم", "سوم", "چهارم", "پنجم", "ششم" };
    IList<DateTime?> dates;
    PersianMonth oldMonth;


    [Parameter]
    public int Year { get; set; }

    [Parameter]
    public PersianMonth Month { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    [Parameter]
    public RenderFragment<DateTime> Template { get; set; }

    void ToggleDate(MouseEventArgs e, DateTime date)
    {
        if (e.CtrlKey)
        {
            if (selectedDates.Contains(date))
                selectedDates.Remove(date);
            else
                selectedDates.Add(date);
        }
        else
        {
            selectedDates.Clear();
            selectedDates.Add(date);
        }
    }

    protected override void OnParametersSet()
    {
        if (oldYear != Year || oldMonth != Month)
        {
            oldYear = Year;
            oldMonth = Month;
            CreateMenus();
        }
        base.OnParametersSet();
    }

    protected override void OnInitialized()
    {
        CreateMenus();
        base.OnInitialized();
    }

    void CreateMenus()
    {
        dates = PersianDate.GetDaysOfMonth(Year, Month);
        weeksCount = dates.Count / 7;
    }
}
