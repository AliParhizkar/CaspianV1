@namespace Caspian.UI
@typeparam TEntity
@attribute [CascadingTypeParameter(nameof(TEntity))]
@inherits DataView<TEntity>
<CascadingValue Value="this" Name="DataView">
    <div @ref="mainDiv" class="c-widget c-data-view">
        <DataToolsBar TEntity="TEntity" ShowInsertIcon="ShowInsertIcon ?? showInsertIcon == true" OnInsertButoonClicked="CreateInsert" />
        <div class="c-dataview-header">
            @HeaderTempalte
        </div>
        @if (fieldsExpression == null)
        {
            fieldsExpression = new List<Expression>();
            @Fields(default)
        }
        else
        {
            var style = ContentHeight == null ? null : $"height:{ContentHeight}px;";
            <div class="c-dataview-content" style="@(style)">
                @if (insertedEntity?.UpsertMode != null && Inline && UpsertType == UpsertType.Inline)
                {
                    <div class="c-listview-insert">
                        @if (selectedEntity == null)
                        {
                            <CaspianContainer ColumnsCount="0" @ref="insertContainer">
                                <CascadingValue Value="InsertContext">
                                    <CaspianValidationValidator TModel="TEntity" ValidatorType="serviceType" Source="source" DetailsService="DetailsService" />
                                    <CascadingValue Value="insertedEntity" Name="RowData">
                                        @Fields(insertedEntity)
                                    </CascadingValue>
                                </CascadingValue>
                            </CaspianContainer>
                        }
                        else
                        {
                            <CaspianContainer ColumnsCount="0" Disabled>
                                <CascadingValue Value="insertedEntity" Name="RowData">
                                    @Fields(insertedEntity)
                                </CascadingValue>
                            </CaspianContainer>
                        }
                    </div>
                }
                @if (items != null)
                {
                    var index = 0;
                    var pKey = typeof(TEntity).GetPrimaryKey();
                    object selectId = selectedEntity != null ? pKey.GetValue(selectedEntity) : null;
                    foreach (var item in items)
                    {
                        var id = Convert.ToInt32(pKey.GetValue(item));
                        var rowIndex = index;
                        var className = $"c-listview-row";
                        if (item == selectedEntity)
                            SelectedRowIndex = rowIndex;
                        if (rowIndex == SelectedRowIndex && SelectType == SelectType.Single)
                            className += " c-selected";
                        var isUpdateing = selectId != null && selectId.Equals(id);
                        var rowData = new RowData<TEntity>()
                            {
                                Data = isUpdateing ? selectedEntity : item,
                                RowIndex = rowIndex,
                                UpsertMode = isUpdateing ? UpsertMode.Edit : null
                            };
                        index++;
                        <div class="@className" @onclick="() => SelectedRowIndex = rowIndex">
                            <CascadingValue Value="rowData" Name="RowData">
                                @if (isUpdateing)
                                {
                                    <CascadingValue Value="EditContext">
                                        <CaspianValidationValidator Source="source" TModel="TEntity" @ref="validator" ValidatorType="serviceType" />
                                        <CaspianContainer ColumnsCount="0" @ref="updateContainer">
                                            @Fields(rowData)
                                        </CaspianContainer>
                                    </CascadingValue>
                                }
                                else
                                {
                                    @Fields(rowData)
                                }
                            </CascadingValue>
                        </div>
                    }
                }
            </div>
            @if (HideFooter != true)
            {
                <DataPager PageNumber="pageNumber" PageNumberChanged="async t => await ChangePageNumber(t)" TotalRecord="Total" PageSize="PageSize" />
            }
        }
    </div>



</CascadingValue>
@if (UpsertType != UpsertType.Inline)
{
    <Window @bind-Status="status" Style="width:800px;">
        <Content>
            @if (status == WindowStatus.Open)
            {
                <CaspianForm Model="insertedEntity">
                    <CaspianValidationValidator Source="source.AsReadOnly()" TModel="TEntity" ValidatorType="serviceType" />
                    <CascadingValue Value="this" Name="DataView">
                        <CascadingValue Value="insertedEntity" Name="RowData">
                            @Fields(insertedEntity)
                        </CascadingValue>
                    </CascadingValue>
                </CaspianForm>
            }
        </Content>
    </Window>
}