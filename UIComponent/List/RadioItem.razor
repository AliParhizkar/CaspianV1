@namespace Caspian.UI
@typeparam TValue
@{
    var value = RadioLis.GetValue();
    var className = "t-radio";
    var selected = RadioLis != null && value != null && value.Equals(Value);
    if (Disabled)
        className += " t-disabled";
    if (selected)
        className += " t-selected";
    else
        className += " t-default";
    @if (IconType.HasValue)
    {
        var iconClass = $"fa fa-{IconType.EnumText().ToLower()} c-small-icon";
        <div style="@Style" class="@className" @onclick="OnMouseClick">
            <span class="@iconClass"></span>
        </div>
    }
    else
    {
        <div style="@Style" class="@className">
            <div @onclick="OnMouseClick" class="t-icon">
                <input type="radio" class="c-radio-button" />
                @if (selected)
                {
                    <span class="c-radio"></span>
                }
            </div>
            @if (!HideTitle)
            {
                <div class="t-title" @onclick="OnMouseClick">@Title</div>
            }
        </div>
    }
}

