@namespace Caspian.UI
@using System.ComponentModel.DataAnnotations
@typeparam TValue
@inherits CBaseInput<TValue>

@if (ColSpan.HasValue)
{
    var container = CaspianForm as ICaspianContainer ?? CaspianContainer as ICaspianContainer ?? EntitySearch as ICaspianContainer;
    string lableContainerCSSClassName = container?.GetLableContainerCSSClassName(ColSpan.Value, TotalSpan);
    string controlContainerCSSClassName = container?.GetControlContainerCSSClassName(ColSpan.Value, TotalSpan);
    <div class="@(lableContainerCSSClassName)">
        <label>@title</label>
    </div>
    <div class="@(controlContainerCSSClassName)">
        @RenderDropdownList()
    </div>
}
else
{
    @RenderDropdownList()
}

@code
{
    RenderFragment RenderDropdownList()
    {
        return __builder =>
        {
            var className = "t-inputbox-wrap";
            if (disabled)
                className += " t-state-disabled";
            else if (ErrorMessage == null)
                className += " t-state-default";
            else
                className += " t-state-error";
            var index = 1;
            <div @ref="InputElement" @onkeyup="OnkeyUp" @attributes="attrs" class="t-widget t-dropdown" error-message="@ErrorMessage">
                <div class="@className" @onmousedown="OpenWindow">
                    <span class="t-input">@(text)</span>
                    <span class="t-select">
                        <i class="t-icon t-arrow-down fa fa-caret-down"></i>
                    </span>
                </div>
                @if (status == WindowStatus.Open)
                {
                    <div class="t-animation-container">
                        <div class="t-popup t-group">
                            <ul class="t-reset">
                                @foreach (var item in items)
                                {
                                    string name = "t-item";
                                    if (index == selectedIndex)
                                        name += " t-state-selected";
                                    if (item.Disabled)
                                        name += " t-disable";
                                    @if (EntitySearch == null)
                                    {
                                        <li @onmousedown="async () => await SetValueForActiveItem(item)" class="@name">@item.Text</li>
                                    }
                                    else if (item.Value != null)
                                    {
                                        <li class="c-multi-select-drowp">

                                            <CheckBox Title="@(item.Text)" Value="values.Contains(item.Value)" ValueChanged="e => UpdateValues(e, item.Value)" TValue="bool"  />
                                        </li>
                                    }
                                    index++;
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        };
    }
}
