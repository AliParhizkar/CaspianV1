@namespace Caspian.UI
@typeparam TEntity
@inject IJSRuntime JSRuntime
@inject IServiceScopeFactory ServiceScopeFactory

@if (Source == null)
{
    <div @ref="tree" @attributes="Attrs" class="c-treeview">
        <CascadingValue Value="this" >
            <ul class="c-subtree">
                @if (treeNodes != null)
                {
                    var index = 0;
                    foreach (var item in treeNodes)
                    {
                        index++;
                        if (ChildContent == null)
                        {
                            <TreeNode @bind-Selected="item.Selected" @attributes="GetNodeAttributes(item, index == treeNodes.Count)" />
                        }
                        else if (item.Expanded)
                        {
                            <li>
                                @ChildContent(item)
                            </li>
                        }
                    }
                }
            </ul>
        </CascadingValue>
    </div>
}
else
{
    var index = 0;
    <div @ref="tree" @attributes="Attrs" class="c-treeview">
        <CascadingValue Value="this">
            <ul class="c-subtree">
                @foreach (var item in Source)
                {
                    if (filteredSource == null || filteredSource.Any(u => u.Value == item.Value))
                    {
                        index++;
                        <TreeNode @attributes="GetNodeAttributes(item, (filteredSource ?? Source).Count == index)" />
                    }
                }
            </ul>
        </CascadingValue>
    </div>
}
