@inject IJSRuntime JSRuntime
@namespace Caspian.UI
@{
    var className = Item.Expanded ? "c-expand" : "c-collaps";
    if (IsLast)
        className += " c-node-last";
    var titleClassName = "c-title";
    if (TreeView.ClickedNode == this)
        titleClassName += " c-node-clicked";
}
<li @ref="Node" class="@(className)">
    <div class="c-node-template">
        @if (Item.Collabsable)
        {
            var iconClassName = "fa fa-chevron-" + (PageData?.RightToLeft == true ? "left" : "right");
            <span class="c-icon">
                <i @onclick="async () => await ToggleNode()" class="@(iconClassName)"></i>
            </span>
        }
        @if (Item.Selectable)
        {
            <CheckBox TValue="bool?" Value="Item.Selected" Disabled="Item.Disabled" TwoState ValueChanged="async value => await ValueChanged(value)" />
        }
        @if (TreeView?.BeforeNodeTemplate != null)
        {
            <div class="c-node-before-template">
                @TreeView.BeforeNodeTemplate(Item)
            </div>
        }
        <span @attributes="GetTitleAttributes()">
            @Item.Text
        </span>
        @if (Item.Depth == null)
        {
            if (Item.Parent == null)
                Item.Depth = 1;
            else
                Item.Depth = Convert.ToByte(Item.Parent.Depth.Value + 1);
        }
        @if (TreeView?.AfterNodeTemplate != null)
        {
            <CascadingValue Value="Item.Depth" Name="NodeDepthOnTree">
                @TreeView.AfterNodeTemplate(Item)
            </CascadingValue>
        }
    </div>
    @if (Item.Children != null && Item.Expanded)
    {
        var index = 0;
        <ul class="c-subtree">
            @foreach (var item in Item.Children)
            {
                index++;
                if (item.Parent == null)
                    item.Parent = Item;
                <TreeNode @attributes="GetNodeAttributes(item, index == Item.Children.Count)" />
            }
        </ul>
    }
</li>

@code
{
    bool? Collapsed;
    ElementReference Node;

    [CascadingParameter]
    public PageData PageData { get; set; }

    IDictionary<string, object> GetTitleAttributes()
    {
        var dic = new Dictionary<string, object>();
        var className = "c-title";
        if (TreeView.ClickedNode == this)
            className += " c-node-clicked";
        dic.Add("class", className);
        if (!Item.Disabled)
        {

            if (Item.Selectable)
            {
                dic.Add("onclick", EventCallback.Factory.Create<MouseEventArgs>(this,async e => 
                    {
                        Item.Selected = !Item.Selected;
                        if (Item.Selected == true && TreeView.OnSelected.HasDelegate)
                            await TreeView.OnSelected.InvokeAsync(Item);
                        if (TreeView.OnChange.HasDelegate)
                            await TreeView.OnChange.InvokeAsync(Item);
                        if (TreeView.OnClick.HasDelegate)
                            await ClickEventhandler(e);
                        await BindInternalEvents();
                    }));
            }
            else if (TreeView.OnClick.HasDelegate || TreeView?.OnInternalClicked.HasDelegate == true || TreeView?.OnInternalCHanged.HasDelegate == true)
                dic.Add("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, async e => await ClickEventhandler(e)));
            if (TreeView.OnRightClick.HasDelegate)
            {
                dic.Add("oncontextmenu", "return false");
                dic.Add("onmouseup", EventCallback.Factory.Create<MouseEventArgs>(this, async e =>
                    {
                        if (e.Button == 2)
                        {
                            TreeView.ClickedNode = this;
                            await TreeView.OnRightClick.InvokeAsync(new NodeMouseEventArg(e, Item));
                        }
                    }));
            }
        }
        return dic;
    }

    async Task BindInternalEvents()
    {
        if (TreeView?.OnInternalClicked.HasDelegate == true)
            await TreeView.OnInternalClicked.InvokeAsync(Item);
        if (TreeView?.OnInternalCHanged.HasDelegate == true)
            await TreeView.OnInternalCHanged.InvokeAsync(Item);
    }

    async Task ClickEventhandler(MouseEventArgs e)
    {
        TreeView.ClickedNode = this;
        await BindInternalEvents();
        if (TreeView.OnClick.HasDelegate)
            await TreeView.OnClick.InvokeAsync(new NodeMouseEventArg(e, Item));
    }

    async Task ToggleNode()
    {
        if (Item.Expanded)
        {
            Item.Expanded = false;
            if (TreeView.OnCollapsed.HasDelegate)
                await TreeView.OnCollapsed.InvokeAsync(Item);
        }
        else
        {
            Item.Expanded = true;
            if (TreeView.OnExpanded.HasDelegate)
                await TreeView.OnExpanded.InvokeAsync(Item);
        }
        Collapsed = !Item.Expanded;
    }

    async Task ValueChanged(bool? value)
    {
        Item.Selected = value;
        if (value == true && TreeView.OnSelected.HasDelegate)
            await TreeView.OnSelected.InvokeAsync(Item);
        if (TreeView.OnChange.HasDelegate)
            await TreeView.OnChange.InvokeAsync(Item);
        if (TreeView.OnInternalCHanged.HasDelegate)
            await TreeView.OnInternalCHanged.InvokeAsync(Item);
    }

    IDictionary<string, object> GetNodeAttributes(NodeView node, bool isLast)
    {
        var attrs = new Dictionary<string, object>();
        attrs.Add("Item", node);
        attrs.Add("IsLast", isLast);
        return attrs;
    }

    [Parameter]
    public bool? Selected { get; set; } = false;

    [Parameter]
    public bool IsLast{ get; set; }

    [Parameter]
    public EventCallback<bool?> SelectedChanged { get; set; }

    [CascadingParameter]
    public ITreeView TreeView { get; set; }

    [Parameter]
    public NodeView Item { get; set; }
}
