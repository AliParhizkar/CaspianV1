@namespace Caspian.UI
@typeparam TEntity
@typeparam TValue
@inherits CBaseInput<TValue>
@attribute [CascadingTypeParameter(nameof(TValue))]
@inject IJSRuntime jsRuntime
@inject IServiceScopeFactory ServiceScopeFactory

@if (ColSpan.HasValue)
{
    <div class="@(GetLabelCSSClassName())">
        <label @attributes="LabelAttributes">@(GetTitle())</label>
    </div>
    <div class="@(GetControlCSSClassName())">
        @RenderLookup()
    </div>
}
else
{
    @RenderLookup()
}

@code
{
    RenderFragment RenderLookup()
    {
        return __builder =>
        {
            <div @attributes="GetMainAttribute()">
                <input @ref="InputElement" @onkeydown="@(async e => await OnKeyDownHandler(e))"
                       @attributes="inputAttrs" @onkeyup="@(async e => await OnKeyUp(e))" @onsubmit:preventDefault />
                @if (!HideIcon)
                {
                    <span class="fa fa-search" @onclick="() => OpenWindow(true)"></span>
                }
                <div class="c-content">
                    @if (status == WindowStatus.Open)
                    {
                        <div class="t-HelpWindow">
                            @if (!HideHeader && advanceSearch)
                            {
                                <div class="t-header">
                                    <div class="t-window-title">@(WindowTitle)</div>
                                    <div class="t-window-action t-link" @onclick="async() => await CloseHelpForm(null)">
                                        <i class="fa fa-close"></i>
                                    </div>
                                </div>
                            }
                            <div class="t-content">
                                <CascadingValue Name="LookupStringSearchValue" Value="SearchStr" IsFixed>
                                    <CascadingValue Value=this>
                                        @ChildContent
                                    </CascadingValue>
                                </CascadingValue>
                            </div>
                        </div>
                    }
                </div>
            </div>
        };
    }
}

