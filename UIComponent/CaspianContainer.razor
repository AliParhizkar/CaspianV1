@namespace Caspian.UI
@implements ICaspianContainer
<CascadingValue Value="this">
    @if (ColumnsCount > 0)
    {
        <div class="row c-controls">
            @ChildContent
        </div>
    }
    else
    {
        @ChildContent
    }
</CascadingValue>

@code
{
    IControl Control;
    IList<IControl> Controls;
    bool hasFocus;

    internal void SetControl(IControl control)
    {
        if (Control == null)
            Control = control;
        if (Controls == null)
            Controls = new List<IControl>();
        if (!Controls.Contains(control))
            Controls.Add(control);
    }

    public async Task FocusAsync()
    {
        if (Control != null)
            await Control.FocusAsync();
    }

    public void Focus()
    {
        hasFocus = true;
    }

    public async Task ResetAsync()
    {
        foreach (var control in Controls)
            await control.ResetAsync();
        await Task.Delay(1);
        await FocusAsync();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (hasFocus && Control != null)
            hasFocus = false;
        await base.OnAfterRenderAsync(firstRender);
    }

    [CascadingParameter]
    internal PageData PageData { get; set; }

    string ICaspianContainer.GetLabelContainerCSSClassName(int colSpan)
    {
        var className = PageData?.RightToLeft == true ? "ps-2" : "pe-2";
        className += " col-md-";
        if (ColumnsCount == 1)
            return className + (12 - colSpan);
        if (colSpan < 6)
            className += (6 - colSpan);
        else
            className += (12 - colSpan);
        return className;
    }

    [Parameter]
    public int ColumnsCount { get; set; } = 1;

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
