@namespace Caspian.UI


@code
{
    protected override void OnInitialized()
    {
        if (ParentTabPanel == null)
            throw new CaspianException("TabPanelItem should be child of TabPanel");
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        ParentTabPanel.AddTabpanelItem(this);
        base.OnParametersSet();
    }

    [CascadingParameter(Name = "ParentTabPanel")]
    public TabPanel ParentTabPanel { get; set; }

    internal int TabIndex { get; private set; }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public bool Disable { get; set; }

    internal void DisableItem(bool status)
    {
        Disable = status;
    }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool Closeable { get; set; } = true;
}
