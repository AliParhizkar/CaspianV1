@namespace Caspian.UI
@inject IUIService<TDetail> Service 
@inject IServiceProvider ServiceProvider
@typeparam TEntity where TEntity : class
@typeparam TDetail where TDetail : class
@implements IEntityTabPanelItem

<TabPanelItem Title="@title" Disable="Service.MasterId == 0">
    @if (ChildContent != null)
    {
        @ChildContent
    }
</TabPanelItem>

@code
{
    string title;

    protected override void OnInitialized()
    {
        TabPanel.AddTabpanelItem(this);
        if (Children.Body.NodeType == ExpressionType.MemberAccess)
        {
            var info = (Children.Body as MemberExpression).Member as PropertyInfo;
            title = info.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName;
        }
        Service.MasterId = TabPanel.Service.MasterId;
        (Service as UIService<TDetail>).MasterType = typeof(TEntity);
        base.OnInitialized();
    }

    Type IEntityTabPanelItem.GetEntityType() => ((Children.Body as MemberExpression).Member as PropertyInfo).PropertyType;

    bool IEntityTabPanelItem.IsChildrenTabPanelItem() => true;


    [Parameter]
    public Expression<Func<TEntity, IEnumerable<TDetail>>> Children { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string Title { get; set; }

    protected override void OnParametersSet()
    {
        if (Title != null)
            title = Title;
        var value = typeof(TEntity).GetPrimaryKey().GetValue(TabPanel.Service.UpsertData);
        var masterId = Convert.ToInt32(value);
        Service.MasterId = masterId;
        base.OnParametersSet();
    }

    [CascadingParameter]
    internal EntityTabPanel<TEntity> TabPanel { get; set; }
}
