@namespace Caspian.UI
@inject UIService<TDetail> Service 
@inject IServiceProvider ServiceProvider
@typeparam TEntity where TEntity : class
@typeparam TDetail where TDetail : class
<Caspian.UI.TabPanelItem Title="@title" Disable="disabled">
    @if (ChildContent != null)
    {
        @ChildContent
    }
</Caspian.UI.TabPanelItem>

@code
{
    string title;
    bool disabled;
    int tabIndex;

    protected override void OnInitialized()
    {
        tabIndex = TabPanel.GetTabIndex(null);
        if (Children.Body.NodeType == ExpressionType.MemberAccess)
        {
            var info = (Children.Body as MemberExpression).Member as PropertyInfo;
            title = info.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName;
        }
        Service.MasterId = TabPanel.Service.MasterId;
        Service.MasterType = typeof(TEntity);
        base.OnInitialized();
    }

    [Parameter]
    public Expression<Func<TEntity, IEnumerable<TDetail>>> Children { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string Title { get; set; }

    protected override void OnParametersSet()
    {
        if (Title != null)
            title = Title;
        var value = typeof(TEntity).GetPrimaryKey().GetValue(TabPanel.Service.UpsertData);
        var masterId = Convert.ToInt32(value);
        Service.MasterId = masterId;
        disabled = masterId == 0;

        base.OnParametersSet();
    }

    [CascadingParameter]
    public EntityTabPanel<TEntity> TabPanel { get; set; }
}
