@namespace Caspian.UI

@inject IServiceProvider ServiceProvider
@typeparam TEntity where TEntity : class
@typeparam TDetail where TDetail : class
<Caspian.UI.TabPanelItem Title="@title" Disable="disabled">
    @if (Content != null)
    {
        @Content(service)
    }
</Caspian.UI.TabPanelItem>
@code
{
    UIService<TDetail> service;
    string title;
    bool disabled;

    protected override void OnInitialized()
    {
        service = new UIService<TDetail>(ServiceProvider);
        if (Children.Body.NodeType == ExpressionType.MemberAccess)
        {
            var info = (Children.Body as MemberExpression).Member as PropertyInfo;
            title = info.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName;
        }
        base.OnInitialized();
    }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public Expression<Func<TEntity, IList<TDetail>>> Children { get; set; }

    [Parameter]
    public RenderFragment<UIService<TDetail>> Content { get; set; }

    [Parameter]
    public string Title { get; set; }

    protected override void OnParametersSet()
    {
        if (Title != null)
            title = Title;
        var id = typeof(TEntity).GetPrimaryKey().GetValue(TabPanel.Service.UpsertData);
        disabled = id.Equals(0);
        base.OnParametersSet();
    }

    [CascadingParameter]
    public EntityTabPanel<TEntity> TabPanel { get; set; }
}
