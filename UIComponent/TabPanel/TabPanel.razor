@namespace Caspian.UI
@inject IJSRuntime JSRuntime
@inject FormAppState FormState
@{
    var className = Vertical ? "t-widget t-tabstrip t-vertical" : "t-widget t-tabstrip";
}
<CascadingValue Value="this" Name="ParentTabPanel">
    <div @ref="element" style="@Style" class="@className">
        <div class="t-widget t-header">
            <div class="c-tabstrip-items">
                <ul class="t-reset t-tabstrip-items" >
                    @Tabs
                </ul>
                <span class="c-selected-panel"></span>
            </div>
        </div>
        <div class="t-content t-state-active">
            @if (CurentTabpanel != null)
            {
                @CurentTabpanel.ChildContent
            }
        </div>
    </div>
</CascadingValue>
@code 
{
    int tabIndex;
    ElementReference element;

    internal TabPanelItem CurentTabpanel { get; private set; }
    internal TabPanelItem LastTabpanel { get; private set; }

    [Parameter]
    public bool Vertical { get; set; }

    [Parameter]
    public int TabIndex { get; set; } = 1;

    [Parameter]
    public string Style { get; set; }

    [Parameter]
    public bool LoadOnDemand { get; set; }

    [Parameter]
    public EventCallback<int> TabIndexChanged { get; set; }

    [Parameter]
    public RenderFragment Tabs { get; set; }

    [Parameter]
    public bool AddButton { get; set; }

    internal async Task SelectTabPanel(TabPanelItem item, int index)
    {
        CurentTabpanel = item;
        TabIndex = index;
        if (TabIndexChanged.HasDelegate)
            await TabIndexChanged.InvokeAsync(index);
        else
            StateHasChanged();
    }

    internal void SetLastTabPanel(TabPanelItem item)
    {
        if (CurentTabpanel.TabIndex != item.TabIndex)
            LastTabpanel = item;
    }

    internal int GetTabIndex()
    {
        tabIndex++;
        return tabIndex;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("caspian.common.bindTabpanel", element);
        await base.OnAfterRenderAsync(firstRender);
    }
}
