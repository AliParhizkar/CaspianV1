@namespace Caspian.UI
@inject IJSRuntime JSRuntime
@inject FormAppState FormState
@{
    var className = Vertical ? "t-widget t-tabstrip t-vertical" : "t-widget t-tabstrip";
}
<CascadingValue Value="this" Name="ParentTabPanel">
    @if (tabPanels == null)
    {
        @Tabs
    }
    else
    {
        int index = 0;
        <div @ref="element" style="@Style" class="@className">
            <div class="t-widget t-header">
                <div class="c-tabstrip-items">
                    <ul class="t-reset t-tabstrip-items">
                        @foreach(var panel in tabPanels)
                        {
                            var temp = panel;
                            var className = "t-item ";
                            if (panel.Disable)
                                className += "t-state-disabled";
                            else
                            {
                                if (index == TabIndex - 1)
                                    className += "t-state-active";
                                else
                                    className += "t-state-default";
                            }
                            <li @key="index" class="@className">
                                @if (index == TabIndex - 1)
                                {
                                    <span class="t-link">@((MarkupString)panel.Title)</span>
                                }
                                else
                                {
                                    <span class="t-link" @onclick="async () => await SelectTabPanel(temp)">@((MarkupString)panel.Title)</span>
                                }
                            </li>
                            index++;
                        }
                    </ul>
                    <span class="c-selected-panel"></span>
                </div>
            </div>
            <div class="t-content t-state-active">
                @if (tabPanels.Count >= TabIndex && TabIndex > 0)
                {
                    @tabPanels[TabIndex - 1].ChildContent
                }
            </div>
        </div>
    }
</CascadingValue>
@code 
{
    int tabIndex;
    ElementReference element;
    IList<TabPanelItem> tabPanels;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    internal void AddTabpanelItem(TabPanelItem tabPanelItem)
    {
        if (tabPanels == null)
            tabPanels = new List<TabPanelItem>();
        if (!tabPanels.Contains(tabPanelItem))
        {
            tabPanels.Add(tabPanelItem);
            StateHasChanged();
        }
    }

    public void Clear()
    {
        tabPanels = null;
    }

    [Parameter]
    public bool Vertical { get; set; }

    [Parameter]
    public int TabIndex { get; set; } = 1;

    [Parameter]
    public string Style { get; set; }

    [Parameter]
    public bool LoadOnDemand { get; set; }

    [Parameter]
    public EventCallback<int> TabIndexChanged { get; set; }

    [Parameter]
    public RenderFragment Tabs { get; set; }

    [Parameter]
    public bool AddButton { get; set; }

    internal async Task SelectTabPanel(TabPanelItem item)
    {
        if (!item.Disable)
        {
            var index = tabPanels.IndexOf(item);
            if (TabIndexChanged.HasDelegate)
                await TabIndexChanged.InvokeAsync(index + 1);
            else
            {
                TabIndex = index + 1;
                StateHasChanged();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("caspian.common.bindTabpanel", element);
        if (firstRender)
            StateHasChanged();
        await base.OnAfterRenderAsync(firstRender);
    }
}
