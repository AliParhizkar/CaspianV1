@namespace Caspian.UI
@typeparam TEntity where TEntity : class
@attribute [CascadingTypeParameter(nameof(TEntity))]
@implements IEntityTabPanel
<TabPanel @ref="tabPanel" TabIndex="TabIndex" TabIndexChanged="UpdateService" Vertical="Vertical" >
    <Tabs>
        <CascadingValue Value="this">
            @if (Content != null)
            {
                @Content(Service.UpsertData)
            }
        </CascadingValue>
    </Tabs>
</TabPanel>

@code
{
    TabPanel tabPanel;
    IList<Type> childTypes;

    async Task UpdateService(int tabIndex)
    {
        if (TabIndexChanged.HasDelegate)
            await TabIndexChanged.InvokeAsync(tabIndex);
        else
        {
            TabIndex = tabIndex;
            var type = childTypes[TabIndex - 1];
            if (type != null)
                await (Service as IInternalUIService<TEntity>).UpdateChildOfModelAsync(type);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TabIndexChanged.HasDelegate && childTypes.Count >= TabIndex)
        {
            var type = childTypes[TabIndex - 1];
            if (type != null)
                await (Service as IInternalUIService<TEntity>).UpdateChildOfModelAsync(type);
        }
        await base.OnParametersSetAsync();
    }

    protected override void OnInitialized()
    {
        childTypes = new List<Type>();
        (Service as IInternalUIService<TEntity>).TabPanelInitializer(this);
        base.OnInitialized();
    }

    internal void GetTabIndex(Type childType)
    {
        childTypes.Add(childType);
    }

    [Parameter]
    public RenderFragment<TEntity> Content { get; set; }

    [Parameter]
    public IUIService<TEntity> Service { get; set; }

    [Parameter]
    public bool Vertical { get; set; }

    [Parameter]
    public int TabIndex { get; set; } = 1;

    [Parameter]
    public EventCallback<int> TabIndexChanged { get; set; }

    public void ChangeState()
    {
        StateHasChanged();
    }
}