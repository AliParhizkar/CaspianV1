@namespace Caspian.UI
@typeparam TEntity where TEntity : class
@attribute [CascadingTypeParameter(nameof(TEntity))]
@implements IEntityTabPanel
<TabPanel @ref="tabPanel" Vertical="Vertical">
    <Tabs>
        <CascadingValue Value="this">
            @if (Content != null)
            {
                @Content(Service.UpsertData)
            }
        </CascadingValue>
    </Tabs>
</TabPanel>

@code
{
    int tabIndex;
    TabPanel tabPanel;
    protected override void OnInitialized()
    {
        Service.EntityTabPanel = this;
        Service.TabPanelInitialize();
        base.OnInitialized();
    }

    void ChangeTabIndex(int tabIndex)
    {
        //TabPanelSelected?.Invoke(tabIndex);
    }

    internal int GetSelectedTabPanelIndex()
    {
        return tabPanel.TabIndex;
    }

    internal Action<int> TabPanelSelected { get; private set; }

    internal int GetTabIndex()
    {
        tabIndex++;
        return tabIndex;
    }

    [Parameter]
    public RenderFragment<TEntity> Content { get; set; }

    [Parameter]
    public IUIService<TEntity> Service { get; set; }

    [Parameter]
    public bool Vertical { get; set; }

    public void ChangeState()
    {
        StateHasChanged();
    }
}