@namespace Caspian.UI
@typeparam TEntity where TEntity : class
@attribute [CascadingTypeParameter(nameof(TEntity))]
@implements IEntityTabPanel
<TabPanel @ref="tabPanel" TabIndexChanged="UpdateService" Vertical="Vertical">
    <Tabs>
        <CascadingValue Value="this">
            @if (Content != null)
            {
                @Content(Service.UpsertData)
            }
        </CascadingValue>
    </Tabs>
</TabPanel>

@code
{
    int tabIndex;
    TabPanel tabPanel;
    IList<Type> childTypes;

    async Task UpdateService(int tabIndex)
    {
        var type = childTypes[tabIndex - 1];
        if (type != null)
            await Service.UpdateChildOfModelAsync(type);
    }

    protected override void OnInitialized()
    {
        childTypes = new List<Type>();
        Service.EntityTabPanel = this;
        Service.TabPanelInitialize();
        base.OnInitialized();
    }

    internal int GetTabIndex(Type childType)
    {
        childTypes.Add(childType);
        tabIndex++;
        return tabIndex;
    }

    [Parameter]
    public RenderFragment<TEntity> Content { get; set; }

    [Parameter]
    public IUIService<TEntity> Service { get; set; }

    [Parameter]
    public bool Vertical { get; set; }

    public void ChangeState()
    {
        StateHasChanged();
    }
}