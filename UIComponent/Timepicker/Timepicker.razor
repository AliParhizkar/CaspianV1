@namespace Caspian.UI
@typeparam TValue
@inject IJSRuntime JSRuntime
@inherits CBaseInput<TValue>
@using System.Text.RegularExpressions

@if (ColSpan.HasValue)
{
    var container = (CaspianForm as ICaspianContainer ?? CaspianContainer as ICaspianContainer ?? EntitySearch as ICaspianContainer);
    string labelContainerCSSClassName = base.GetLabelCSSClassName();
    string controlContainerCSSClassName = base.GetControlCSSClassName();
    <div class="@(labelContainerCSSClassName)">
        <label>@title</label>
    </div>
    <div class="@(controlContainerCSSClassName)">
        @RenderTimePicker()
    </div>
}
else
{
    @RenderTimePicker()
}


@code
{
    RenderFragment RenderTimePicker()
    {
        return __builder =>
        {
            string str = "";
            TimeSpan time = default(TimeSpan);
            if (Value != null)
            {
                if (typeof(TValue).GetUnderlyingType() == typeof(TimeOnly))
                    time = ((TimeOnly)Convert.ChangeType(Value, typeof(TimeOnly))).ToTimeSpan();
                else
                    time = (TimeSpan)Convert.ChangeType(Value, typeof(TimeSpan));
                str = time.ShortString();
            }
            string className = "t-inputbox-wrap";
            if (disabled)
                className += " t-state-disabled";
            else
            {
                if (ErrorMessage != null)
                    className += " t-state-error";
            }
            <div @ref="InputElement" class="t-widget t-timepicker" style="@(Style)">
                <div @attributes="attrs" class="@className">
                    @if (DefaultMode)
                    {
                        <input disabled="@disabled" type="time" value="@str" class="t-input t-default-mode" @onchange="ChangeValue" />
                    }
                    else
                    {
                        <input disabled="@disabled" value="@str" class="t-input" @onchange="ChangeValue" />
                        <span @onclick="OpenTimePanel" class="t-select">
                            <span class="t-icon t-icon-clock fa fa-clock-o"></span>
                        </span>
                    }

                </div>
                @if (status == WindowStatus.Open && !DefaultMode)
                {
                    <div class="t-animation-container">
                        <TimePanel OnChange="Change" FromTime="FromTime" ToTime="ToTime" AutoSelect="AutoSelect" Hour="time.Hours" Minute="time.Minutes" />
                    </div>
                }
            </div>
        };
    }
}
