@namespace Caspian.UI
@using System.Diagnostics
@inherits CBaseInput<string>

@if (ColSpan.HasValue)
{
    var container = (CaspianForm as ICaspianContainer ?? CaspianContainer as ICaspianContainer ?? EntitySearch as ICaspianContainer);
    string lableContainerCSSClassName = container.GetLableContainerCSSClassName(ColSpan.Value, TotalSpan);
    string controlContainerCSSClassName = container.GetControlContainerCSSClassName(ColSpan.Value, TotalSpan);
    <div class="@(lableContainerCSSClassName)">
        <label>@title</label>
    </div>
    <div class="@(controlContainerCSSClassName)">
        @RenderStringTextBox()
    </div>
}
else
{
    @RenderStringTextBox()
}


@code 
{
    RenderFragment RenderStringTextBox() 
    {
        return __builder =>
        {
            <div @attributes="GetAttributes()">
                @if (MultiLine)
                {
                    @if (base.BindingType == BindingType.OnChange)
                    {
                        <textarea value="@Value" @ref="InputElement" @attributes="GetInputAttributes()" @onchange="ChangeValue">@Value</textarea>
                    }
                    else
                    {
                        <textarea value="@Value" @ref="InputElement" @attributes="GetInputAttributes()" @oninput="ChangeValue">@Value</textarea>
                    }
                }
                else
                {
                    @if (base.BindingType == BindingType.OnChange)
                    {
                        <input value="@Value" @onchange="ChangeValue" @ref="InputElement" @attributes="GetInputAttributes()" />
                    }
                    else
                    {
                        <input value="@Value" @oninput="ChangeValue" @ref="InputElement" @attributes="GetInputAttributes()" />
                    }
                }
            </div>
        };
    }
}