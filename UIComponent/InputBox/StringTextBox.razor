@namespace Caspian.UI
@using System.Diagnostics
@inherits CBaseInput<string>

@if (ColSpan.HasValue)
{
    <div class="@(base.GetLabelCSSClassName())">
        <label>@title</label>
    </div>
    <div class="@(base.GetControlCSSClassName())">
        @RenderStringTextBox()
    </div>
}
else
{
    @RenderStringTextBox()
}


@code 
{
    RenderFragment RenderStringTextBox() 
    {
        return __builder =>
        {
            <div @attributes="GetAttributes()">
                @if (MultiLine)
                {
                    @if (base.BindingType == BindingType.OnChange)
                    {
                        <textarea value="@Value" @ref="InputElement" @attributes="GetInputAttributes()" @onchange="async e => await ChangeValue(e)">@Value</textarea>
                    }
                    else
                    {
                        <textarea value="@Value" @ref="InputElement" @attributes="GetInputAttributes()" @oninput="async e => await ChangeValue(e)">@Value</textarea>
                    }
                }
                else
                {
                    @if (base.BindingType == BindingType.OnChange)
                    {
                        <input value="@Value" @onchange="async e => await ChangeValue(e)" @ref="InputElement" @attributes="GetInputAttributes()" />
                    }
                    else
                    {
                        <input value="@Value" @oninput="async e => await ChangeValue(e)" @ref="InputElement" @attributes="GetInputAttributes()" />
                    }
                }
            </div>
        };
    }
}