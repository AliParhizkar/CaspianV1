@namespace Caspian.UI
@using System.Threading
@typeparam TValue
@inherits CBaseInput<TValue>
@if (ColSpan.HasValue)
{
    var container = (CaspianForm as ICaspianContainer ?? CaspianContainer as ICaspianContainer);
    string lableContainerCSSClassName = container?.GetLableContainerCSSClassName(ColSpan.Value);
    string controlContainerCSSClassName = container?.GetControlContainerCSSClassName(ColSpan.Value);
    <div class="@(lableContainerCSSClassName)">
        <label>@title</label>
    </div>
    <div class="@(controlContainerCSSClassName)">
        @RenderNumericTextBox()
    </div>
}
else
{
    @RenderNumericTextBox()
}


@code
{
    RenderFragment RenderNumericTextBox()
    {
        return __builder =>
        {
            if (disabled)
                InputAttributes["disabled"] = "disabled";
            else
                InputAttributes.Remove("disabled");
            <div @attributes="GetAttributes()">
                @{
                    var text = Convert.ToString(Value);
                    var decimalDigits = Convert.ToChar(Thread.CurrentThread.CurrentCulture.NumberFormat.NumberDecimalSeparator);
                    text = text.Replace(decimalDigits, '.');
                }
                @if (BindingType == BindingType.OnChange)
                {
                    <input @ref="InputElement" @attributes="InputAttributes" value="@text" @onchange="onChangeValue" class="t-input" />
                }
                else
                {
                    <input @ref="InputElement" value="@text" @attributes="InputAttributes" @oninput="onChangeValue" class="t-input" />
                }
            </div>

        };
    }
}
