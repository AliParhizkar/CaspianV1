@namespace Caspian.UI
@using System.Threading
@typeparam TValue
@inherits CBaseInput<TValue>
@if (ColSpan.HasValue)
{
    <div class="@(base.GetLabelCSSClassName())">
        <label>@title</label>
    </div>
    <div class="@(base.GetControlCSSClassName())">
        @RenderNumericTextBox()
    </div>
}
else
{
    @RenderNumericTextBox()
}


@code
{
    RenderFragment RenderNumericTextBox()
    {
        return __builder =>
        {
            var text = Convert.ToString(Value);
            var decimalDigits = Convert.ToChar(Thread.CurrentThread.CurrentCulture.NumberFormat.NumberDecimalSeparator);
            text = text.Replace(decimalDigits, '.');
            if (DigitGrouping)
                text = GetDigitGrouping(text);
            if (disabled)
                InputAttributes["disabled"] = "disabled";
            else
                InputAttributes.Remove("disabled");
            <div @attributes="GetAttributes()">
                @if (BindingType == BindingType.OnChange)
                {
                    <input @ref="InputElement" @attributes="InputAttributes" value="@text" @onchange="OnChangeValue" class="t-input t-numeric" />
                }
                else
                {
                    <input @ref="InputElement" value="@text" @attributes="InputAttributes" @oninput="OnChangeValue" class="t-input t-numeric" />
                }
            </div>

        };
    }
}
