@namespace Caspian.UI
@using System.Globalization;
@using System.Threading;
@typeparam TValue
@inherits CBaseInput<TValue>
@if (EntitySearch != null && !ParentControlIsValueSearch)
{
    <ValueSearch ValueExpression="ValueExpression.Body" ColSpan="ColSpan" TotalSpan="TotalSpan" />
}
else
{
    @if (ColSpan.HasValue)
    {
        var container = (CaspianForm as ICaspianContainer ?? CaspianContainer as ICaspianContainer ?? EntitySearch as ICaspianContainer);
        string labelContainerCSSClassName = base.GetLabelCSSClassName();
        string controlContainerCSSClassName = base.GetControlCSSClassName();
        <div class="@(labelContainerCSSClassName)">
            <label>@title</label>
        </div>
        <div class="@(controlContainerCSSClassName)">
            @RenderDatePicker()
        </div>
    }
    else
    {
        @RenderDatePicker()
    }
}

@code
{
    RenderFragment RenderDatePicker()
    {
        return __builder =>
        {
            var className = "t-inputbox-wrap";
            if (disabled)
                className += " t-state-disabled";
            else if (ErrorMessage.HasValue())
                className += " t-state-error";

            <div @ref="element" class="t-widget t-datepicker" style="@Style" error-message="@ErrorMessage">
                <div class="@(className)">
                    @if (DefaultMode)
                    {
                        <input type="date" value="@text" @attributes="@attrs" disabled="@disabled" class="t-input t-default-mode" autocomplete="off" @onchange="ChangeValue" />
                    }
                    else
                    {
                        <input @attributes="@attrs" disabled="@disabled" value="@text" @ref="InputElement" class="t-input" autocomplete="off" @onchange="ChangeValue" />
                        <span class="t-select" style="left:inherit" @onclick="OpenWindow">
                            <i class="t-icon t-icon-calendar fa fa-calendar" title="Calendar"></i>
                        </span>
                    }
                </div>
                @if (Status == WindowStatus.Open && !DefaultMode)
                {
                    DateTime date = DateTime.Today;
                    if (Value != null && !Value.Equals(default(TValue)))
                    {
                        if (typeof(TValue).GetUnderlyingType() == typeof(DateOnly))
                            date = ((DateOnly)Convert.ChangeType(Value, typeof(DateOnly))).ToDateTime(new TimeOnly());
                        else
                            date = Convert.ToDateTime(Value);
                    }
                    <div class="t-animation-container">
                        <CalendarComponent PersianCalendar="PersianCalendar" Date="date" DateChanged="async d => await ChangeDate(d)"
                                           FromDate="FromDate" ToDate="ToDate" />
                    </div>
                }
            </div>
        };
    }
}
