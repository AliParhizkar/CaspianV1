@namespace Caspian.UI
@inject CaspianDataService DataService

@if (ColSpan.HasValue)
{
    @if (TotalSpan != ColSpan)
    {
        <div class="col-md-@(TotalSpan - ColSpan)"></div>
    }
    <div class="text-center col-md-@(ColSpan)">
        @RenderButtons()
    </div>
}
else
{
    @RenderButtons()
}

@code 
{
    RenderFragment RenderButtons()
    {
        return __builder =>
        {
            <div class="@($"c-window-action {CssClass}")">
                <button class="c-btn c-primary" type="submit">@SubmitButtonTitle</button>
                <button class="c-btn c-danger" type="button" @onclick="CloseWindow">@CancelButtonTitle</button>
            </div>
        };
    }

    protected override void OnInitialized()
    {
        if (DataService.Language == Language.Fa)
        {
            SubmitButtonTitle = "ثبت";
            CancelButtonTitle = "انصراف";
        }
        else
        {
            SubmitButtonTitle = "Save";
            CancelButtonTitle = "Cancel";
        }
        base.OnInitialized();
    }

    protected void CloseWindow()
    {
        Window.Close();
    }

    [Parameter]
    public string CssClass { get; set; }

    [Parameter]
    public int? ColSpan { get; set; }

    [Parameter]
    public int? TotalSpan { get; set; } = 12;

    [CascadingParameter(Name = "ParentWindow")]
    public IWindow Window { get; set; }


    [Parameter]
    public string SubmitButtonTitle { get; set; }

    [Parameter]
    public string CancelButtonTitle { get; set; }
}
