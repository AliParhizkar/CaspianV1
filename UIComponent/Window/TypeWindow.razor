@namespace Caspian.UI
@typeparam TEntity where TEntity : class
@inject IServiceScopeFactory ScopeFactory

<Window @bind-Status="status" @attributes="windowProperties" >
    <CaspianForm @ref="form" TEntity="TEntity" Model="entity" OnSubmit="UpdateEntity">
        <CaspianValidationValidator TModel="TEntity" ValidatorType="serviceType" />
        @Content(newEntity)
   </CaspianForm>
</Window>

