@namespace Caspian.UI
@typeparam TEntity where TEntity : class
@inject IServiceScopeFactory ScopeFactory

<Window @bind-Status="status" @attributes="windowProperties" >
    <CaspianForm @ref="form" TEntity="TEntity" Model="newEntity" ColumnsCount="ColumnsCount" OnSubmit="OnSubmit">
        <CaspianValidationValidator TModel="TEntity" ValidatorType="serviceType" Source="source" />
        @ChildContent(newEntity)
   </CaspianForm>
</Window>