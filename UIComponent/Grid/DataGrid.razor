@namespace Caspian.UI
@using Microsoft.AspNetCore.Components.Rendering
@typeparam TEntity where TEntity: class
@inherits DataView<TEntity>
@attribute [CascadingTypeParameter(nameof(TEntity))]

@{
    var style = "";
    if (ContentHeight.HasValue)
        style = $"height:{ContentHeight}px";
    else if (Inline)
        style = $"height:200px";
    var className = "t-grid-content";
    if (Inline)
        className += " t-inline-content";
}    

<CascadingValue Value="this" Name="DataView">
    @if (columnsData == null)
    {
        columnsData = new List<ColumnData>();
        @Columns(null)
    }
    else
    {
        <div @ref="mainDiv" class="t-widget t-grid">
            @if (!Inline)
            {
                if (ToolsBar == null)
                {
                    <DataToolsBar TEntity="TEntity" ShowInsertIcon="(ShowInsertIcon ?? showInsertIcon) == true" DisableInsertIcon="disableInsertIcon" 
                    OnInsertButoonClicked="CreateInsert" />
                }
                else
                    @ToolsBar
            }

            <GridHeader TableWidth="TableWidth" ColumnsData="columnsData" OnOrderingChanged="async () =>
                                                {
                                                    await ChangePageNumber(pageNumber);
                                                }" />

            <div class="@className" style="@(style)">
                @if (Inline && !AutoHide)
                {
                    CreateInsertSection(__builder2);
                }
                @if (items != null)
                {
                    <table @attributes="tableAttrs" class="c-grid-items">
                        <tbody>
                            @{
                                int index = 0;
                                var pKey = typeof(TEntity).GetPrimaryKey();
                                object selectId = selectedEntity != null ? pKey.GetValue(selectedEntity) : null;
                                foreach (var item in items)
                                {
                                    var id = Convert.ToInt32(pKey.GetValue(item));
                                    var attrs = new Dictionary<string, object>();
                                    var rowIndex = index;
                                    var className = "";
                                    if (SelectType == SelectType.Single)
                                    {
                                        if (rowIndex == SelectedRowIndex)
                                            className = "t-state-selected";
                                    }
                                    if (SelectType == SelectType.Multi && selectedIds.Contains(id))
                                        className = "t-state-selected";
                                    if (item == selectedEntity)
                                        className += " t-upsert-inline";
                                    if (className.HasValue())
                                        attrs.Add("class", className);
                                    if (SelectType != SelectType.None)
                                    {
                                        attrs.Add("onmousedown", EventCallback.Factory.Create<MouseEventArgs>(this, async (e) =>
                                        {
                                            SelectRow(rowIndex);
                                            if (SelectType == SelectType.Multi)
                                            {
                                                if (selectedIds.Contains(id))
                                                    selectedIds.Remove(id);
                                                else
                                                    selectedIds.Add(id);
                                            }
                                            if (OnRowSelect.HasDelegate)
                                                await OnRowSelect.InvokeAsync(item);
                                            if (OnInternalRowSelect.HasDelegate)
                                                await OnInternalRowSelect.InvokeAsync(id);
                                            await SetStateGridData();

                                        }));
                                    }
                                    index++;
                                    var isUpdateing = selectId != null && selectId.Equals(id);
                                    var rowData = new RowData<TEntity>()
                                    {
                                        Data = isUpdateing ? selectedEntity : item,
                                        RowIndex = rowIndex + 5,
                                        DynamicData = DynamicData == null ? null : DynamicData[rowIndex],
                                        UpsertMode = isUpdateing ? UpsertMode.Edit : null
                                    };
                                    <tr @attributes="attrs">
                                        <CascadingValue Name="RowData" Value="rowData">
                                            @if (isUpdateing)
                                            {
                                                <CascadingValue Value="EditContext">
                                                    <CaspianValidationValidator TModel="TEntity" @ref="validator" DetailsService="DetailsService" Source="source" ValidatorType="serviceType" />
                                                    <CaspianContainer ColumnsCount="0" @ref="updateContainer">
                                                        @Columns(rowData)
                                                    </CaspianContainer>
                                                </CascadingValue>
                                            }
                                            else
                                            {
                                                @Columns(rowData)
                                            }
                                        </CascadingValue>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    if (Inline && AutoHide)
                    {
                        var buttonClassName = "t-grid-inline-insert";
                        if (insertedEntity?.UpsertMode != null)
                        {
                            CreateInsertSection(__builder2);
                            buttonClassName += " c-hidden";
                        }
                        <button disabled="@disableInsertIcon" @ref="inertButton" type="button" class="@buttonClassName" @onclick="CreateInsert">
                            <span class="fa fa-plus"></span>
                        </button>

                }
            }
            else
            {
                <span class="t-loading"></span>
            }
        </div>
        @if (HideFooter != true)
        {
            <DataPager HidePageSize="HidePageSize" PageSize="PageSize" PageNumber="pageNumber" TotalRecord="Total" PageSizeChanged="ChangePageSize"
                        PageNumberChanged="ChangePageNumber" />
        }
    </div>
    }
</CascadingValue>

@code 
{
    void CreateInsertSection(RenderTreeBuilder __builder)
    {
        <table @attributes="tableAttrs" class="c-grid-insert">
            <tbody>
                <tr>
                    @if (selectedEntity == null)
                    {
                        <CaspianContainer ColumnsCount="0" @ref="insertContainer">
                            <CascadingValue Value="InsertContext">
                                <CaspianValidationValidator Source="source" TModel="TEntity" ValidatorType="serviceType" DetailsService="DetailsService" />
                                <CascadingValue Value="insertedEntity" Name="RowData">
                                    @Columns(insertedEntity)
                                </CascadingValue>
                            </CascadingValue>
                        </CaspianContainer>
                    }
                    else
                    {
                        
                        <CaspianContainer ColumnsCount="0" Disabled>
                            <CascadingValue Value="insertedEntity" Name="RowData">
                                @Columns(insertedEntity)
                            </CascadingValue>
                        </CaspianContainer>
                    }
                </tr>
            </tbody>
        </table>
    }
}