@namespace Caspian.UI
@typeparam TEntity
@{
    if (RowData == null)
        Grid.AddColumnData(this);
}
@if (RowData != null && !DataField) 
{
    <td @attributes="Attributes">
        @if (RowData.UpsertMode.HasValue && EditTemplate != null)
        {
            @EditTemplate
        }
        else if (Template == null && ValueTemplate == null && ChildContent == null)
        {
            if (IsCheckBox)
            {
                var temp = value == null ? (bool?)(null) : Convert.ToBoolean(value);
                <CheckBox Value="temp" Disabled DefaultLayout="DefaultLayout.Center" />
            }
            else
            {
                @value
            }
        }
        else
        {
            if (Template != null )
            {
                @Template
            }
            else if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @ValueTemplate(value)
            }
        }
    </td>
}

