@namespace Caspian.UI
@implements IDisposable
@inject IJSRuntime jsRuntime
@inject FormAppState FormAppState
@inject IServiceProvider provider
@typeparam TEntity
@{
    var serviceType = GetServiceType();
}
@if (EditContext != null)
{
    <EditForm style="@Style" EditContext="EditContext" 
              OnSubmit="@(async context => await OnFormSubmitHandler(context))"
              @onreset="@(async (e) =>
                      {
                          await ResetFormAsync();
                          if (OnInternalReset.HasDelegate)
                              await OnInternalReset.InvokeAsync();
                      })">
        <CascadingValue Value="this" Name="ParentForm">
            @if (serviceType != null)
            {
                <CaspianValidationValidator TModel="TEntity" ValidatorType="serviceType" />
            }
            <div class="row c-controls">
                @RenderContent()
            </div>
        </CascadingValue>
    </EditForm>
}
@code
{
    RenderFragment RenderContent()
    {
        return __builder =>
        {
            @if (Content != null)
            {
                @Content(EditContext.Model as TEntity)
            }
            else
            {
                @ChildContent(EditContext.Model as TEntity)
            }
        };
    }
}