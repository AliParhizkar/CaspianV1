@namespace Caspian.Engine
@typeparam TValue
@inherits LookupWindow<User, TValue>
<div class="c-lookup-page" style="width:650px;">
    <EntitySearch Service="Service" ColumnsCount="2">
        <div class="row mb-2 p-1" style="border: 1px solid #d2d2d2; border-radius: 8px;">
            <StringTextBox @bind-Value="context.FName" ColSpan="4" />
            <StringTextBox @bind-Value="context.LName" ColSpan="4" />
            <StringTextBox @bind-Value="context.UserName" ColSpan="4" />
            <StringTextBox @bind-Value="context.MobileNumber" ColSpan="4" />
        </div>
    </EntitySearch>
    <DataGrid Service="Service" TEntity="User" ContentHeight="230">
        <Columns Context="customer">
            <GridColumn Field="t => t.FName" />
            <GridColumn Field='t => t.LName' />
            <GridColumn Field="t => t.UserName" />
            <GridColumn Field="t => t.MobileNumber" />
        </Columns>
    </DataGrid>
</div>

@code
{
    protected override void OnInitialized()
    {
        InitialSearchExpression(t => LookupStringSearchValue == null || t.FName.Contains(LookupStringSearchValue) || t.LName.Contains(LookupStringSearchValue) || t.MobileNumber.Contains(LookupStringSearchValue));
        base.OnInitialized();
    }
}
