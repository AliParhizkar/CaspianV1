@namespace Caspian.Engine.UserManagement
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div class="row">
    <div class="col-md-5">
        <EntitySearch TEntity="User" Service="Service">
            <StringTextBox @bind-Value="context.LName" ColSpan="8" Title="نام خانوادگی" />
            <StringTextBox @bind-Value="context.UserName" ColSpan="8" Title="نام کاربری" />
        </EntitySearch>
        <div class="col-md-12 text-center">
            <hr class="mb-0" />
            <span class="d-membership">Other users</span>
        </div>
        <DataGrid Service="Service" TEntity="User" ContentHeight="335">
            <Columns>
                <GridColumn Field="@(t => t.FName + " " + t.LName )" Title="User" />
                <GridColumn Field="t => t.UserName" style="width:100px" />
                <GridColumn Field="t => t.MobileNumber" style="width:100px" />
            </Columns>
        </DataGrid>
    </div>
    <div class="col-md-1">
        <div class="row align-content-center h-100">
            <CaspianForm Service="Service">
                <div class="d-btn-container">
                    <IconButton IconType="IconType.AngleRight" />
                    <div>
                        <IconButton type="button" @onclick="async () => await Service.RemoveAsync()"
                        IconType="IconType.AngleLeft" />
                    </div>
                </div>
            </CaspianForm>
        </div>
    </div>
    <div class="col-md-6">
        <EntitySearch TEntity="UserMembership" Service="Service">
            <StringTextBox @bind-Value="context.User.LName" ColSpan="8" Title="نام خانوادگی" />
            <StringTextBox @bind-Value="context.User.UserName" ColSpan="8" Title="نام کاربری"/>
        </EntitySearch>
        <div class="col-md-12 text-center">
            <hr class="mb-0" />
            <span class="d-membership">Member users</span>
        </div>
        <DataGrid Service="Service" TEntity="UserMembership" ContentHeight="335">
            <Columns>
                <GridColumn Field="@(t => t.User.FName + " " + t.User.LName)" Title="User" />
                <GridColumn Field="t => t.User.UserName" style="width:100px" />
                <GridColumn Field="t => t.User.MobileNumber" style="width:100px" />
                <GridCommandColumns HideEdit />
            </Columns>
        </DataGrid>
    </div>

</div>

@code
{
    MembershipService<Role, UserMembership, User> Service;

    protected override void OnInitialized()
    {
        Service = new MembershipService<Role, UserMembership, User>(ServiceProvider);
        Service.MasterId = RoleId;
        base.OnInitialized();
    }

    [Parameter]
    public int RoleId { get; set; }
}
