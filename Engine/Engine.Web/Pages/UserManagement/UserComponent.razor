@namespace Caspian.Engine.UserManagement

@using Microsoft.AspNetCore.Identity

@inherits BasePage

@inject IServiceScopeFactory ServiceScopeFactory
@inject UserManager<User> UserManager
@inject IUserStore<User> UserStore
@inject IUIService<User> Service

@{
    base.BuildRenderTree(__builder);
}
<EntitySearch Service="Service" ColumnsCount="2">
    <StringTextBox @bind-Value="context.LName" ColSpan="4" />
    <StringTextBox @bind-Value="context.UserName" ColSpan="4" />
</EntitySearch>

<DataGrid Service="Service" TEntity="User" ContentHeight="400">
    <Columns>
        <GridColumn Field="t => t.FName" />
        <GridColumn Field="t => t.LName" />
        <GridColumn Field="t => t.UserName" />
        <GridColumn Field="t => t.Email" />
        <GridColumn Field="t => t.MobileNumber" />
        <GridColumn Title="Menus" style="width:80px">
            <Template>
                <IconButton Href='@($"/{SubSystemKind.ToString()}/UserManagement/UserAccess/{context.Data.Id}")' IconType="IconType.WpfForms" />
            </Template>
        </GridColumn>
        <GridCommandColumns />
    </Columns>
</DataGrid>

<Window Service="Service" Title="User properties" Style="max-width:500px;" OnOpen="() => confirmPassword = string.Empty">
    <CaspianForm TEntity="User" Service="Service" OnSubmit="SetPasswordForUpdate" OnValidSubmit="RegisterUser">
        <StringTextBox @bind-Value="context.FName" ColSpan="9" />
        <StringTextBox @bind-Value="context.LName" ColSpan="9" />
        <StringTextBox @bind-Value="context.UserName" Disabled="context.Id > 0" ColSpan="9" />
        @if (context.Id == 0)
        {
            <StringTextBox @bind-Value="context.Password" type="password" ColSpan="9" />
            <StringTextBox @bind-Value="confirmPassword" type="password" ColSpan="9" />
        }
        <StringTextBox @bind-Value="context.Email" ColSpan="9" />
        <StringTextBox @bind-Value="context.MobileNumber" ColSpan="9" />
        <div class="col-md-8 text">
            <FormCommandButton />
        </div>
    </CaspianForm>
</Window>
@code
{
    string confirmPassword;
    IEnumerable<Microsoft.AspNetCore.Identity.IdentityError> identityErrors;
    string Message => identityErrors is null 
                  ? null
                  : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    [Parameter]
    public SubsystemKind? SubSystemKind { get; set; }

    protected override void OnParametersSet()
    {
        if (SubSystemKind == null)
            throw new CaspianException("خطا: SubSystemKind must initialized");
        base.OnParametersSet();
    }


    void OnUpsert(FormData<User> formData)
    {
        formData.Cancel = true;
    }

    async Task<bool> RegisterUser(User user)
    {
        if (confirmPassword != user.Password)
        {
            ShowMessage("Password and Confirm password is not equal");
            StateHasChanged();
            return await Task.FromResult(false);
        }

        await UserStore.SetUserNameAsync(user, user.UserName, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, user.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return await Task.FromResult(false);
        }

        await Service.CloseWindow();

        return await Task.FromResult(true);
    }

    async Task SetPasswordForUpdate(CancelableEvent<User> e)
    {
        var user = e.Entity;
        if (user.Id > 0)
        {
            using var service = CreateScope().GetService<UserService>();
            var old = await service.SingleAsync(user.Id);
            user.UserName = old.UserName;
            ///In update password should be and in service not changed
            user.Password = null;
        }
    }
}
