@namespace Caspian.Engine.UserManagement
@inherits BasePage
@inject IUIService<Role> Service
@{
    base.BuildRenderTree(__builder);
}
<EntitySearch Service="Service">
    <StringTextBox @bind-Value="context.Name" ColSpan="8" />
</EntitySearch>
<DataGrid TEntity="Role" Service="Service" ContentHeight="400">
    <Columns>
        <GridColumn Field="t => t.Name" />
        <GridColumn Title="Members" style="width:80px">
            <Template>
                <IconButton Href='@($"/{SubSystemKind.ToString()}/UserManagement/UserMembership/{context.Data.Id}")' IconType="IconType.WpfForms" />
            </Template>
        </GridColumn>
        <GridColumn Title="Menus" style="width:80px">
            <Template>
                <IconButton Href='@($"/{SubSystemKind.ToString()}/UserManagement/RoleAccess/{context.Data.Id}")' IconType="IconType.WpfForms" />
            </Template>
        </GridColumn>
        <GridCommandColumns />
    </Columns>
</DataGrid>
<Window Service="Service" Title="Role properties" Style="width:400px">
    <CaspianForm Service="Service">
        <StringTextBox @bind-Value="context.Name" ColSpan="9" />
        <div class="col-md-9">
            <FormCommandButton />
        </div>
    </CaspianForm>
</Window>

@code
{
    protected override void OnParametersSet()
    {
        if (SubSystemKind == null)
            throw new CaspianException("Error: SubSystemKind must initialized");
        base.OnParametersSet();
    }

    [Parameter]
    public SubsystemKind? SubSystemKind { get; set; }
}
