@namespace Caspian.Engine.ReportGenerator
@inherits BasePage
@inject IUIService<Report> Service
@inject IJSRuntime runTime
@inject IHostEnvironment Host
@{
    base.BuildRenderTree(__builder);
    string reportUrl = Host.IsProduction() ? "https://report.caspiansoftco.com/" : "https://localhost:7284/";
}
<div style="background-color:white" class="p-4 pt-2">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        <ComboBox TEntity="ReportGroup" TValue="int" @bind-Value="context.ReportGroupId" TextExpression="t => t.Title"
                  ConditionExpression="t => t.SubSystem == Subsystem" ColSpan="4" />
    </EntitySearch>
    <DataGrid TEntity="Report" ConditionExpr="t => t.ReportGroup.SubSystem == Subsystem" Service="Service" ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.ReportGroup.Title" Title="Report group" />
            <GridColumn Field="t => t.ReportType.EnumText()" />
            <GridColumn Field="t => t.Title" />
            <GridColumn Title="Parameters" style="width:80px">
                <Template>
                    <IconButton Href='@($"{Subsystem}/ReportEngine/ReportParam/{context.Data.Id}")' IconType="IconType.Wpforms" />
                </Template>
            </GridColumn>
            <GridColumn Title="Report" style="width:80px">
                <Template>
                    <a target="_blank" href="@(reportUrl + context.Data.Id)">...</a>
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Style="width:450px" Title="Report" Service="Service">
    <CaspianForm Service="Service">
        <ComboBox TEntity="ReportGroup" TValue="int" @bind-Value="context.ReportGroupId" TextExpression="t => t.Title"
                  ConditionExpression="t => t.SubSystem == Subsystem" ColSpan="8" />
        <DropdownList @bind-Value="context.ReportType" ColSpan="8" />
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
        <StringTextBox @bind-Value="context.Descript" MultiLine Rows="3" ColSpan="8" />
        <div class="col-md-8">
            <WindowCommandButtons />
        </div>
    </CaspianForm>
</Window>

@code
{
    [Parameter]
    public SubSystemKind Subsystem { get; set; }
}
