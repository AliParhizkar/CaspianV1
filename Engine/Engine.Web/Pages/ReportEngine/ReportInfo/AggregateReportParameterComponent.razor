@namespace Caspian.Engine.ReportGenerator
@inherits BasePage
@if (report != null)
{
    <div class="e-head">
        <div class="col-md-1 text-center">
            <a href="@(report.ReportGroup.SubSystem)/ReportEngine/Report">
                <span class="fa fa-arrow-left"></span>
            </a>
        </div>
        <div class="col-md-5 text-center">
            <label>Group Title</label>
            <span class="group-title">@(report.ReportGroup.Title)</span>
        </div>
        <div class="col-md-5 text-center">
            <label>Report Title</label>
            <span class="group-title">@(report.Title)</span>
        </div>
        <div class="col-md-1 text-center">
            <button @onclick="async () => await SaveParameters()" class="c-btn c-primary">Save</button>
        </div>
    </div>
}

<TreeView @ref="tree" style="height:calc(100% - 47px)" TEntity="NodeView" Source="source" OnChange="NodeChanged">
    <BeforeNodeTemplate Context="node">
        @if (IsIdentityNode(node))
        {
            <span class="fa fa-key"></span>
        }
    </BeforeNodeTemplate>
</TreeView>

