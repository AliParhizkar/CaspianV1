@namespace Caspian.Engine.ReportGenerator
@inherits BasePage
@if (report?.ReportType == ReportType.Aggregate)
{
    <AggregateReportParameterComponent ReportId="ReportId"  />
}
else
{
    <SimpleReportParamComponent ReportId="ReportId" />
}

@code 
{

    Report report;
    protected override async Task OnParametersSetAsync()
    {
        using var service = CreateScope().GetService<ReportService>();
        report = await service.SingleAsync(ReportId);
        await base.OnParametersSetAsync();
    }

    [Parameter]
    public int ReportId { get; set; }
}
