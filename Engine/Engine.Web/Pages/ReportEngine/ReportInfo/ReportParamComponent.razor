@namespace Caspian.Engine.ReportGenerator
@inherits BasePage
@if (report?.ReportType == ReportType.Aggregate)
{
    <TreeView style="max-width:400px;height:100%;padding:5px 10px 0 0" TEntity="NodeView" Source="nodes" />
}
else
{
    <SimpleReportParamComponent ReportId="ReportId" />
}

@code 
{
    IList<NodeView> nodes;

    Report report;
    protected override async Task OnParametersSetAsync()
    {
        using var service = CreateScope().GetService<ReportService>();
        report = await service.GetAll().Include(t => t.ReportGroup).SingleAsync(ReportId);
        if (report.ReportType == ReportType.Aggregate)
        {
            var type = new AssemblyInfo().GetReturnType(report.ReportGroup);
            nodes = new ReportTree().CreateNodesForGroupBySelect(type);
        }
        await base.OnParametersSetAsync();
    }

    [Parameter]
    public int ReportId { get; set; }
}
