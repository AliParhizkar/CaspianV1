@namespace Caspian.Engine.ReportGenerator
@inherits BasePage
@if (report != null)
{
    var className = report.ReportType == ReportType.Simple ? "" : "multi-columns";
    <div class="e-head">
        <div class="col-md-4">
            <a href="@(report.ReportGroup.SubSystem)/ReportEngine/Report">
                <span class="fa fa-arrow-left"></span>
            </a>
            <label>Group Title</label>
            <span class="group-title">@(report.ReportGroup.Title)</span>
        </div>
        <div class="col-md-3">
            <label>Report Type</label>
            <span class="group-title">@(report.ReportType.EnumText())</span>
        </div>        
        <div class="col-md-4">
            <label>Report Title</label>
            <span class="group-title">@(report.Title)</span>
        </div>
        <div class="col-md-1 text-center">
            <button class="c-btn c-primary" disabled="@(selectedParameters.Count == 0)" @onclick="async () => await form.SubmitAsync()">Save</button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-5">
            <div class="params-title">Group Parameters</div>
            <CheckedListbox TEntity="ReportGroupParameter" TDetails="int" Values="selectedParameters" TextExpression="t => t.Alias" 
                            OnChange="OnChange" ConditionExpression="t => t.ReportGroupId == report.ReportGroupId && !t.IsKey" Filterable Style="height:calc(100% - 2px)" />
        </div>
        <div class="col-md-7 ps-3">
            <div class="params-title">Report Parameters</div>
            <CaspianForm @ref="form" Model="report" TEntity="Report" OnValidSubmit="SaveData" Style="height:calc(100% - 12px)">
                <div class="params-body">
                    <div class="engin-main">
                        <div class="c-alise-head @(className)">
                            <div class="c-field-name">عنوان فیلد گزارش</div>
                            @if (report.ReportType != ReportType.Simple)
                            {
                                <div class="c-field-level">سطح گزارش</div>
                            }
                        </div>
                    </div>
                    <div class="engine-body @(className)">
                        @if (selectedParameters.Count == 0)
                        {
                            <div class="no-content">هیچ فیلدی انتخاب نشده است</div>
                        }
                        else
                        {
                            for (var i = 0; i < report.ReportParams.Count; i++)
                            {
                                var index = i;
                                if (!report.ReportParams[index].ReportGroupParameter.IsKey)
                                {
                                    <div class="c-field-name">
                                        @(report.ReportParams[index].ReportGroupParameter.Alias)
                                    </div>
                                    @if (report.ReportType != ReportType.Simple)
                                    {
                                        var maxDataLevel = MaxdataLevel(report.ReportParams[index].ReportGroupParameter.TitleEn);
                                        <div class="c-field-level">
                                            <DropdownList @bind-Value="report.ReportParams[index].DataLevel" Disabled="maxDataLevel == 1" Source="dataLevels" FilterFunc="t => t <= maxDataLevel" />
                                        </div>
                                    }
                                }
                            }
                        }
                    </div>
                </div>
            </CaspianForm>
        </div>
    </div>
}

