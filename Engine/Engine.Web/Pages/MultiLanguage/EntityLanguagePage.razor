@page "/Engine/EntityLanguage"
@inject IHostEnvironment Host
@inherits BasePage
@using System.Text.Json
@using System.Globalization
<div class="row">
    <div class="col-md-4">
        <div class="row l-entities">
            @if (entities != null)
            {
                var data = GetEntityLangDatas();
                foreach (var item in entities)
                {
                    var className = data.Any(t => t.TypeName == item.Value) ? "fa fa-check" : "fa fa-close";
                    <div class="col-md-9">@item.Text</div>
                    <div class="col-md-3 text-center">
                        <span class="@className"></span>
                    </div>
                }
            }

        </div>
    </div>
    <div class="col-md-6 row c-controls">
        <DropdownList @bind-Value="systemKind" OnChange="FillEntities" ColSpan="8" Title="Subsystem name" TotalSpan="12" />
        <ComboBox Disabled="systemKind == null" @bind-Value="entityName" TValue="string" Source="entities" TEntity="SelectListItem" TextExpression="t => t.Text"
                  OnChange="FillLangData" ColSpan="8" TotalSpan="12" Title="Entity name" />
        <div class="a-head row p-3 pb-1 text-center">
            <div class="col-md-4">Property name</div>
            <div class="col-md-4">Display name</div>
            <div class="col-md-4">Title</div>
        </div>
        <div class="a-body row p-3">
            @if (entityLangDatas != null)
            {
                foreach (var item in entityLangDatas)
                {
                    var displayName = entityType.GetProperty(item.MemberName).GetCustomAttribute<DisplayNameAttribute>().DisplayName;
                    <div class="col-md-4">@item.MemberName</div>
                    <div class="col-md-4">@displayName</div>
                    <div class="col-md-4">
                        <StringTextBox @bind-Value="item.Title" />
                    </div>
                }
            }
        </div>
        <button disabled="@(entityLangDatas == null)" @onclick="SaveData" class="c-btn c-primary">Save</button>
    </div>
</div>

