@namespace Caspian.Engine.WorkflowEngine
@inherits BasePage
@inject IUIService<DynamicParameterOption> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <DataGrid Service="Service" TEntity="DynamicParameterOption" ConditionExpr="t => t.DynamicParameterId == ParameterId">
        <Columns Context="con">
            <GridColumn Field="t => t.FaTitle" />
            <GridColumn Field="t => t.EnTitle" />
            <GridColumn Field="t => t.Value" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="مقادیر پارامتر" Style="width:450px" OnOpen="async () => await OpenForm()">
    <CaspianForm Service="Service">
        <div class="row c-controls ps-4 pe-4">
            <div class="col-md-4">
                <label>عنوان فارسی </label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.FaTitle" />
            </div>
            <div class="col-md-4">
                <label>عنوان لاتین </label>
            </div>
            <div class="col-md-8">
                <StringTextBox Style="direction:ltr" @bind-Value="Service.UpsertData.EnTitle" />
            </div>
            <div class="col-md-4">
                <label>مقدار</label>
            </div>
            <div class="col-md-8">
                <NumericTextBox Disabled Value="Service.UpsertData.Value" />
            </div>
            <div class="col-md-4"></div>
            <div class="col-md-8">
                <FormCommandButton />
            </div>
        </div>
    </CaspianForm>
</Window>


@code
{
    async Task OpenForm()
    {
        Service.UpsertData.DynamicParameterId = ParameterId;
        if (Service.UpsertData.Id == 0)
        {
            using var scope = CreateScope();
            var service = new DynamicParameterOptionService(scope.ServiceProvider);
            Service.UpsertData.Value = (await service.GetAll().Where(t => t.DynamicParameterId == ParameterId).MaxAsync(t => (long?)t.Value)).GetValueOrDefault() + 1;
        }
    }

    [Parameter]
    public int ParameterId { get; set; }
}