@namespace Caspian.Engine.WorkFlow
@inherits BasePage
@inject UIService<WorkflowForm> Service
@{ 
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <div class="row c-controls ps-4 pe-4">
        <div class="col-md-4">
            <label>Title</label>
        </div>
        <div class="col-md-8">
            <StringTextBox @bind-Value="Service.Search.Title" />
        </div>
    </div>
    <DataGrid Service="Service" TEntity="WorkflowForm" ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.DataModel.Title" Title="Data model" />
            <GridColumn Field="t => t.Title" Title="Title" />
            <GridColumn Field="t => t.ColumnCount" Title="Columns count" style="width:110px" />
            <GridColumn Field="t => t.Name" Title="Name" />
            <GridColumn Title="Form generator" style="width:120px;">
                <Template>
                    <a href="/Engine/FormGenerator/@(context.Data.Id)" target="_blank">...</a>
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>

</div>

<Window Service="Service" Title="Form " Style="width:500px" OnOpen="FormOpen">
    <CaspianForm Service="Service">
        <div class="row reportSelect ps-2 pe-2 c-controls">
            <div class="col-md-4">
                <label>Data model</label>
            </div>
            <div class="col-md-8">
                <ComboBox TEntity="DataModel" TValue="int" @bind-Value="Service.UpsertData.DataModelId"
                          TextExpression="t => t.Title" />
            </div>
            <div class="col-md-4">
                <label>Title</label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.Title" />
            </div>
            <div class="col-md-4">
                <label>Column count</label>
            </div>
            <div class="col-md-8">
                <NumericTextBox @bind-Value="Service.UpsertData.ColumnCount" />
            </div>
            <div class="col-md-4">
                <label>Name</label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.Name" Style="text-align:left" />
            </div>
            <div class="col-md-4">
            </div>
            <div class="col-md-8">
                <FormCommandButton />
            </div>
        </div>
    </CaspianForm>
</Window>


@code
{
    [Parameter]
    public int GroupId { get; set; }

    void FormOpen()
    {
        Service.UpsertData.WorkflowGroupId = GroupId;
    }
}
