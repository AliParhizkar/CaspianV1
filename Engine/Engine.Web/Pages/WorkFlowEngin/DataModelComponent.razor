@namespace Caspian.Engine.WorkFlow
@inherits BasePage
@inject UIService<DataModel> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <div class="row c-controls ps-4 pe-4">
        <div class="col-md-2">
            <label>Title</label>
        </div>
        <div class="col-md-4 pe-3">
            <StringTextBox @bind-Value="Service.Search.Title" />
        </div>
        <div class="col-md-2 ps-3">
            <label>Name</label>
        </div>
        <div class="col-md-4">
            <StringTextBox @bind-Value="Service.Search.Name" />
        </div>
    </div>
    <DataGrid Service="Service" TEntity="DataModel" ContentHeight="300" ConditionExpr="t => t.WorkflowGroupId == GroupId">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.Name" />
            <GridColumn Title="Print version" style="width:100px">
                <Template>
                    <a target="_blank" href="/WorkflowEngine/PrintVerson/@(context.Data.Id)">
                        ...
                    </a>
                </Template>
            </GridColumn>
            <GridColumn Title="Fields" style="width:100px">
                <Template>
                    <IconButton Href='@($"/{SubSystem.ToString()}/WorkflowEngine/DataModelField/{context.Data.Id}")' IconType="IconType.Wpforms" />
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="Data model" Style="width:500px" OnOpen="() => Service.UpsertData.WorkflowGroupId = GroupId">
    <CaspianForm Service="Service">
        <div class="ps-4 pe-4 row c-controls">
            <div class="col-md-4">
                <label>Name</label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.Name" Style="direction:ltr" />
            </div>
            <div class="col-md-4">
                <label>Title</label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.Title" />
            </div>
            <div class="col-md-4">
                <label>Description</label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.Description" MultiLine Rows="3" />
            </div>
            <div class="col-md-4">
            </div>
            <div class="col-md-8">
                <FormCommandButton />
            </div>
        </div>
    </CaspianForm>
</Window>


@code
{
    [Parameter]
    public int GroupId { get; set; }

    [Parameter]
    public SubSystemKind SubSystem { get; set; }
}

