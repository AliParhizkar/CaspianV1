@namespace Caspian.Engine.WorkFlow
@inherits BasePage
@inject IUIService<DataModel> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
    </EntitySearch>
    <DataGrid Service="Service" TEntity="DataModel" ContentHeight="300" ConditionExpr="t => t.WorkflowGroupId == GroupId">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.Name" />
            <GridColumn Title="Print version" style="width:100px">
                <Template>
                    <a target="_blank" href="/WorkflowEngine/PrintVerson/@(context.Data.Id)">
                        ...
                    </a>
                </Template>
            </GridColumn>
            <GridColumn Title="Fields" style="width:100px">
                <Template>
                    <IconButton Href='@($"/{SubSystem.ToString()}/WorkflowEngine/DataModelField/{context.Data.Id}")' IconType="IconType.Wpforms" />
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="Data model" Style="width:500px">
    <CaspianForm Service="Service" TEntity="DataModel" OnSubmit="t => t.Entity.WorkflowGroupId = GroupId">
        <StringTextBox @bind-Value="context.Name" Style="direction:ltr" ColSpan="8" />
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
        <StringTextBox @bind-Value="context.Description" MultiLine Rows="3" ColSpan="8" />
        <div class="col-md-8">
            <FormCommandButton />
        </div>
    </CaspianForm>
</Window>


@code
{
    [Parameter]
    public int GroupId { get; set; }

    [Parameter]
    public SubSystemKind SubSystem { get; set; }
}

