@namespace Caspian.Engine.WorkFlow
@inject UIService<WorkflowGroup> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="9" />
    </EntitySearch>
    <DataGrid Service="Service" TEntity="WorkflowGroup" ContentHeight="250" ConditionExpr="t => t.SubSystemKind == Subsystem">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Title="Data model" style="width:90px">
                <Template>
                    <IconButton Href='@($"/{Subsystem.ToString()}/WorkflowEngine/DataModel/{context.Data.Id}")' IconType="IconType.Wpforms" />
                </Template>
            </GridColumn>
            <GridColumn Title="Form" style="width:90px">
                <Template>
                    <IconButton Href='@($"/{Subsystem.ToString()}/WorkflowEngine/WorkflowForm/{context.Data.Id}")' IconType="IconType.Wpforms" />
                </Template>
            </GridColumn>
            <GridColumn Title="Workflow" style="width:90px">
                <Template>
                    <IconButton Href='@($"/{Subsystem.ToString()}/WorkflowEngine/Workflow/{context.Data.Id}")' IconType="IconType.Wpforms" />
                </Template>
            </GridColumn>
            <GridColumn Title="Print" style="width:90px">
                <Template>
                    <a href="@($"/Engine/WorkflowReport/{context.Data.Id}")" target="_blank">...</a>
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>

</div>

<Window Service="Service" Title="Workflow group" Style="width:500px" OnOpen="() => Service.UpsertData.SubSystemKind = Subsystem">
    <CaspianForm Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="9" />
        <StringTextBox @bind-Value="context.Description" MultiLine Rows="3" ColSpan="9" />
        <div class="col-md-8">
            <FormCommandButton />
        </div>
    </CaspianForm>
</Window>

@code
{
    [Parameter]
    public SubSystemKind Subsystem { get; set; }
}

