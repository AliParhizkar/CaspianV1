@namespace Caspian.Engine.WorkFlow
@inherits BasePage
@inject UIService<Workflow> Service
@inject IJSRuntime runTime
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <div class="row c-controls ps-4 pe-4">
        <div class="col-md-4">
            <label>عنوان</label>
        </div>
        <div class="col-md-8">
            <StringTextBox @bind-Value="Service.Search.Title" />
        </div>
    </div>
    <DataGrid Service="Service" TEntity="Workflow" ContentHeight="300" ConditionExpr="t => t.WorkflowGroupId == GroupId">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.DataModel.Title" Title="عنوان مدل داده ای" />
            <GridColumn Field="t => t.DataModel.Name" Title="نام مدل داده ای" />
            <GridColumn Title="ایجاد گردش" style="width:80px">
                <Template>
                    <a href="/Engine/WorkflowGenerator/@(context.Data.Id)" target="_blank">...</a>
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="گردش کار" Style="width:500px">
    <CaspianForm Service="Service" OnSubmit="() => Service.UpsertData.WorkflowGroupId = GroupId">
        <div class="row ps-4 pe-4 c-controls">
            <div class="col-md-4">
                <label>مدل داده ای</label>
            </div>
            <div class="col-md-8">
                <ComboBox TEntity="DataModel" TValue="int" @bind-Value="Service.UpsertData.DataModelId"
                          TextExpression="t => t.Title" ConditionExpression="t => t.WorkflowGroupId == GroupId" />
            </div>
            <div class="col-md-4">
                <label>عنوان</label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.Title" />
            </div>
            <div class="col-md-4">
                <label>شرح</label>
            </div>
            <div class="col-md-8">
                <StringTextBox @bind-Value="Service.UpsertData.Descript" MultiLine Rows="3" />
            </div>
            <div class="col-md-4"></div>
            <div class="col-md-8">
                <FormCommandButton />
            </div>
        </div>
    </CaspianForm>
</Window>


@code
{
    [Parameter]
    public int GroupId { get; set; }
}
