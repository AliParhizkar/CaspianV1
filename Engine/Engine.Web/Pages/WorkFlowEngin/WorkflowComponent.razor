@namespace Caspian.Engine.WorkFlow
@inherits BasePage
@inject IUIService<Workflow> Service
@inject IJSRuntime runTime
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
    </EntitySearch>
    <DataGrid Service="Service" TEntity="Workflow" ContentHeight="300" ConditionExpr="t => t.WorkflowGroupId == GroupId">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.DataModel.Title" Title="عنوان مدل داده ای" />
            <GridColumn Field="t => t.DataModel.Name" Title="نام مدل داده ای" />
            <GridColumn Title="ایجاد گردش" style="width:80px">
                <Template>
                    <a href="/Engine/WorkflowGenerator/@(context.Data.Id)" target="_blank">...</a>
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="گردش کار" Style="width:500px">
    <CaspianForm Service="Service" TEntity="Workflow" OnSubmit="e => e.Entity.WorkflowGroupId = GroupId">
        <ComboBox TEntity="DataModel" TValue="int" @bind-Value="context.DataModelId" ColSpan="8"
                  TextExpression="t => t.Title" ConditionExpression="t => t.WorkflowGroupId == GroupId" />
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
        <StringTextBox @bind-Value="context.Descript" MultiLine Rows="3" ColSpan="8" />
        <div class="col-md-8 center-align">
            <FormCommandButton />
        </div>
    </CaspianForm>
</Window>


@code
{
    [Parameter]
    public int GroupId { get; set; }
}
