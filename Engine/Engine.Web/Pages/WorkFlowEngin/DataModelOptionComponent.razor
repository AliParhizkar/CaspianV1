@namespace Caspian.Engine.WorkFlow
@inject IUIService<DataModelOption> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <DataGrid Service="Service" TEntity="DataModelOption" ContentHeight="300" ConditionExpr="t => t.FieldId == FieldId">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.Name" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="Options" Style="width:500px">
    <CaspianForm TEntity="DataModelOption" Service="Service" OnSubmit="data => data.FieldId = FieldId">
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
        <StringTextBox Style="direction:ltr" @bind-Value="context.Name" ColSpan="8" />
        <div class="col-md-8">
            <FormCommandButton />
        </div>
    </CaspianForm>
</Window>
@code 
{
    [Parameter]
    public int FieldId { get; set; }
}
