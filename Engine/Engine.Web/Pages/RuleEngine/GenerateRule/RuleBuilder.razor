@using Caspian.Engine.Extension
@namespace Caspian.Engine
@typeparam TEntity
@typeparam TValue
@attribute [CascadingTypeParameter(nameof(TEntity))]
@inherits BasePage
@implements IRuleBuilder<TEntity>
@if (ChildContent != null)
{
    <CascadingValue Value="this">
        @ChildContent(default)
    </CascadingValue>
}
@{
    var isDisabled = !OperandIsActive();
}

<div style="width:95%;margin:5px auto;">
    <table style="width:100%">
        <tr>
            <td style="width:135px;">
                <OperatorComponent Tokens="tokens" OnChanged="TokenChanged" RuleId="ruleId" />
                <div class="f-operand">
                    <button  @onclick="OpenOperandForm" disabled="@isDisabled">
                        <span class="fa fa-cog"></span>
                        <span>پارامتر</span>
                    </button>
                    <div style="padding-top:15px;">
                        <button  @onclick="OpenConstantForm" disabled="@isDisabled" >
                            <span class="fa fa-cog"></span>
                            <span>ثابت</span>
                        </button>
                    </div>
                </div>
            </td>
            <td>
                <ToolsBarComponent Page="this" Tokens="tokens" RuleId="ruleId" />
                <div class="formola-content">
                    @if (tokens != null)
                    {
                        @foreach (var item in tokens)
                        {
                            var className = item.TokenType == TokenType.Oprator ? "f-operator" : "f-operand";
                            if (item.OperatorKind == OperatorType.Colon)
                            {
                                <div class="f-clear"></div>
                                @if (item.IfCount > 1)
                                {
                                    <span class="c-padd" style="width:@(3 * (item.IfCount - 1))em"></span>
                                }
                            }
                            <span class="@className">@item.FaTitle</span>
                            if (item.OperatorKind == OperatorType.QuestionMark || item.OperatorKind == OperatorType.Colon)
                            {
                                <div class="f-clear"></div>
                                @if (item.IfCount > 0)
                                {
                                    <span class="c-padd" style="width:@(3 * item.IfCount)em"></span>
                                }
                            }
                        }
                    }
                </div>
            </td>
        </tr>
    </table>
</div>

<Window @bind-Status="newStatus" Title="افزودن عملوند" Style="width:375px">
    <Content>
        @if (TokenType == TokenType.ConstValue)
        {
            <ConstValueComponent  @bind-Status="newStatus" OnAfterAdd="t => AfterParameterAdded(t, TokenType)" Type="typeof(TEntity)" Tokens="tokens"
                                 RuleId="ruleId"/>
        }
        else
        {
            <ParameterComponent  @bind-Status="newStatus" OnAfterAdd="t => AfterParameterAdded(t, TokenType)" 
                                Type="typeof(TEntity)" RuleItems="ruleItems" Tokens="tokens" RuleId="ruleId" />
        }
    </Content>
</Window>

