@namespace Caspian.Engine.RuleGenerator
@using Caspian.Common.Attributes
@inherits BasePage
@inject IUIService<Rule> Service
@{
    base.BuildRenderTree(__builder);
}
<div class="p-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
    </EntitySearch>
    <DataGrid Service="Service" TEntity="Rule" ConditionExpr="t => t.SystemKind == Subsystem"  ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.ResultType.EnumText()" Title="نوع خروجی" />
            <GridColumn Field="t => t.Priority" />
            <GridColumn Field="t => t.IsValid" Title="نهایی" />
            <GridColumn Title="ایجاد" style="width:80px">
                <Template>
                    <a href="/Engine/RuleEngine/@(context.Data.Id)" target="_blank">...</a>
                </Template>
            </GridColumn>
            <GridColumn Title="بررسی" style="width:60px">
                <Template>
                    <span class="c-btn c-primary r-check" @onclick="async () => await SetPriority(context.Data.Id)">
                        <i class="fa fa-check"></i>
                    </span>
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>

</div>

<Window Service="Service" Title="فرمول" Style="width:450px">
    <CaspianForm  Service="Service" TEntity="Rule" OnSubmit="e => e.Entity.SystemKind = Subsystem">
        @{
            var disable = context.Priority != null;
        }
        <ComboBox TEntity="SelectListItem" TValue="string" @bind-Value="context.TypeName" ColSpan="8" Disabled="disable" Source="RuleTypes" />
        <DropdownList @bind-Value="context.ResultType" Disabled="disable" ColSpan="8" />
        @if (context.ResultType == ValueTypeKind.Enum)
        {
            <DropdownList @bind-Value="context.EnumTypeName" Source="modelEnums" Disabled="disable" ColSpan="8" />
        }
        <CheckBox @bind-Value="context.FormRule" Disabled="disable" ColSpan="8" />
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
        <StringTextBox @bind-Value="context.Descript" MultiLine Rows="3" ColSpan="8" />
        <div class="col-md-8">
            <FormCommandButton />
        </div>
    </CaspianForm>
</Window>


@code
{
    IList<SelectListItem> RuleTypes;
    IList<SelectListItem> modelEnums;

    [Parameter]
    public SubsystemKind Subsystem { get; set; }

    protected override void OnInitialized()
    {
        RuleTypes = new AssemblyInfo().GetRuleTypes(Subsystem).Select(t => new SelectListItem(t.Key, t.Value)).ToList();
        modelEnums = Subsystem.GetEntityAssembly().GetTypes().Where(t => t.IsEnum).Select(t => new SelectListItem
            {
                Value = t.Name,
                Text = t.GetCustomAttribute<EnumTypeAttribute>()?.Title ?? t.Name
            }).ToList();
        base.OnInitialized();
    }

    async Task SetPriority(int ruleId)
    {
        var scope = CreateScope();
        var service = new RuleService(scope.ServiceProvider);
        var rule = await service.GetAll().Include(t => t.Tokens).Include("Tokens.DynamicParameter")
            .Include("Tokens.RuleValue").SingleAsync(ruleId);
        rule.Priority = service.CalculateRulePriority(rule);
        await service.SaveChangesAsync();
        await Service.DataView.ReloadAsync();
    }
}
