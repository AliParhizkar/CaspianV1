@namespace Caspian.Engine.SystemManagement
@inherits BasePage
@inject SingletonMenuService service
@inject IUIService<Menu> Service
<EntitySearch Service="Service" ColumnsCount="2">
    <ComboBox TEntity="MenuCategory" TValue="int?" @bind-Value="context.MenuCategoryId" ColSpan="4"
              TextExpression="t => t.Title" ConditionExpression="t => t.SubSystemKind == Subsystem" OrderByExpression="t => t.Ordering" />
    <StringTextBox @bind-Value="context.Title" ColSpan="4" />
    <CheckBox CustomeSearch @bind-Value="onlyUntitledMenus" ColSpan="2" TotalSpan="4" />
    <CheckBox CustomeSearch @bind-Value="isDropped" ColSpan="2" TotalSpan="4" />
    <CheckBox CustomeSearch @bind-Value="showInMenu" ColSpan="2" TotalSpan="4" />
    <StringTextBox Id="Test1" @bind-Value="context.Source" ColSpan="4" />
    <div class="col-md-3 text-center">
        <IconButton @onclick="async () => await UpdateMenus()" IconType="IconType.Refresh" title="Update menus" />
    </div>
    <div class="col-md-3 text-center">
        <IconButton @onclick="async () => await LoadMenus()" IconType="IconType.Refresh" title="Load menus" />
    </div>
</EntitySearch>

<div class="row c-controls">

    <div class="pt-4">
        <DataGrid TEntity="Menu" Service="Service" ContentHeight="300" ShowInsertIcon="false" ConditionExpr='t => (isDropped == null || t.IsDropped == isDropped) && (showInMenu == null || t.ShowonMenu == showInMenu.Value) && (!onlyUntitledMenus || t.Title == null) && t.SubSystemKind == Subsystem'>
            <Columns>
                <GridColumn Field="t => t.Id" Title="Id" style="width:50px;" />
                <GridColumn Field="t => t.MenuCategory.Title" Title="main menu" />
                <GridColumn Field="t => t.Title" />
                <GridColumn Field="t => t.Source" />
                <GridColumn Field="t => t.Ordering" style="width:100px;" />
                <GridColumn Field="t => t.ShowonMenu" style="width:100px;" />
                <GridCommandColumns />
            </Columns>
        </DataGrid>
    </div>
    <Window Service="Service" Title="Menu" Style="width:500px;" OnOpen="FillUrls">
        <CaspianForm Service="Service">
            @{
                var path = $"/{Subsystem}/Engin";
                var disable = context.Source?.StartsWith(path) == true;
            }
            <StringTextBox @bind-Value="context.Source" readonly Disabled="disable" ColSpan="8" />
            <ComboBox TEntity="MenuCategory" TValue="int?" @bind-Value="context.MenuCategoryId" 
                      TextExpression="t => t.Title" Disabled="disable" ColSpan="8"
                      ConditionExpression='t => t.SubSystemKind == Subsystem && t.Title != "Engin"' />
            <StringTextBox @bind-Value="Service.UpsertData.Title" Disabled="disable" ColSpan="8" />
            <CheckBox @bind-Value="context.ShowonMenu" Disabled="disable" OnChange="FillUrls" ColSpan="8" />
            <ComboBox TValue="string" TEntity="SelectListItem" @bind-Value="context.URL" Source="source" ColSpan="8" />
            <div class="col-md-12 ps-5 text-center">
                <FormCommandButton disabled="@disable" />
            </div>
        </CaspianForm>
    </Window>

</div>

@code
{

}
