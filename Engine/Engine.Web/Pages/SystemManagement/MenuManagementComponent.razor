@namespace Caspian.Engine.SystemManagement
@inherits BasePage
@inject SingletonMenuService service
@inject IUIService<Menu> Service
@inject IUIService<MenuCategory> CategoryService
<EntitySearch Service="Service" ColumnsCount="2">
    <ComboBox TEntity="MenuCategory" TValue="int?" @bind-Value="context.MenuCategoryId" ColSpan="4"
              TextExpression="t => t.Title" ConditionExpression="t => t.SubsystemKind == Subsystem" OrderByExpression="t => t.Ordering" />
    <StringTextBox @bind-Value="context.Title" ColSpan="4" />
    <CheckBox CustomeSearch @bind-Value="onlyUntitledMenus" ColSpan="2" TotalSpan="4" Title="only Untitled Menus" />
    <CheckBox @bind-Value="context.IsDropped" ColSpan="2" TotalSpan="4"Title="Dropped" />
    <CheckBox @bind-Value="context.ShowOnMenu" ColSpan="2" TotalSpan="4" Title="Show In Menu" />
    <div class="col-md-3 text-center">
        <IconButton @onclick="async () => await UpdateMenus()" IconType="IconType.Refresh" title="Update menus" />
    </div>
    <div class="col-md-3 text-center">
        <IconButton @onclick="async () => await LoadMenus()" IconType="IconType.Refresh" title="Load menus" />
    </div>
    <div class="col-md-3 text-center">
        <IconButton @onclick="() => categoryWindowStatus = WindowStatus.Open" IconType="IconType.Refresh" title="Menu Category" />
    </div>
</EntitySearch>

<div class="row c-controls">
    <div class="pt-4">
        <DataGrid TEntity="Menu" Service="Service" ContentHeight="300" ShowInsertIcon="false" ConditionExpr='t => (!onlyUntitledMenus || t.Title == null) && t.SubsystemKind == Subsystem'>
            <Columns>
                <GridColumn Field="t => t.Id" Title="Id" style="width:50px;" />
                <GridColumn Field="t => t.MenuCategory.Title" Title="main menu" />
                <GridColumn Field="t => t.Title" />
                <GridColumn Field="t => t.SourceId" style="width:100px" />
                <GridColumn Field="t => t.Ordering" style="width:100px;" />
                <GridColumn Field="t => t.ShowOnMenu" style="width:100px;" />
                <GridCommandColumns DisableDeleteButton="context?.Data?.IsDropped == true" />
            </Columns>
        </DataGrid>
    </div>
    <Window Service="Service" Title="Menu" Style="width:500px;" OnOpen="FillUrls">
        <CaspianForm Service="Service">
            <ComboBox TEntity="MenuCategory" TValue="int?" @bind-Value="context.MenuCategoryId" 
                      TextExpression="t => t.Title" ColSpan="8"
                      ConditionExpression='t => t.SubsystemKind == Subsystem && t.Title != "Engin"' />
            <StringTextBox @bind-Value="Service.UpsertData.Title" ColSpan="8" />
            <CheckBox @bind-Value="context.ShowOnMenu" OnChange="FillUrls" ColSpan="8" />
            <ComboBox TValue="string" TEntity="SelectListItem" @bind-Value="context.URL" Source="source" ColSpan="8" />
            <div class="col-md-12 ps-5 text-center">
                <FormCommandButton  />
            </div>
        </CaspianForm>
    </Window>
</div>

<Window @bind-Status="categoryWindowStatus" Style="width:750px;" Title="Menu Category">
    <EntitySearch Service="CategoryService" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        <StringTextBox @bind-Value="context.IconFont" ColSpan="4" />
    </EntitySearch>
    <DataGrid Service="CategoryService" TEntity="MenuCategory" ConditionExpr="t => t.SubsystemKind == Subsystem">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.IconFont" style="width:60px;">
                <span class="c-icon @(context.Data.IconFont)"></span>
            </GridColumn>
            <GridColumn Title="منوها" style="width:60px;">
                <IconButton IconType="IconType.ExternalLink" @onclick="() => OpenMenuOrdringWindow(context.Data.Id)" />
            </GridColumn>
            <GridColumn Field="t => t.Ordering" style="width:95px;text-align:center;" SortType="SortType.Asc">
                <Template>
                    <IconButton IconType="@IconType.AngleUp" @onclick="async () => await IncPOrder(context.Data.Id)" />
                    <IconButton IconType="@IconType.AngleDown" @onclick="async () => await DecPOrder(context.Data.Id)" />
                </Template>
            </GridColumn>
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="CategoryService" Title="Category" Style="width:400px;">
        <CaspianForm TEntity="MenuCategory" Service="CategoryService" OnSubmit="t => t.Entity.SubsystemKind = Subsystem">
            <StringTextBox @bind-Value="context.Title" ColSpan="9" />
            <StringTextBox @bind-Value="context.IconFont" ColSpan="9" />
            <NumericTextBox Value="context.Ordering" ColSpan="9" TotalSpan="12" Title="ترتیب" />
            <FormCommandButton ColSpan="9" />
        </CaspianForm>
    </Window>
    <Window Title="Menu Ordering" Style="width:550px" @bind-Status="status">
        <DataGrid @ref="grvMenu" TEntity="Menu" ConditionExpr="t => t.MenuCategoryId == selectedCategoryId" PageSize="20" ContentHeight="350">
            <Columns>
                <GridColumn Field="t => t.Title" />
                <GridColumn Field="t => t.Ordering" style="width:95px;text-align:center;" SortType="SortType.Asc">
                    <Template>
                        <IconButton IconType="@IconType.AngleUp" @onclick="async () => await IncMenuPOrder(context.Data.Id)" />
                        <IconButton IconType="@IconType.AngleDown" @onclick="async () => await DecMenuPOrder(context.Data.Id)" />
                    </Template>
                </GridColumn>
            </Columns>
        </DataGrid>
    </Window>
</Window>



@code
{
    int? selectedCategoryId;
    WindowStatus status;
    DataGrid<Menu> grvMenu;

    void OpenMenuOrdringWindow(int categoryId)
    {
        selectedCategoryId = categoryId;
        status = WindowStatus.Open;
    }

    async Task IncPOrder(int id)
    {
        using var service = CreateScope().GetService<MenuCategoryService>();
        await service.IncOrderingAsync(id);
        await service.SaveChangesAsync();
        var grid = CategoryService.DataView;
        await grid.ReloadAsync();
        await grid.SelectPrevRow();
    }

    async Task DecPOrder(int id)
    {
        using var service = CreateScope().GetService<MenuCategoryService>();
        await service.DecOrderingAsync(id);
        await service.SaveChangesAsync();
        var grid = CategoryService.DataView;
        await grid.ReloadAsync();
        await grid.SelectNextRow();
    }

    async Task IncMenuPOrder(int id)
    {
        using var service = CreateScope().GetService<MenuService>();
        await service.IncOrderingAsync(id);
        await service.SaveChangesAsync();
        await grvMenu.ReloadAsync();
        await grvMenu.SelectPrevRow();
    }

    async Task DecMenuPOrder(int id)
    {
        using var service = CreateScope().GetService<MenuService>();
        await service.DecOrderingAsync(id);
        await service.SaveChangesAsync();
        await grvMenu.ReloadAsync();
        await grvMenu.SelectNextRow();
    }
}
