@inject IHostEnvironment host
@inject NavigationManager NavigationManager
<div class="d-document" @ondblclick="OpenDocumentGeneratorPage">
    @((MarkupString)content)
</div>
@{
    content = null;
}

@code
{
    void OpenDocumentGeneratorPage(MouseEventArgs e)
    {
        if (e.CtrlKey)
        {
            var url = $"/Demo/DocumentGenerator/{FileName}";
            if (FolderName.HasValue())
                url += $"/{FolderName}";
            NavigationManager.NavigateTo(url, true, true);
        }
    }

    string content;
    protected override async Task OnInitializedAsync()
    {
        var fileName = FileName;
        if (!FileName.EndsWith(".htm", StringComparison.CurrentCultureIgnoreCase))
            fileName += ".htm";
        var path = host.ContentRootPath;
        if (host.IsDevelopment())
            path = path.Substring(0, path.Length - host.ApplicationName.Length) + "Demo\\Demo.Web\\Help\\";
        else
            path += "\\Help\\";
        if (FolderName.HasValue())
            path += FolderName + '\\';
        path += fileName;
        if (File.Exists(path))
        {
            content = await File.ReadAllTextAsync(path);
            content = content.Replace("�", "&nbsp;");
        }
        else
            content = $"File Not exist";
        await base.OnInitializedAsync();
    }

    [Parameter]
    public string FileName { get; set; }

    [Parameter]
    public string FolderName { get; set; }
}
