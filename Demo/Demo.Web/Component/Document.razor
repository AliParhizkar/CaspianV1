@using System.Diagnostics
@inject IHostEnvironment host
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
<button @onclick="OpenDocumentGeneratorPage">+</button>
<div class="d-document" >
    <iframe @ref="iframe" frameborder="0">
    </iframe>
</div>

@code
{
    ElementReference iframe;

    [Parameter]
    public string FileName { get; set; }

    [Parameter]
    public string FolderName { get; set; }

    void OpenDocumentGeneratorPage()
    {
        var path = host.ContentRootPath;
        path = path.Substring(0, path.Length - host.ApplicationName.Length) + "Demo\\Demo.Web\\Help\\";
        if (FolderName.HasValue())
            path += FolderName + '\\';
        path += $"{FileName}.docx";
        Process.Start(new ProcessStartInfo()
        {
            FileName = path,
            UseShellExecute = true
        });
    }

    string content;
    protected override async Task OnInitializedAsync()
    {
        var path = host.ContentRootPath;
        if (host.IsDevelopment())
            path = path.Substring(0, path.Length - host.ApplicationName.Length) + "Demo\\Demo.Web\\Help\\";
        else
            path += "\\Help\\";
        if (FolderName.HasValue())
            path += FolderName + '\\';
        path += FileName;
        //if (File.Exists(path))
        //{
        //    content = await File.ReadAllTextAsync(path);
        //    content = content.Replace("�", "&nbsp;");
        //}
        //else
        //    content = $"File Not exist";
        using var straem = new MemoryStream();
        straem.Position = 0;
        using var reader = new StreamReader(straem);
        content = await reader.ReadToEndAsync();

        await base.OnInitializedAsync();
    }
}
