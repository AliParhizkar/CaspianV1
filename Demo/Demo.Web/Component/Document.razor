@using System.Diagnostics
@using Mammoth

@inject IHostEnvironment host
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
<div style="padding:5px 10px">
    <IconButton @onclick="OpenDocumentGeneratorPage" IconType="IconType.FileWordO" />
    <IconButton @onclick="() => SaveAsFiltteredHtml()" IconType="IconType.Html5" />
</div>
<div class="d-document">
    <span>111</span>
    @((MarkupString)content)
</div>

@code
{
    string content;

    [Parameter]
    public string FileName { get; set; }

    [Parameter]
    public string FolderName { get; set; }

    string GetFilePath()
    {
        var path = host.ContentRootPath;
        path = path.Substring(0, path.Length - host.ApplicationName.Length) + "Demo\\Demo.Web\\Help\\";
        if (FolderName.HasValue())
            path += FolderName + '\\';
        path += $"{FileName}";
        return path;
    }

    void OpenDocumentGeneratorPage()
    {
        var path = $"{GetFilePath()}.docx";
        Process.Start(new ProcessStartInfo()
        {
            FileName = path,
            UseShellExecute = true
        });
    }

    void SaveAsFiltteredHtml()
    {
        var sourcePath = $"{GetFilePath()}.docx";
        var outputPath = $"{GetFilePath()}.htm";
        var converter = new DocumentConverter();
        string html = converter.ConvertToHtml(File.OpenRead(sourcePath)).Value;
        File.WriteAllText(outputPath, html);
    }

    protected override async Task OnInitializedAsync()
    {
        var path = host.ContentRootPath;
        if (host.IsDevelopment())
            path = path.Substring(0, path.Length - host.ApplicationName.Length) + "Demo\\Demo.Web\\Help\\";
        else
            path += "\\Help\\";
        if (FolderName.HasValue())
            path += FolderName + '\\';
        path += FileName + ".htm";
        if (File.Exists(path))
            content = await File.ReadAllTextAsync(path);
        await base.OnInitializedAsync();
    }
}
