@using Mammoth
@using System.Diagnostics

@inject IHostEnvironment host
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div style="padding:5px 10px">
    <IconButton @onclick="OpenDocumentGeneratorPage" IconType="IconType.FileWordO" />
    <IconButton @onclick="() => SaveAsFiltteredHtml()" IconType="IconType.Html5" />
</div>
<div class="d-document">
    @((MarkupString)content)
</div>

@code
{
    string content;

    [Parameter]
    public string FileName { get; set; }

    [Parameter]
    public string FolderName { get; set; }

    string GetFilePath()
    {
        var path = host.ContentRootPath;
        path = path.Substring(0, path.Length - host.ApplicationName.Length) + "Demo\\Demo.Web\\Help\\";
        if (FolderName.HasValue())
            path += FolderName + '\\';
        path += $"{FileName}";
        return path;
    }

    void OpenDocumentGeneratorPage()
    {
        var path = $"{GetFilePath()}.docx";
        if (File.Exists(path))
        {
            Process.Start(new ProcessStartInfo()
            {
                FileName = path,
                UseShellExecute = true
            });
        }
        else 
            Page.ShowMessage("فایل یافت نشد.");
    }

    void SaveAsFiltteredHtml()
    {
        var document = new Aspose.Words.Document($"{GetFilePath()}.docx");
        document.Save($"{GetFilePath()}.htm");
        content = File.ReadAllText($"{GetFilePath()}.htm");
        content = content.Replace("�", "&ensp;");
        Page.ShowMessage("ثبت با موفقیت انجام شد");
    }

    protected override async Task OnInitializedAsync()
    {
        var path = host.ContentRootPath;
        if (host.IsDevelopment())
            path = path.Substring(0, path.Length - host.ApplicationName.Length) + "Demo\\Demo.Web\\Help\\";
        else
            path += "\\Help\\";
        if (FolderName.HasValue())
            path += FolderName + '\\';
        path += FileName + ".htm";
        if (File.Exists(path))
        {
            content = await File.ReadAllTextAsync(path);
            content = content.Replace("�", "&ensp;");
        }

        await base.OnInitializedAsync();
    }

    [Parameter]
    public BasePage Page { get; set; }
}
