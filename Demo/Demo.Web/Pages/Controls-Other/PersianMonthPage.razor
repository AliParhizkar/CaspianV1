@page "/Demo/PersianMonth"
@namespace Demo.Web.Pages
@inherits BasePage
@attribute [Source(19, "Desk calendar")]
<h2>Persian Calendar</h2>

<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="row c-controls p-2 ps-5 pe-5">
                <DropdownList @bind-Value="year" Source="years" ColSpan="4" TotalSpan="6" Title="سال" />
                <DropdownList @bind-Value="month" ColSpan="4" TotalSpan="6" Title="ماه" />
            </div>
            <div class="p-3">
                <PersianMonthComponent Year="year" Month="month">
                    <Template Context="date">
                        <span>@date.ToPersianDateString()</span>
                    </Template>
                </PersianMonthComponent>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Demo">
            <Document Page="this" FolderName="BasePage" FileName="Calendar" />
        </TabPanelItem>
    </Tabs>
</TabPanel>


@code
{
    int year = DateTime.Now.ToPersianDate().Year.Value;
    PersianMonth month = DateTime.Now.ToPersianDate().Month.Value;
    List<SelectListItem> years;

    protected override void OnInitialized()
    {
        years = new();
        for (int i = 1400; i <= 1410; i++)
            years.Add(new SelectListItem(i.ToString(), i.ToString()));
        base.OnInitialized();

    }
}