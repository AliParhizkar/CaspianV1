@page "/Demo/Courier"
@attribute [Page(60, "Courier")]
@inject IUIService<Courier> Service
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div style="background-color:white" class="row ps-5 pe-5 pt-4 pb-4 ms-4 me-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.LName" />
    </EntitySearch>
    <DataGrid TEntity="Courier" Service="Service" ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.FName" />
            <GridColumn Field="t => t.LName" />
            <GridColumn Field="t => t.Code" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Title="Courier" Style="width:450px">
        <CaspianForm Service="Service">
            <StringTextBox @bind-Value="context.FName" ColSpan="9" />
            <StringTextBox @bind-Value="context.LName" ColSpan="9" />
            <StringTextBox @bind-Value="context.Code" ColSpan="9" />
            <div class="col-md-9 text-center">
                <WindowCommandButtons />
            </div>
        </CaspianForm>
    </Window>
</div>
