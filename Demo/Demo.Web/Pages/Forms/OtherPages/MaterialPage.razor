@page "/Demo/Material"
@attribute [Page(62, "Material")]
@namespace Demo.Web.Pages
@inherits BasePage
@inject IUIService<Material> Service
@{
    base.BuildRenderTree(__builder);
}

<div style="background-color:white" class="row ps-5 pe-5 pt-4 pb-4 ms-4 me-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="9" />
    </EntitySearch>
    <DataGrid TEntity="Material" Service="Service" ContentHeight="300">
        <Columns Context="con">
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.MainUnit.Title" Title="Mainunit" />
            <GridColumn Field="t => t.Subunit.Title" Title="subUnit" />
            <GridColumn Field="t => t.ActiveType.EnumText()" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Title="Material" Style="width:450px" OnOpen="SetDataOnWindowOpened">
        <CaspianForm Service="Service">
            <ComboBox TEntity="MainUnit" CascadeService="cascadeService" TValue="int" @bind-Value="context.MainUnitId" TextExpression="t => t.Title" ColSpan="9" />
            <ComboBox TEntity="Subunit" TValue="int?" CascadeService="cascadeService" Disabled="context.MainUnitId == 0" @bind-Value="context.SubunitId" TextExpression="t => t.Title" ColSpan="9" />
            <StringTextBox @bind-Value="context.Title" ColSpan="9" />
            <DropdownList @bind-Value="Service.UpsertData.ActiveType" ColSpan="9" />
            <div class="col-md-9 text-center">
                <WindowCommandButtons />
            </div>
        </CaspianForm>
    </Window>
</div>


@code
{
    CascadeService<MainUnit, Subunit> cascadeService = new();

    void SetDataOnWindowOpened()
    {
        if (Service.UpsertData.Id == 0)
            Service.UpsertData.ActiveType = ActiveType.Enable;
    }
}
