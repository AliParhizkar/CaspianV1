@page "/Demo/Subunit"
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
@inject UIService<Subunit> Service
<div style="background-color:white" class="row ps-5 pe-5 pt-4 pb-4 ms-4 me-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" />
    </EntitySearch>
    <DataGrid TEntity="Subunit" Service="Service" ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.MainUnit.Title" Title="Mainunit" />
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.Factor.Seprate3Digit()" />
            <GridColumn Field="t => t.ActiveType.EnumText()" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Title="MainUnit" Style="width:450px">
        <CaspianForm Service="Service">
            <ComboBox TEntity="MainUnit" TValue="int" @bind-Value="context.MainUnitId" TextExpression="t => t.Title" ColSpan="9" />
            <StringTextBox @bind-Value="context.Title" ColSpan="9" />
            <NumericTextBox @bind-Value="context.Factor" ColSpan="9" />
            <DropdownList @bind-Value="context.ActiveType" ColSpan="9" />
            <div class="col-md-9 text-center">
                <WindowCommandButtons />
            </div>
        </CaspianForm>
    </Window>
</div>

