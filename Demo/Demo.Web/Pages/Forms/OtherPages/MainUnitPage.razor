@page "/Demo/MainUnit"
@attribute [Source(61, "MainUnit")]
@inherits BasePage
@inject IUIService<MainUnit> Service
@{
    base.BuildRenderTree(__builder);
}
<div style="background-color:white" class="row ps-5 pe-5 pt-4 pb-4 ms-4 me-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="8" />
    </EntitySearch>
    <DataGrid TEntity="MainUnit" Service="Service" ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Service="Service" Title="MainUnit" Style="width:450px">
        <CaspianForm Service="Service">
            <StringTextBox @bind-Value="context.Title" ColSpan="8" />
            <DropdownList @bind-Value="context.ActiveType" ColSpan="8" />
            <FormCommandButton ColSpan="8" />
        </CaspianForm>
    </Window>
</div>
