@page "/Demo/Warehouse"
@attribute [Source(65, "Warehouse")]
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
@inject IUIService<Warehouse> Service
<div style="background-color:white" class="row ps-5 pe-5 pt-4 pb-4 ms-4 me-4">
    <EntitySearch Service="Service">
        <StringTextBox @bind-Value="context.Title" ColSpan="9" />
    </EntitySearch>
    <DataGrid TEntity="Warehouse" Service="Service" ContentHeight="300">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
    <Window Title="Warehouse" Service="Service" Style="width:450px">
        <CaspianForm Service="Service">
            <StringTextBox @bind-Value="context.Title" ColSpan="9" />
            <DropdownList @bind-Value="context.ActiveType" ColSpan="9" />
            <div class="col-md-9 text-center">
                <WindowCommandButtons />
            </div>
        </CaspianForm>
    </Window>
</div>
