@page "/Demo/Batch/Inline/Listview/Details"
@page "/Demo/Batch/Inline/Listview/Details/{OrderId:int}"
@attribute [Source(84, "Inline Listview Details", MasterPage = typeof(InlineMasterPage))]
@namespace Demo.Web.Pages
@inherits BasePage
@inject IUIService<Order, OrderDetail> Service

<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content pt-3">
                <div class="row">
                    <div class="col-md-4 row pe-3">
                        <div class="col-md-2 text-start c-arrow-back">
                            <a href="/Demo/Batch/Inline/Master">
                                <span class="fa fa-arrow-left c-small-icon"></span>
                            </a>
                        </div>
                        <div class="col-md-10 text-center">
                            <h3>
                                <span class="d-membership">Order</span>
                            </h3>
                        </div>
                        <hr class="mt-2" />
                    </div>
                    <div class="col-md-8 row ps-3 ">
                        <div class="col-md-10 text-center pt-2">
                            <h3>
                                <span class="d-membership">Orderdetails</span>
                            </h3>
                        </div>
                        <div class="col-md-1 text-center">
                            <span @ref="btnOrders" @onclick="ShowOrders" title="Today's Orders" class="fa fa-bars c-small-icon"></span>
                        </div>
                        <hr class="mt-2" />
                    </div>
                    <div class="col-md-4">
                        <CaspianForm Service="Service">
                            <DatePicker @bind-Value="context.Date" ColSpan="8" />
                            <DropdownList @bind-Value="context.OrderType" ColSpan="8" />
                            <ComboBox TEntity="Customer" TValue="int?" @bind-Value="context.CustomerId" ColSpan="8"
                                      TextExpression="@(t => t.CustomerType == CustomerType.Real ? t.FName + " " + t.LName : t.CompanyName)" />
                            <ComboBox TEntity="Courier" TValue="int?" @bind-Value="context.CourierId" ColSpan="8"
                                      TextExpression="@(t => t.FName + " " + t.LName + "-" + t.Code)" />
                            <NumericTextBox Value="context.TotalAmount" ColSpan="8" Title="Total Amount" />
                            <FormCommandButton ColSpan="8" />
                        </CaspianForm>
                    </div>
                    <div class="col-md-8 ps-3">
                        <ListView TEntity="OrderDetail" DetailsService="Service.DetailService" ContentHeight="250" Inline Batch PageSize="8"
                                  OnCancel="HideDescription" OnOpen="HideDescription" OnSave="HideDescription" OnChanged="CalCulateOrderParameters">
                            <HeaderTempalte>
                                <div class="d-listview-col-1">Product</div>
                                <div class="d-listview-col-2">Price</div>
                                <div class="d-listview-col-3">Quantity</div>
                                <div class="d-listview-col-4">Description</div>
                                <div class="d-listview-col-5">Edit-Delete</div>
                            </HeaderTempalte>
                            <Fields Context="detail">
                                @{
                                    var showDescription = ShowDescriptionStatus && selectedDetail == detail.Data;
                                    var className = showDescription ? "d-main d-open-form" : "d-main";
                                }
                                <div class="@(className)">
                                    <TextField DataField Field="t => t.Product.Discount.ToString()" />
                                    <div class="d-listview-col-1">
                                        <TextField Field="t => t.Product.Title">
                                            <EditTemplate>
                                                <Lookup TEntity="Product" TValue="int" @bind-Value="detail.Data.ProductId"
                                                        HideHeader AutoHide TextExpression="t => t.Title"
                                                        OnChange="async () => await SetPrice(detail.Data)">
                                                    <ProductLookupWindow />
                                                </Lookup>
                                            </EditTemplate>
                                        </TextField>
                                    </div>
                                    <div class="d-listview-col-2">
                                        <TextField Field="t => t.Price.DigitGrouping()">
                                            <Template>
                                                <div>
                                                    @if (detail.Data.Product?.Discount > 0)
                                                    {
                                                        <div class="d-price d-discount">@(detail.Data.Price + detail.Data.Product.Discount)</div>
                                                    }
                                                    <div class="d-price">@(detail.Data.Price.DigitGrouping())</div>

                                                </div>
                                            </Template>
                                        </TextField>
                                    </div>
                                    <div class="d-listview-col-3">
                                        <TextField Field="t => t.Quantity.ToString()">
                                            <EditTemplate>
                                                <NumericTextBox @ref="txtQuantity" @bind-Value="detail.Data.Quantity"
                                                                @onkeyup="@(async e => await UpsertOnEnter(e, detail.UpsertMode.Value))" />
                                            </EditTemplate>
                                        </TextField>
                                    </div>
                                    <div class="d-listview-col-4">
                                        <button class="c-btn c-info" disabled="@(detail?.UpsertMode == null)" @onclick="async () => await ShowDescription(detail)">
                                            <span class="fa fa-chevron-up"></span>
                                        </button>
                                    </div>
                                    <div class="d-listview-col-5">
                                        <ListCommandButton ButtonType="CommandButtonType.Simple" />
                                    </div>
                                    @if (showDescription)
                                    {
                                        <div class="d-listview-col-7">
                                            <label>Description</label>
                                        </div>
                                        <div class="d-listview-col-6">
                                            <StringTextBox @ref="txtDescription" @bind-Value="detail.Data.Descript" MultiLine Cols="5" />
                                        </div>
                                    }
                                </div>
                            </Fields>
                        </ListView>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Razor">
            <Document Page="this" FolderName="Batch" FileName="Batch-List-View" />
        </TabPanelItem>
    </Tabs>
</TabPanel>

<PopupWindow @bind-Status="ordersStatus" TargetElement="btnOrders" TargetHorizontalAnchor="HorizontalAnchor.Left" OffsetLeft="-1"
             TargetVerticalAnchor="VerticalAnchor.Middle" HorizontalAnchor="HorizontalAnchor.Right" VerticalAnchor="VerticalAnchor.Middle">
    <div class="d-orders">
        @foreach (var order in orders)
        {
            <div class="d-order-item">
                <span>@order.OrderNo</span>
                <span>@order.TotalAmount.DigitGrouping()</span>
                <span @onclick="async () => await InitializeOrder(order.Id)" class="fa fa-pencil c-small-icon"></span>
            </div>
        }
    </div>
</PopupWindow>
@code
{
    StringTextBox txtDescription;
    NumericTextBox<int> txtQuantity;
    bool ShowDescriptionStatus;
    OrderDetail selectedDetail;
    UpsertMode upsertMode;
    ElementReference? btnOrders;
    IList<Order> orders;
    double left;
    WindowStatus ordersStatus;

    protected override void OnInitialized()
    {
        Service.DetailService.MasterId = OrderId;
        Service.OnCreate = t => t.Date = DateTime.Now.ToDateOnly();
        base.OnInitialized();
    }

    async Task InitializeOrder(int orderId)
    {
        await Service.ReloadForUpdate(orderId);
        ordersStatus = WindowStatus.Close;
    }

    async Task ShowOrders(MouseEventArgs e)
    {
        using var service = CreateScope().GetService<OrderService>();
        var todayDate = DateTime.Now.ToDateOnly();
        orders = await service.GetAll().Where(t => t.Date == todayDate).ToListAsync();
        left = e.ClientX - e.OffsetX - 200;
        ordersStatus = WindowStatus.Open;
    }

    void CalCulateOrderParameters()
    {
        var order = Service.UpsertData;
        order.TotalAmount = Service.DetailService.DataView.GetBatchEntities().Sum(t => t.Quantity * t.Price);
    }

    void HideDescription()
    {
        ShowDescriptionStatus = false;
        selectedDetail = null;
    }

    async Task ShowDescription(RowData<OrderDetail> rowData)
    {
        var detail = rowData.Data;
        if (rowData.UpsertMode.HasValue)
        {
            selectedDetail = detail;
            ShowDescriptionStatus = !ShowDescriptionStatus;
            if (ShowDescriptionStatus)
            {
                if (detail.Id > 0 && !detail.Descript.HasValue())
                {
                    using var service = CreateScope().GetService<OrderDetailService>();
                    var old = await service.SingleAsync(detail.Id);
                    detail.Descript = old.Descript;
                }
                await Task.Delay(100);
                await txtDescription.FocusAsync();
            }
        }
    }

    async Task SetPrice(OrderDetail detail)
    {
        if (detail.ProductId > 0)
        {
            if (detail.Id == 0)
                detail.Quantity = 1;
            using var service = CreateScope().GetService<ProductService>();
            var old = await service.SingleAsync(detail.ProductId);
            detail.Price = old.Price;
            detail.Discount = old.Discount ?? 0;
            detail.Product = old;
            await txtQuantity.FocusAsync();
        }
    }

    async Task UpsertOnEnter(KeyboardEventArgs e, UpsertMode mode)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
            await Service.DetailService.DataView.ValidateAndUpsert(mode);
    }

    [CascadingParameter]
    public CaspianContainer Container { get; set; }

    [Parameter]
    public int OrderId { get; set; }
}