@page "/Demo/Scope"
@namespace Demo.Web.Pages
@attribute [Source(59, "Scope")]
@using System.Globalization
@inject UIService<Scope, Evaluation> Service
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}

<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="p-3">
                <DataGrid TEntity="Scope" Service="Service" ContentHeight="300" DeleteMessage="با حذف حوزه اعتبارسنجی های آن نیز حذف می شود آیا با حذف موافقید؟">
                    <Columns>
                        <GridColumn Field="t => t.Title" />
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>First popup">
            <Document Page="this" FolderName="Batch" FileName="First-popup" />
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Second popup">
            <Document Page="this" FolderName="Batch" FileName="Second-popup" />
        </TabPanelItem>
    </Tabs>
</TabPanel>

<Window Service="Service" Title="Scope & Evaluations" Style="width:750px;">
    <CaspianForm Service="Service">
        <fieldset class="c-container">
            <legend>Scope Properties</legend>
            <div class="row ps-3 pe-3 c-controls">
                <StringTextBox @bind-Value="context.Title" ColSpan="10" />
                <StringTextBox @bind-Value="context.EnTitle" ColSpan="6" TotalSpan="8" />
                <div class="col-md-4 text-center">
                    <FormCommandButton ResetButtonTitle="Close" />
                </div>
            </div>
        </fieldset>
    </CaspianForm>
    <EvaluationComponent />
</Window>

