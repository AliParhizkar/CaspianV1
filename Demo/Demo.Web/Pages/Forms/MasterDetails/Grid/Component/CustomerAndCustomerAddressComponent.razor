@namespace Demo.Web.Pages
@inject BatchService<Customer, CustomerAddress> Service
<TabPanel>
    <Tabs>
        <TabPanelItem Title="Customer">
            <div class="pt-3">
                <CaspianForm Service="Service">
                    @{
                        var customerType = context.CustomerType;
                    }
                    <CaspianValidationValidator TModel="Customer" ValidatorType="typeof(CustomerAndAddressService)" />
                    <DropdownList @bind-Value="context.CustomerType" ColSpan="8" />
                    <StringTextBox @bind-Value="context.FName" Disabled="customerType == CustomerType.Legal" ColSpan="8" />
                    <StringTextBox @bind-Value="context.LName" Disabled="customerType == CustomerType.Legal" ColSpan="8" />
                    <DropdownList @bind-Value="context.Gender" Disabled="customerType == CustomerType.Legal" ColSpan="8" />
                    <StringTextBox @bind-Value="context.CompanyName" Disabled="customerType == CustomerType.Real" ColSpan="8" />
                    <StringTextBox @bind-Value="context.MobileNumber" MaxLength="11" ColSpan="8" />
                    <StringTextBox @bind-Value="context.Tel" MaxLength="11" ColSpan="8" />
                    <FormCommandButton ColSpan="8" />
                </CaspianForm>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="Addresses">
            <div class="p-2">
                <DataGrid TEntity="CustomerAddress" DetailsService="Service" PageSize="5" ContentHeight="275" Inline AutoHide >
                    <Columns Context="con">
                        <GridColumn style="width:220px;" Field="t => t.AddressType.Title" Title="Address Type">
                            <EditTemplate>
                                <ComboBox TValue="int" TEntity="AddressType" @bind-Value="con.Data.AddressTypeId" TextExpression="t => t.Title" />
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn Field="t => t.Address" Title="Address">
                            <EditTemplate>
                                <StringTextBox MultiLine Rows="2" @bind-Value="con.Data.Address" />
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn Field="t => t.ZipCode" Title="Zipcode" style="width:120px">
                            <EditTemplate>
                                <StringTextBox @bind-Value="con.Data.ZipCode" />
                            </EditTemplate>
                        </GridColumn>
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
            </div>
        </TabPanelItem>
    </Tabs>
</TabPanel>

