@namespace Demo.Web.Pages
<TabPanel>
    <Tabs>
        <TabPanelItem Title="Customer">
            <CaspianForm Service="Service">
                <Content Context="address">
                    <CaspianValidationValidator TModel="Customer" ValidatorType="typeof(CustomerAndAddressService)" />
                    <div class="row p-4 c-controls">
                        <div class="col-md-4">
                            <label>Customer Type</label>
                        </div>
                        <div class="col-md-8">
                            <DropdownList @bind-Value="address.CustomerType" />
                        </div>
                        <div class="col-md-4">
                            <label>First Name</label>
                        </div>
                        <div class="col-md-8">
                            <StringTextBox @bind-Value="address.FName" Disabled="address.CustomerType == CustomerType.Legal" />
                        </div>
                        <div class="col-md-4">
                            <label>Last Name</label>
                        </div>
                        <div class="col-md-8">
                            <StringTextBox @bind-Value="address.LName" Disabled="address.CustomerType == CustomerType.Legal" />
                        </div>
                        <div class="col-md-4">
                            <label>Gender</label>
                        </div>
                        <div class="col-md-8">
                            <DropdownList @bind-Value="address.Gender" Disabled="address.CustomerType == CustomerType.Legal" />
                        </div>
                        <div class="col-md-4">
                            <label>Company Name</label>
                        </div>
                        <div class="col-md-8">
                            <StringTextBox @bind-Value="address.CompanyName" Disabled="address.CustomerType == CustomerType.Real" />
                        </div>
                        <div class="col-md-4">
                            <label>Mobile Number</label>
                        </div>
                        <div class="col-md-8">
                            <StringTextBox @bind-Value="address.MobileNumber" MaxLength="11" />
                        </div>
                        <div class="col-md-4">
                            <label>Tel</label>
                        </div>
                        <div class="col-md-8">
                            <StringTextBox @bind-Value="address.Tel" MaxLength="11" />
                        </div>
                        <div class="col-md-4"></div>
                        <div class="col-md-8">
                            <FormCommandButton />
                        </div>
                    </div>
                </Content>
            </CaspianForm>
        </TabPanelItem>
        <TabPanelItem Title="Addresses">
            <div class="p-2">
                <DataGrid TEntity="CustomerAddress" DetailsService="Service" PageSize="5" ContentHeight="275" Inline AutoHide >
                    <Columns Context="con">
                        <GridColumn style="width:220px;" Field="t => t.AddressType.Title" Title="Address Type">
                            <EditTemplate>
                                <ComboBox TValue="int" TEntity="AddressType" @bind-Value="con.Data.AddressTypeId" TextExpression="t => t.Title" />
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn Field="t => t.Address" Title="Address">
                            <EditTemplate>
                                <StringTextBox MultiLine Rows="2" @bind-Value="con.Data.Address" />
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn Field="t => t.ZipCode" Title="Zipcode" style="width:120px">
                            <EditTemplate>
                                <StringTextBox @bind-Value="con.Data.ZipCode" />
                            </EditTemplate>
                        </GridColumn>
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
            </div>
        </TabPanelItem>
    </Tabs>
</TabPanel>

@code 
{
    [Parameter]
    public BatchService<Customer, CustomerAddress> Service { get; set; }
}
