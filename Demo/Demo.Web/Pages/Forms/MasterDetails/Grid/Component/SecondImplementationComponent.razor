@namespace Demo.Web.Pages
@inject UIService<Customer, CustomerGroupMembership> Service
<CaspianForm Service="Service">
    @{
        var customerType = context.CustomerType;
    }
    <CaspianValidationValidator TModel="Customer" ValidatorType="typeof(CustomerService)" />
    <div class="row col-md-7">
        <DropdownList @bind-Value="Service.UpsertData.CustomerType" ColSpan="8" />
        <StringTextBox @bind-Value="Service.UpsertData.FName" Disabled="customerType == CustomerType.Legal" ColSpan="8" />
        <StringTextBox @bind-Value="Service.UpsertData.LName" Disabled="customerType == CustomerType.Legal" ColSpan="8" />
        <DropdownList @bind-Value="Service.UpsertData.Gender" Disabled="customerType == CustomerType.Legal" ColSpan="8" />
        <StringTextBox @bind-Value="Service.UpsertData.CompanyName" Disabled="customerType == CustomerType.Real" ColSpan="8" />
        <StringTextBox @bind-Value="Service.UpsertData.MobileNumber" MaxLength="11" ColSpan="8" />
        <StringTextBox @bind-Value="Service.UpsertData.Tel" MaxLength="11" ColSpan="8" />
    </div>
    <div class="col-md-5 ps-3 mb-3">
        <label style="justify-content:space-evenly">Customer Groups</label>
        <CheckedListbox TEntity="CustomerGroup" TDetails="CustomerGroupMembership" Service="Service" Style="height:250px;flex-wrap:nowrap"
                        TextExpression="t => t.Title" />
    </div>
    <FormCommandButton ColSpan="8" />
</CaspianForm>

