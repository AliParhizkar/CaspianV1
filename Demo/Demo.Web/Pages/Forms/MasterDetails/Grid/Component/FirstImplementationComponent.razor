@namespace Demo.Web.Pages
@inject UIService<Customer, CustomerGroupMembership> Service
<CaspianForm Service="Service">
    <CaspianValidationValidator TModel="Customer" ValidatorType="typeof(CustomerService)" />
    <div class="p-4 pt-3 pb-0">
        <TabPanel>
            <Tabs>
                <TabPanelItem Title="Customer">
                    <div class="row p-4 pt-2 pb-2" style="height:260px;align-content:flex-start">
                        <DropdownList @bind-Value="Service.UpsertData.CustomerType" ColSpan="8" />
                        @if (Service.UpsertData.CustomerType == CustomerType.Real)
                        {
                            <StringTextBox @bind-Value="Service.UpsertData.FName" ColSpan="8" />
                            <StringTextBox @bind-Value="Service.UpsertData.LName" ColSpan="8" />
                            <DropdownList @bind-Value="Service.UpsertData.Gender" ColSpan="8" />
                        }
                        else if (Service.UpsertData.CustomerType == CustomerType.Legal)
                        {
                            <StringTextBox @bind-Value="Service.UpsertData.CompanyName" ColSpan="8" />
                        }
                        <StringTextBox @bind-Value="Service.UpsertData.MobileNumber" MaxLength="11" ColSpan="8" />
                        <StringTextBox @bind-Value="Service.UpsertData.Tel" MaxLength="11" ColSpan="8" />
                    </div>
                </TabPanelItem>
                <TabPanelItem Title="Groups">
                    <div class="ps-4 pe-4 pt-2 pb-2" style="height:260px">
                        <CheckedListbox TEntity="CustomerGroup" TDetails="CustomerGroupMembership" Service="Service"
                                      TextExpression="t => t.Title" Style="height:220px;" />
                    </div>
                </TabPanelItem>
            </Tabs>
        </TabPanel>
    </div>
    <div class="pt-4">
        <FormCommandButton />
    </div>
</CaspianForm>

