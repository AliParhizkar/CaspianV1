@page "/Demo/CustomerAndGroupsAndAddresses"
@inject BatchService<Customer, CustomerGroupMembership, CustomerAddress> Service
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="p-4">
                <DataGrid TEntity="Customer" Service="Service" ContentHeight="400" DeleteMessage="با حذف مشتری آدرسها و گروههای وی نیز حذف می شود آیا با حذف موافقید؟">
                    <Columns>
                        <GridColumn Field="t => t.CustomerType" />
                        <GridColumn Field='t => t.CustomerType == CustomerType.Real ? t.FName + " " + t.LName : t.CompanyName' Title="Name" />
                        <GridColumn Field="t => t.MobileNumber.CallFormat(' ')" />
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
                <Window Service="Service" Title="Customer Properties" Style="width:800px;">
                    <CaspianForm Service="Service" ColumnsCount="2">
                        @{
                            var customerType = context.CustomerType;
                        }
                        <CaspianValidationValidator TModel="Customer" ValidatorType="typeof(CustomerGroupAddressService)" />
                        <DropdownList @bind-Value="context.CustomerType" ColSpan="4" />
                        <StringTextBox @bind-Value="context.FName" Disabled="customerType == CustomerType.Legal" ColSpan="4" />
                        <StringTextBox @bind-Value="context.LName" Disabled="customerType == CustomerType.Legal" ColSpan="4"/>
                        <DropdownList @bind-Value="context.Gender" Disabled="customerType == CustomerType.Legal" ColSpan="4" />
                        <StringTextBox @bind-Value="context.CompanyName" Disabled="customerType == CustomerType.Real" ColSpan="4" />
                        <StringTextBox @bind-Value="context.MobileNumber" MaxLength="11" ColSpan="4" />
                        <StringTextBox @bind-Value="context.Tel" MaxLength="11" ColSpan="4" />
                        <FormCommandButton ColSpan="6" TotalSpan="6" />
                    </CaspianForm>
                    <div class="p-2 pb-0">
                        <TabPanel>
                            <Tabs>
                                <TabPanelItem Title="Customer Addresses">
                                    <div class="p-2 ps-3 pe-3">
                                        <DataGrid TEntity="CustomerAddress" DetailsService="Service" ContentHeight="185" Inline AutoHide>
                                            <Columns Context="con">
                                                <GridColumn style="width:220px;" Field="t => t.AddressType.Title" Title="Address Type">
                                                    <EditTemplate>
                                                        <ComboBox TValue="int" TEntity="AddressType" @bind-Value="con.Data.AddressTypeId" TextExpression="t => t.Title" />
                                                    </EditTemplate>
                                                </GridColumn>
                                                <GridColumn Field="t => t.Address" Title="Address">
                                                    <EditTemplate>
                                                        <StringTextBox MultiLine Rows="2" @bind-Value="con.Data.Address" />
                                                    </EditTemplate>
                                                </GridColumn>
                                                <GridColumn Field="t => t.ZipCode" Title="Zip code" style="width:120px">
                                                    <EditTemplate>
                                                        <StringTextBox @bind-Value="con.Data.ZipCode" />
                                                    </EditTemplate>
                                                </GridColumn>
                                                <GridCommandColumns />
                                            </Columns>
                                        </DataGrid>
                                    </div>
                                </TabPanelItem>
                                <TabPanelItem Title="Groups Membership">
                                    <div class="p-3 pt-2 pb-2" style="width:600px;margin:0 auto">
                                        <CheckedListbox TEntity="CustomerGroup" TDetails="CustomerGroupMembership" Service="Service" Style="height:247px;"
                                                        TextExpression="t => t.Title" />
                                    </div>
                                </TabPanelItem>
                            </Tabs>
                        </TabPanel>
                    </div>
                </Window>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document FolderName="Batch" FileName="Third-Entity" />
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Service">
            <Document FolderName="Service/Batch" FileName="Third-Entity" />
        </TabPanelItem>
    </Tabs>
</TabPanel>

