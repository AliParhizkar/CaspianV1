@inherits BasePage
@inject IUIService<Product> Service
@namespace Demo.Web.Pages
@{
    base.BuildRenderTree(__builder);
}
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="row pb-3 pe-3">
                <div class="col-md-5 pt-5 ps-3 pe-3">
                    <span class="c-demo-description">in this component we use CategoryId parameter in grid filtering and set category property of upsertProduct field on form submit.</span>
                </div>
                <div class="col-md-7">
                    <DataGrid TEntity="Product" Service="Service" ConditionExpr="t => t.ProductCategoryId == CategoryId" ContentHeight="300">
                        <Columns>
                            <GridColumn Field="t => t.Title" />
                            <GridColumn Field="t => t.Price.Seprate3Digit()" />
                            <GridCommandColumns />
                        </Columns>
                    </DataGrid>
                    <Window Service="Service" Title="Product CRUD" Style="width:500px">
                        <CaspianForm TEntity="Product" Service="Service" OnSubmit="SetCategory">
                            <Content Context="product">
                                <div class="row c-controls p-3">
                                    <StringTextBox @bind-Value="product.Title" ColSpan="8" />
                                    <NumericTextBox @bind-Value="product.Price" ColSpan="8" />
                                    <NumericTextBox @bind-Value="product.TakeoutPrice" ColSpan="8" />
                                    <MultiSelectBox @bind-Value="product.Meal" ColSpan="8" />
                                    <DropdownList @bind-Value="product.ActiveType" ColSpan="8" />
                                    <div class="col-md-8 align-content-center">
                                        <WindowCommandButtons />
                                    </div>
                                </div>
                            </Content>
                        </CaspianForm>
                    </Window>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <div style="height:calc(100vh - 130px);overflow:auto">
                <Document FolderName="Crud" FileName="PopupCrud1" />
            </div>
        </TabPanelItem>
    </Tabs>
</TabPanel>
@code
{
    [Parameter]
    public int CategoryId { get; set; }

    void SetCategory(Product product)
    {
        product.ProductCategoryId = CategoryId;
    }
}
