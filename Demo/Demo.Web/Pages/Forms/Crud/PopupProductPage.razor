@inject IUIService<Product> Service

<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="row pb-3 pe-3">
                <div class="col-md-5 pt-5 ps-3 pe-3">
                    <span class="c-demo-description">in this component we use CategoryId parameter in grid filtering and set category property of upsertProduct field on form submit.</span>
                </div>
                <div class="col-md-7 pt-3">
                    <DataGrid TEntity="Product" Service="Service" ConditionExpr="t => t.ProductCategoryId == CategoryId" ContentHeight="300">
                        <Columns>
                            <GridColumn Field="t => t.Title" />
                            <GridColumn Field="t => t.Price.DigitGrouping()" />
                            <GridCommandColumns />
                        </Columns>
                    </DataGrid>
                    <Window Service="Service" Title="Product CRUD" Style="width:500px">
                        <CaspianForm TEntity="Product" Service="Service" OnSubmit="SetCategory">
                            <StringTextBox @bind-Value="context.Title" ColSpan="8" />
                            <NumericTextBox @bind-Value="context.Price" ColSpan="8" DigitGrouping />
                            <NumericTextBox @bind-Value="context.TakeoutPrice" ColSpan="8" DigitGrouping />
                            <MultiSelectBox @bind-Value="context.Meal" ColSpan="8" />
                            <DropdownList @bind-Value="context.ActiveType" ColSpan="8" />
                            <WindowCommandButtons ColSpan="8" />
                        </CaspianForm>
                    </Window>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <div style="height:calc(100vh - 130px);overflow:auto">
                <Document FolderName="Crud" FileName="PopupCrud1" />
            </div>
        </TabPanelItem>
    </Tabs>
</TabPanel>
@code
{
    [Parameter]
    public int CategoryId { get; set; }

    void SetCategory(CancelableEvent<Product> e)
    {
        e.Entity.ProductCategoryId = CategoryId;
    }

    [Parameter]
    public BasePage Page { get; set; }

    protected override void OnInitialized()
    {
        Service.OnUpsert = async (provider, product) => product.Id > 0 || product.Price > 0 && product.TakeoutPrice > 0 || await Page.Confirm("آیا با ثبت موافقید؟");
        base.OnInitialized();
    }
}
