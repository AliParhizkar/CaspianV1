@page "/Demo/Relation1to1to1Crud/{EmployeeId:int}"
@inherits BasePage
@attribute [Source(45, "Relation1to1to1 Crud")]
@inject IUIService<Employee> Service
<p>
    In this example, We use the <b>EntityTabPanel</b> component used in new page
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div style="width:850px;margin: 20px auto">
                <Relation1to1Component Page="this" />
            </div>
        </TabPanelItem>
    </Tabs>
</TabPanel>


@code
{
    protected override void OnInitialized()
    {
        Service.MasterId = EmployeeId;
        base.OnInitialized();
    }

    [Parameter]
    public int EmployeeId { get; set; }
}
