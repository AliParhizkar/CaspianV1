@page "/Demo/MultipleCrud"
@namespace Demo.Web
@inherits BasePage
@inject UIService<ProductCategory> CategoryService
@inject UIService<Product> ProductService
@inject UIService<ProductDescription> DescriptionService
@{
    base.BuildRenderTree(__builder);
}
<h2>Multiple CRUD on page</h2>
<p>
    In this example we create two CRUDs on the page (product category and product) these entities are the master-details.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="p-3">
                <div class="d-content">
                    <span class="c-demo-description">
                        When selecting a row of product category grid, the CRUD of the product is displayed. 
                        We use the ShowProductGrid method for this, it sets the productcategoryId field to filter the product grid and reloads the product grid.
                    </span>
                </div>
                <CaspianContainer>
                    <StringTextBox @bind-Value="CategoryService.Search.Title" ColSpan="8" Search />
                </CaspianContainer>
                <DataGrid TEntity="ProductCategory" Service="CategoryService" ContentHeight="208" OnRowSelect="ShowProductGrid">
                    <Columns>
                        <GridColumn Field="t => t.Title" />
                        <GridColumn Field="t => t.Code"  />
                        <GridColumn Field="t => t.ActiveType.EnumText()" />
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
                <Window Title="Product Category" Service="CategoryService" Style="width:500px">
                    <CaspianForm Service="CategoryService">
                        <Content Context="category">
                            <StringTextBox @bind-Value="category.Title" ColSpan="8" />
                            <DropdownList @bind-Value="category.ActiveType" ColSpan="8" />
                            <div class="col-md-8">
                                <WindowCommandButtons />
                            </div>
                        </Content>
                    </CaspianForm>
                </Window>
                @if (productcategoryId.HasValue)
                {
                    <div class="c-continner-head">
                        <span>@productTitle</span>
                    </div>
                    <ul class="d-demo-list m-4 ">
                        <li>
                            We set the ConditionExpr parameter to filter the product grid.
                        </li>
                        <li>
                            We set OnSubmit parameter to set CategoryId property of upsertProduct field.
                        </li>
                    </ul>

                    <div class="row c-controls ps-4 pe-4">
                        <CaspianContainer>
                            <StringTextBox @bind-Value="ProductService.Search.Title" Search ColSpan="8" />
                        </CaspianContainer>
                    </div>
                    <DataGrid Service="ProductService" TEntity="Product" ContentHeight="206" ConditionExpr="t => t.ProductCategoryId == productcategoryId">
                        <Columns>
                            <GridColumn Field="t => t.Title" />
                            <GridColumn Field="t => t.Price.Seprate3Digit()" />
                            <GridColumn Field="t => t.TakeoutPrice.Seprate3Digit()" />
                            <GridColumn Field="t => t.Code" />
                            <GridColumn Field="t => t.ActiveType.EnumText()" />
                            <GridColumn Title="شرح پیشفرض" style="width:80px">
                                <Template>
                                    <button class="c-btn c-primary" @onclick="() => OpenDescriptionWindow(context.Data.Id)">...</button>
                                </Template>
                            </GridColumn>
                            <GridCommandColumns />
                        </Columns>
                    </DataGrid>
                    <Window Service="ProductService" Title="Product" Style="width:650px">
                        <CaspianForm TEntity="Product" Service="ProductService" OnSubmit="t => SetCategory(t)">
                            <Content Context="product">
                                <div class="row p-3 pe-0">
                                    <div class="col-md-7 row c-controls ">
                                        <StringTextBox @bind-Value="product.Title" ColSpan="8" />
                                        <NumericTextBox @bind-Value="product.Price" ColSpan="8" />
                                        <NumericTextBox @bind-Value="product.TakeoutPrice" ColSpan="8" />
                                        <MultiSelectBox @bind-Value="product.Meal" ColSpan="8" />
                                        <NumericTextBox @bind-Value="product.Code" ColSpan="8" />
                                        <DropdownList @bind-Value="product.ActiveType" ColSpan="8" />
                                        <CheckBox @bind-Value="product.Discountable" ColSpan="8" />
                                    </div>
                                    <div class="col-md-5 ps-4">
                                        <div class="col-md-12 justify-content-center d-flex">
                                            <Fileupload OnChange="e => SetImage(e, product)">
                                                <PictureBox Data="product.Image" style="width:200px;height:200px" />
                                            </Fileupload>
                                        </div>
                                        <div class="justify-content-center d-flex pt-2">
                                            <WindowCommandButtons />
                                        </div>
                                    </div>

                                </div>
                            </Content>
                        </CaspianForm>
                    </Window>
                }
                else
                {
                    <div class="text-center p-5 c-continner-head">
                        <span>
                            Please select a category to display its products
                        </span>
                    </div>
                }
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document FolderName="Crud" FileName="MultipleCrud" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
<Window @bind-Status="status" Title="شرح های پیش فرض" Style="width:550px">
    <CaspianForm TEntity="ProductDescription" Service="DescriptionService" OnSubmit="t => t.ProductId = productId">
        <StringTextBox @bind-Value="context.Description" MultiLine Rows="2" ColSpan="8" />
        <div class="text-center col-md-9">
            <FormCommandButton />
        </div>
    </CaspianForm>
    <DataGrid TEntity="ProductDescription" Service="DescriptionService" ConditionExpr="t => t.ProductId == productId" ContentHeight="200">
        <Columns>
            <GridColumn Field="t => t.Description" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</Window>
@code 
{
    WindowStatus status;
    string productTitle;
    int productId;
    int? productcategoryId;

    void OpenDescriptionWindow(int productId)
    {
        this.productId = productId;
        status = WindowStatus.Open;
    }

    void SetCategory(Product product)
    {
        product.ProductCategoryId = productcategoryId.Value;
    }

    async Task SetImage(InputFileChangeEventArgs e, Product product)
    {
        product.Image = await e.File.GetByteArrayAsync();
    }

    async void ShowProductGrid(ProductCategory category)
    {
        productcategoryId = category.Id;
        productTitle = category.Title;
        await Task.Delay(1);
        await ProductService.DataView.ReloadAsync();
    }
}
