@page "/Demo/Meeting"
@namespace Demo.Web.Pages
@inherits BasePage
@attribute [Page(40, "Meeting")]
@inject IUIService<Meeting> Service

@{
    base.BuildRenderTree(__builder);
}


<ListView Service="Service" TEntity="Meeting" SelectType="SelectType.None" ContentHeight="600">
    <Fields Context="meeting">
        @{
            var className = "d-main";
            if (meetingsId.Any(t => t == meeting?.Data?.Id))
                className += " open";
        }
        <div class="@(className)">
            <div class="d-number" @onmousedown="() => ToggleList(meeting.Data.Id)">
                <TextField Field="t => t.OrderNo.ToString()" />
            </div>
            <div class="d-name" @onmousedown="() => ToggleList(meeting.Data.Id)">
                <TextField Field="t => t.Name" />
            </div>
            <div @onmousedown="() => ToggleList(meeting.Data.Id)" class="d-icon">
                <span class="fa fa-chevron-up"></span>
            </div>
            <div class="d-details">
                <div class="d-title">جزئیات</div>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <div class="d-lecture-detail">
                            <label>ایجاد کننده:</label>
                            <TextField Field="t => t.User.LName" />
                        </div>
                        <div class="d-lecture-detail">
                            <label>ضبط فیلم:</label>
                            <TextField Field='t => t.RecordingVideoIs ? "فعال" : "غیرفعال"' />
                        </div>
                        <div class="d-lecture-detail">
                            <label>وضعیت:</label>
                            <TextField Field='t => t.ActiveIs ? "فعال" : "غیرفعال"' />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-lecture-detail">
                            <label>حوزه آموزش:</label>
                            <TextField Field='t => t.LearningScope.EnumText()' />
                        </div>
                        <div class="d-lecture-detail">
                            <label>ضبط صدا:</label>
                            <TextField Field='t => t.RecordingAudioIs ? "فعال" : "غیرفعال"' />
                        </div>
                        <div class="d-lecture-detail">
                            <label>نوع سرویس:</label>
                            <TextField Field='t => t.ServerType.EnumText()' />
                        </div>
                    </div>
                    <div class="col-md-3"></div>
                    <div class="col-md-9">
                        <button @onclick='() => NavigationManager.NavigateTo($"/Demo//{meeting.Data.Id}")' class="c-btn c-secondary">
                            Details
                            <span class="fa fa-wpforms"></span>
                        </button>
                        <ListCommandButton />
                    </div>
                </div>
            </div>
        </div>
    </Fields>
</ListView>
<Window Service="Service" Style="width:600px">
    <CaspianForm TEntity="Meeting" Service="Service" OnSubmit="t => t.Entity.UserId = base.UserId">
        <Content Context="meeting">
            <div class="row c-controls ps-2 pe-2">
                <StringTextBox MultiLine Rows="3" @bind-Value="meeting.Name" ColSpan="9" />
                <CheckBox @bind-Value="meeting.RecordingVideoIs" Title="ضبط فیلم" ColSpan="9" />
                <CheckBox @bind-Value="meeting.RecordingAudioIs" Title="ضبط صدا" ColSpan="9" />
                <CheckBox @bind-Value="meeting.ActiveIs" Title="فعال" ColSpan="9" />
                <DropdownList @bind-Value="meeting.LearningScope" ColSpan="9" />
                <DropdownList @bind-Value="meeting.ServerType" ColSpan="9" />
                <div class="col-md-9 pt-3">
                    <FormCommandButton />
                </div>
            </div>
        </Content>
    </CaspianForm>
</Window>


@code
{
    IList<int> meetingsId;

    void ToggleList(int id)
    {
        if (meetingsId.Contains(id))
            meetingsId.Remove(id);
        else
            meetingsId.Add(id);
    }

    protected override void OnInitialized()
    {
        meetingsId = new List<int>();
        base.OnInitialized();
    }
}
