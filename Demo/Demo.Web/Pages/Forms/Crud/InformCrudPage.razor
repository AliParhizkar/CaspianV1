@page "/Demo/InformCrud"
@namespace Demo.Web
@inherits BasePage
@inject UIService<Product> Service
@{
    base.BuildRenderTree(__builder);
}
<h2>Inform CRUD</h2>
<p>
    In this example, instead of a <b>pop-up window</b>, we place the form on the page. 
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="ps-3 pe-3">
                <CaspianForm Service="Service" TEntity="Product" OnReset="t => t.Image = null" ColumnsCount="2">
                    <Content Context="product">
                        <div class="row pt-3">
                            <div class="row col-md-9 c-controls align-content-start">
                                <ComboBox TEntity="ProductCategory" TValue="int" @bind-Value="product.ProductCategoryId" TextExpression="t => t.Title"
                                          OrderByExpression="t => t.Title" ColSpan="4" />
                                <StringTextBox @bind-Value="product.Title" ColSpan="4" />
                                <NumericTextBox @bind-Value="product.Price" ColSpan="4" />
                                <NumericTextBox @bind-Value="product.TakeoutPrice" ColSpan="4" />
                                <StringTextBox @bind-Value="product.Code" ColSpan="4" />
                                <CheckBox @bind-Value="product.Discountable" ColSpan="4" />
                                <MultiSelectBox @bind-Value="product.Meal" ColSpan="10" />
                                <DropdownList @bind-Value="product.ActiveType" ColSpan="4" />
                                <div class="col-md-6 align-content-center">
                                    <FormCommandButton />
                                </div>
                            </div>
                            <div class="col-md-3 ps-4 align-content-center">
                                <Fileupload OnChange="async e => await SetImage(e, product)">
                                    <PictureBox Data="product.Image" style="width:200px;height:200px" />
                                </Fileupload>
                            </div>
                        </div>
                    </Content>
                </CaspianForm>
                <DataGrid Service="Service" TEntity="Product" ContentHeight="250">
                    <Columns>
                        <GridColumn Field="t => t.ProductCategory.Title" Title="Product category" />
                        <GridColumn Field="t => t.Title" />
                        <GridColumn Field="t => t.ActiveType.EnumText()" />
                        <GridColumn Field="t => t.Price.Seprate3Digit()" />
                        <GridColumn Field="t => t.TakeoutPrice.Seprate3Digit()" />
                        <GridColumn Field="t => t.Discountable.ToString()" />
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document FolderName="Crud" FileName="InformCrud" />
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Service">
            <Document FolderName="Service/Services" FileName="ProductService" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
@code
{
    async Task SetImage(InputFileChangeEventArgs e, Product product)
    {
        product.Image = await e.File.GetByteArrayAsync();
    }
}
