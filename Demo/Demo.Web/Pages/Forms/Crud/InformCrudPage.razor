@page "/Demo/InformCrud"
@namespace Demo.Web
@inherits BasePage
@inject IUIService<Product> Service
@{
    base.BuildRenderTree(__builder);
}
<h2>Inform CRUD</h2>
<p>
    In this example, instead of a <b>pop-up window</b>, we place the form on the page. 
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="ps-3 pe-3 pb-2">
                <CaspianForm Service="Service" TEntity="Product" OnReset="ResetForm" ColumnsCount="2">
                    <div class="row pt-3">
                        <div class="row col-md-9 c-controls align-content-start">
                            <ComboBox TEntity="ProductCategory" TValue="int" @bind-Value="context.ProductCategoryId" TextExpression="t => t.Title"
                            OrderByExpression="t => t.Title" ColSpan="4" />
                            <StringTextBox @bind-Value="context.Title" ColSpan="4" />
                            <NumericTextBox @bind-Value="context.Price" ColSpan="4" />
                            <NumericTextBox @bind-Value="context.TakeoutPrice" ColSpan="4" />
                            <StringTextBox @bind-Value="context.Code" ColSpan="4" />
                            <CheckBox @bind-Value="context.Discountable" ColSpan="4" />
                            <MultiSelectBox @bind-Value="context.Meal" ColSpan="10" />
                            <DropdownList @bind-Value="context.ActiveType" ColSpan="4" />
                            <FormCommandButton ColSpan="6" TotalSpan="6" />
                        </div>
                        <div class="col-md-3 ps-4 align-content-center">
                            <Fileupload OnChange="async e => await SetImage(e, context)">
                                <PictureBox Data="context.Image" style="width:200px;height:200px" />
                            </Fileupload>
                        </div>
                    </div>
                </CaspianForm>
                <DataGrid Service="Service" TEntity="Product" ContentHeight="250">
                    <Columns>
                        <GridColumn Field="t => t.ProductCategory.Title" Title="Product category" />
                        <GridColumn Field="t => t.Title" />
                        <GridColumn Field="t => t.ActiveType.EnumText()" />
                        <GridColumn Field="t => t.Price.Seprate3Digit()" />
                        <GridColumn Field="t => t.TakeoutPrice.Seprate3Digit()" />
                        <GridColumn Field="t => t.Discountable.ToString()" />
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document FolderName="Crud" FileName="InformCrud" />
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Service">
            <Document FolderName="Service/Services" FileName="ProductService" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
@code
{
    void ResetForm(Product product)
    {
        if (product != null)
            product.Image = null;
    }

    async Task SetImage(InputFileChangeEventArgs e, Product product)
    {
        product.Image = await e.File.GetByteArrayAsync();
    }
}
