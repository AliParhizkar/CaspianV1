@page "/Demo/DistributedCrud"
@namespace Demo.Web.Pages
@attribute [Source(38, "Distributed Crud")]
@inherits BasePage
@inject IUIService<ProductCategory> CategoryService
@inject IUIService<Product> Service
@{
    base.BuildRenderTree(__builder);
}
<h2>Distributed CRUD</h2>
<p>
    In this example, the ProductCategoryId is updated outside of the form.
    <br />The advantage of this form is that we can set the product category once, and insert many products.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="row d-content">
                <div class="col-md-4 pt-5 pe-3">
                    <span class="c-demo-description">
                        We bind <b>ProductCategoryId</b> property of upsertProduct to combobox, the combobox is placed outside the form.
                    </span>
                </div>
                <div class="col-md-8">
                    <div class="c-controls c-header row align-items-center">
                        <CaspianContainer>
                            <ComboBox TEntity="ProductCategory" TValue="int?" Value="categoryId" TextExpression="t => t.Title"
                                      ColSpan="8" ValueChanged="CategoryChanged" Title="گروه محصول" />
                        </CaspianContainer>
                    </div>
                    <div class="c-body ps-3 pe-3">
                        @if (categoryId.HasValue)
                        {
                            <DataGrid TEntity="Product" Service="Service" ContentHeight="350"
                                      ConditionExpr="@(t => t.ProductCategoryId == categoryId)">
                                <Columns>
                                    <GridColumn Field="t => t.Title" />
                                    <GridColumn Field="t => t.ActiveType.EnumText()" style="width:80px;" />
                                    <GridColumn Field="t => t.Price.DigitGrouping()" style="width:110px" />
                                    <GridColumn Field="t => t.TakeoutPrice.DigitGrouping()" style="width:110px" />
                                    <GridCommandColumns />
                                </Columns>
                            </DataGrid>
                            <Window Service="Service" Title="Product" Style="width:500px;">
                                <CaspianForm TEntity="Product" Service="Service" OnSubmit="t => t.Entity.ProductCategoryId = categoryId.Value">
                                    <Content Context="product">
                                        <div class="row c-controls ps-3 pe-3">
                                            <StringTextBox @bind-Value="product.Title" ColSpan="8" />
                                            <NumericTextBox @bind-Value="product.Price" ColSpan="8" />
                                            <NumericTextBox @bind-Value="product.TakeoutPrice" ColSpan="8" />
                                            <MultiSelectBox @bind-Value="product.Meal" ColSpan="8" />
                                            <CheckBox @bind-Value="product.Discountable" ColSpan="8" />
                                            <DropdownList @bind-Value="product.ActiveType" ColSpan="8" />
                                            <div class="col-md-18 justify-content-center">
                                                <WindowCommandButtons />
                                            </div>
                                        </div>
                                    </Content>
                                </CaspianForm>
                            </Window>
                        }
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document Page="this" FolderName="Crud" FileName="DistributedCrud" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
@code
{
    int? categoryId;
    void CategoryChanged(int? categoryId)
    {
        this.categoryId = categoryId;
        if (categoryId.HasValue)
            Service.DataView?.EnableLoading();
    }
}
