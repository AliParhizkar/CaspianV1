@namespace Demo.Web.Pages
@attribute [Source(37, "Cities")]
@page "/Demo/City/{CountryId:int}"
@inherits BasePage
@inject IUIService<City> Service

@{
    base.BuildRenderTree(__builder);
}
<p>
    In this example we have the CountryId as the url parameter and use it to set the CountryId property of the city on form submit.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="p-4 pb-0">
                <div class="c-data-containner row c-controls">
                    <div class="col-md-1 ps-2">
                        <IconButton Small IconType="IconType.ArrowLeft" Href="/Demo/ParameterCrud" />
                    </div>
                    <div class="col-md-3 pe-3">
                        <label>Country</label>
                    </div>
                    <div class="col-md-8">
                        <span>@country?.Title</span>
                    </div>
                </div>
                <EntitySearch Service="Service" ColumnsCount="2">
                    <StringTextBox @bind-Value="context.Title" ColSpan="4" />
                    <DropdownList @bind-Value="context.ActiveType" ColSpan="4" />
                </EntitySearch>
            </div>
            <div class="p-4 pt-1">
                <DataGrid TEntity="City" Service="Service" ConditionExpr="t => t.CountryId == CountryId" ContentHeight="350">
                    <Columns>
                        <GridColumn Field="t => t.Title" />
                        <GridColumn Field="t => t.ActiveType.EnumText()" />
                        <GridCommandColumns />
                    </Columns>
                </DataGrid>
            </div>
            <Window Service="Service" Title="City" Style="width:450px">
                <CaspianForm TEntity="City" Service="Service" OnSubmit="SetCountryId">
                    <StringTextBox @bind-Value="context.Title" ColSpan="8" />
                    <DropdownList @bind-Value="context.ActiveType" ColSpan="8" />
                    <FormCommandButton ColSpan="8" />
                </CaspianForm>
            </Window>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document Page="this" FolderName="Crud" FileName="ParameterCrud2" />
        </TabPanelItem>
    </Tabs>
</TabPanel>

@code
{
    Country country;
    void SetCountryId(CancelableEvent<City> e)
    {
        e.Entity.CountryId = CountryId;
    }

    protected override async Task OnInitializedAsync()
    {
        using var service = CreateScope().GetService<CountryService>();
        country = await service.SingleAsync(CountryId);
        await base.OnInitializedAsync();
    }

    [Parameter]
    public int CountryId { get; set; }
}
