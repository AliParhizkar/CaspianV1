@inject UIService<CourseStudy> Service
<EntitySearch Service="Service" ColumnsCount="2">
    <StringTextBox @bind-Value="context.Title" ColSpan="4" />
</EntitySearch>
<div class="p-2">
    <DataGrid TEntity="CourseStudy" Service="Service" ContentHeight="200">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>
<Window Service="Service" Title="Course Study" Style="width:450px">
    <CaspianForm TEntity="CourseStudy" Service="Service">
        <Content Context="course">
            <StringTextBox @bind-Value="course.Title" ColSpan="8" />
            <div class="col-md-9 align-content-center">
                <FormCommandButton />
            </div>
        </Content>
    </CaspianForm>
</Window>

