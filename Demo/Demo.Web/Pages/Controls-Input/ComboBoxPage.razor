@page "/Demo/ComboBox"
@namespace Demo.Web.Pages
@using Caspian.Engine.Model
@attribute [Source(8, "Combo Box")]
@inherits BasePage
<h2>Combobox</h2>
<p>
    This control is a <b>key-value control</b> that is <b>usually bind to entity</b> type, although it can use the <b>SelectListItem list as a resource</b>.
</p>
<h3>Binding</h3>
<p>
    We can bind this control to <b>any data type</b>. It is usually used to <b>determine the foreign key.</b> and its data is <b>fetched from table</b>. Because it is a <b>Key-Value control</b>, the <b>entity's primary key is KEY</b> and <b>VALUE must be specified by the programmer</b>.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Bind to string</h4>
                        <span class="c-demo-description">In this example, we fill combobox from <b>Source parameter</b> and bind it to <b>string</b>.</span>
                    </div>
                    <div class="col-md-6">
                        <div class="row c-controls ps-5 pe-2">
                            <ComboBox TEntity="SelectListItem" TValue="string" @bind-Value="CountryId" Source="countries" ColSpan="8" Title="Country" TotalSpan="12" />
                            <div class="col-md-4">
                                <label>Country id</label>
                            </div>
                            <div class="col-md-8 text-center">
                                <label style="color:red;">@(CountryId ?? "---")</label>
                            </div>
                            <div class="col-md-4">
                                <label>Country id</label>
                            </div>
                            <div class="col-md-8 text-center">
                                @if (countries != null)
                                {
                                    <label style="color:red;">@(countries.SingleOrDefault(t => t.Value == CountryId)?.Text ?? "---")</label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document Page="this" FolderName="ComboBox" FileName="Binding" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
<h3 class="pt-3">Data Binding & Search</h3>
<p>
    We can easily bind the control to the entity, we know that the combo box is a Key-Value control, the <b>key of the entity is Key</b>, and the programmer can easily <b>determine the Value as Expression</b>.
    <br />Because we are <b>searching on the database</b>, we have <b>no limit on the number of records</b> in the table.

</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Simple expression</h4>
                        <span class="c-demo-description">
                            In this example we specify <b>TEntity parameter</b>, (the type of entity the control binds to it) and also set <b>TextExpression parameter</b> (that is a <b>Lambda Expression</b> and <b>has intellisense</b>)
                            <b>country tittle set as text</b>.
                        </span>
                    </div>
                    <div class="col-md-6">
                        <div class="row c-controls ps-5 pe-2">
                            <ComboBox TEntity="Country" TValue="int?" @bind-Value="countryId" TextExpression="t => t.Title" Title="Country" ColSpan="8" TotalSpan="12" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <h4>Property expression</h4>
                        <span class="c-demo-description">
                            In this example, we set the TEntity to City and set TextExpression parameter with the Country title concat the City title.
                        </span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="row c-controls ps-5 pe-2">
                            <ComboBox TEntity="City" TValue="int?" @bind-Value="cityId" TextExpression="t => t.Country.Title + ' ' + t.Title" Title="Country city" ColSpan="8" TotalSpan="12" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <h4>Complex expression</h4>
                        <span class="c-demo-description">
                            In this example, we set the TEntity to Customer and set TextExpression parameter
                        </span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="row c-controls ps-5 pe-2">
                            <ComboBox TEntity="Customer" TValue="int?" @bind-Value="customerId" Title="Customer" ColSpan="8" TotalSpan="12"
                                      TextExpression='t => t.CustomerType == CustomerType.Real ? t.FName + " " + t.LName : t.CompanyName' />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <h4>Custom Templat</h4>
                        <span class="c-demo-description">
                            In this example, we use custom template
                        </span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="row c-controls ps-5 pe-2">
                            <ComboBox TValue="int" TEntity="MenuCategory" @bind-Value="menuCategoryId" TextExpression="t => t.Title"
                                      Title="Menu Category" ColSpan="8" TotalSpan="12">
                                <Template Context="Category">
                                    <div class="d-menu-categories">
                                        <TextField Field="t => t.IconFont">
                                            <Template>
                                                <i class="d-icon @(context)"></i>
                                            </Template>
                                        </TextField>
                                        <TextField Field="t => t.Title" />
                                    </div>
                                </Template>
                            </ComboBox>
                        </div>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document Page="this" FolderName="ComboBox" FileName="DataBinding" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
<h3 class="pt-3">Filtering and sorting</h3>
<p>
    We can <b>filter</b> and <b>sort </b>(<b>increment and decrease</b>) Combobox data.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Filtering</h4>
                        <span class="c-demo-description">
                            In this example, we <b>filter customers</b> in a <b>real and legal</b> way.
                        </span>
                    </div>
                    <div class="col-md-6">
                        <div class="row c-controls ps-5 pe-2">
                            <ComboBox TEntity="Customer" TValue="int?" @bind-Value="customerId" Title="Real customer" ColSpan="8" TotalSpan="12"
                                      TextExpression='t => t.FName + " " + t.LName' ConditionExpression="t => t.CustomerType == CustomerType.Real" />
                            <ComboBox TEntity="Customer" TValue="int?" @bind-Value="customerId" Title="legal customer" 
                                      TextExpression="t => t.CompanyName" ConditionExpression="t => t.CustomerType == CustomerType.Legal" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <h4>Sorting</h4>
                        <span class="c-demo-description">
                            In this example, we <b>sort the countries</b> in <b>ascending</b> and <b>descending</b> order
                        </span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="row c-controls ps-5 pe-2">
                            <ComboBox TEntity="Country" TValue="int?" @bind-Value="countryId" Title="Ascending sort" ColSpan="8" TotalSpan="12"
                                      TextExpression="t => t.Title" OrderByExpression="t => t.Title" />
                            <ComboBox TEntity="Country" TValue="int?" @bind-Value="countryId" Title="Descending sort" ColSpan="8" TotalSpan="12"
                                      TextExpression="t => t.Title" OrderByExpression="t => t.Title" SortType="SortType.Decs" />
                        </div>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document Page="this" FolderName="ComboBox" FileName="FilteringSorting" />
        </TabPanelItem>
    </Tabs>
</TabPanel>

<h3 class="pt-4">General properties</h3>
<p>
    We can specify <b>general properties</b> such as <b>width</b> and <b>disable</b>. if we do not specify the width of the control, its width will be 100% and fit to parent. And also this component automatically drop down, or up based on its position.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Width property</h4>
                        <span class="c-demo-description">By setting the <b>Style</b> parameter, we can easily <b>change width</b> and other css properties of the control. it has <b>intellisense</b> for css properties</span>
                    </div>
                    <div class="col-md-6">
                        <div class="row c-controls c-demo-control">
                            <DropdownList @bind-Value="controlSize" ColSpan="8" TotalSpan="12" Title="Control size" />
                            <div class="ps-2 pe-2">
                                <ComboBox TEntity="Country" TValue="int?" @bind-Value="countryId" TextExpression="t => t.Title" Style="@GetStyle()" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <h4>Disable control</h4>
                        <span class="c-demo-description">By setting the <b>Disabled</b> parameter, we can easily <b>enable & disable</b> the control. This parameter is a <b>boolean</b> parameter</span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="row c-controls c-demo-control">
                            <CheckBox @bind-Value="disable" ColSpan="8" TotalSpan="12" Title="Enable/Disable" />
                            <div class="col-md-4 ps-2">
                                <label>Action</label>
                            </div>
                            <div class="col-md-8 text-center">
                                <button class="c-btn c-primary" @onclick="async () => await cmbCountry.FocusAsync()">Focus</button>
                            </div>
                            <div class="col-md-12 ps-2 pe-2">
                                <ComboBox TEntity="Country" TValue="int?" @ref="cmbCountry" @bind-Value="countryId" Disabled="disable" TextExpression="t => t.Title" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Source">
            <Document Page="this" FolderName="ComboBox" FileName="Generalproperties" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
<h3 class="pt-3">Cascade combobox</h3>
<p>
    We can use <b>CascadeService</b> to <b>cascade two or three comboboxes</b>, it is a <b>transient service</b> and can be <b>injected into the page</b>.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Cascade combobox (Two combobox)</h4>
                        <span class="c-demo-description">In this example we use productCascadeService CascadeService to create the cascade combobox</span>
                    </div>
                    <div class="col-md-6">
                        <div class="row c-controls c-demo-control">
                            <ComboBox TEntity="ProductCategory" CascadeService="productCascadeService" TValue="int?" @bind-Value="productCategoryId"
                                      TextExpression="t => t.Title" ColSpan="8" TotalSpan="12" Title="Product Category" />
                            <ComboBox TEntity="Product" TValue="int?" CascadeService="productCascadeService" @bind-Value="productId"
                                      TextExpression="t => t.Title" ColSpan="8" TotalSpan="12" Title="Product" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <h4>Cascade combobox (three combobox)</h4>
                        <span class="c-demo-description">In this example we use CityCascadeService CascadeService to create the cascade combobox</span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="row c-controls c-demo-control">
                            <ComboBox TEntity="Country" CascadeService="countryCascadeService " TValue="int?" @bind-Value="countryId"
                                      TextExpression="t => t.Title" ColSpan="8" TotalSpan="12" Title="Country" />
                            <ComboBox TEntity="Province" TValue="int?" CascadeService="countryCascadeService " @bind-Value="provinceId"
                                      TextExpression="t => t.Title" ColSpan="8" TotalSpan="12" Title="Province" />
                            <ComboBox TEntity="City" TValue="int?" CascadeService="countryCascadeService " @bind-Value="cityId"
                                      TextExpression="t => t.Title" ColSpan="8" TotalSpan="12" Title="City" />
                        </div>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document Page="this" FolderName="ComboBox" FileName="Cascade" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
<h3 class="pt-3">Custom cascade</h3>
<p>
    We can create a <b>custom cascade</b>, using the <b>combo box filter feature</b>. With <b>any changes to the master control</b>, combo box  <b>data must be reloaded</b> from the database.
    <span class="fa fa-info"></span>note: After any change in the filter parameters, we need to reload the data from the database.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Custome Cascade</h4>
                        <span class="c-demo-description">In this example we injected the CascadeService and used it to create the cascade combobox.</span>
                    </div>
                    <div class="col-md-6">
                        <div class="row c-controls c-demo-control">
                            <DropdownList @bind-Value="customerType" OnChange="() => cmbCustomer.EnableLoading()" ColSpan="8" TotalSpan="12"
                                          Title="Customer type" />
                            <ComboBox TEntity="Customer" TValue="int?" @ref="cmbCustomer" @bind-Value="customerId" ColSpan="8" TotalSpan="12" Title="Customer"
                                      TextExpression='t => t.CustomerType == CustomerType.Real ? t.FName + " " + t.LName : t.CompanyName' ConditionExpression="t => t.CustomerType == customerType" />

                        </div>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document Page="this" FolderName="ComboBox" FileName="CustomCascade" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
@code
{
    bool disable;
    int menuCategoryId;
    IList<SelectListItem> countries;
    string CountryId;
    ControlSize controlSize = ControlSize.Auto;
    CustomerType customerType = CustomerType.Real;
    int? customerId;
    int? countryId;
    int? provinceId;
    int? cityId;
    int? productCategoryId;
    int? productId;
    ComboBox<Country, int?> cmbCountry;
    ComboBox<Customer, int?> cmbCustomer;
    CascadeService<ProductCategory, Product> productCascadeService = new();
    CascadeService<Country, Province, City> countryCascadeService = new();

    string GetStyle()
    {
        switch (controlSize)
        {
            case ControlSize.Large:
                return "width:300px";
            case ControlSize.Medium:
                return "width:200px";
            case ControlSize.Small:
                return "width:150px";
            case ControlSize.Auto:
                return "";
        }
        throw new NotImplementedException();
    }

    protected override async Task OnInitializedAsync()
    {
        using var service = CreateScope().GetService<CountryService>();
        countries = await service.GetAll().Select(t => new SelectListItem()
        {
            Value = t.Id.ToString(),
            Text = t.Title
        }).ToListAsync();
        await base.OnInitializedAsync();
    }
}