@namespace Demo.Web
@page "/Demo/Grid-Search"
<h2>Grid-Searching</h2>
@inherits BasePage
@inject ISearchService<Customer> Service
@inject ISearchService<City> CityService
@inject ISearchService<OrderDetail> OrderDetailService

<p>
    We can search in the grid in the <b>three Modes</b>
    In this page we <b>describe this modes</b>.
</p>
<h3 class="pt-3">Search on string enum and foreign key</h3>
<p>
    We can easily search on <b>string</b>, <b>enum</b> and <b>foreign key</b>. It is enough to <b>define a variable of type TEntity</b> and set <b>Search parameter</b>.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6 pe-4">
                        <h4>Search on string type(Start-with, Contain, End-with)</h4>
                        <span class="c-demo-description">In this example, we define a variable of <b>Customer type</b> and <b>bind first name, last name and company name and mobile numer</b> for search. </span>
                        <span class="fa fa-info">Note: </span>
                        <span><b>Mobile number</b> search is <b>Start-with</b> search other search is <b>Contain</b></span>
                    </div>
                    <div class="col-md-6">
                        <EntitySearch TEntity="Customer" Service="Service">
                            <StringTextBox @bind-Value="context.FName" ColSpan="8" />
                            <StringTextBox @bind-Value="context.LName" ColSpan="8" />
                            <StringTextBox @bind-Value="context.CompanyName" ColSpan="8" />
                            <StringTextBox @bind-Value="context.MobileNumber" SearchType="SearchType.StartWith" ColSpan="5" TotalSpan="9" />
                            <div class="col-md-2">
                                <span class="fa fa-info ps-1"></span>
                                <span>Start-with</span>
                            </div>
                        </EntitySearch>
                        <div class="pt-3">
                            <DataGrid TEntity="Customer" Service="Service" ShowInsertIcon="false">
                                <Columns>
                                    <GridColumn Field="t => t.CustomerType.EnumText()" />
                                    <GridColumn Field="t => t.FName" />
                                    <GridColumn Field="t => t.LName" />
                                    <GridColumn Field="t => t.CompanyName" />
                                    <GridColumn Field="t => t.MobileNumber" />
                                </Columns>
                            </DataGrid>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <h4>Search on enum</h4>
                        <span class="c-demo-description">
                            In this example, we use <b>customer type</b> and <b>gender</b> for search.
                        </span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="row c-controls">
                            <div class="ps-2 col-md-4">
                                <label>Selection Type</label>
                            </div>
                            <div class="pe-2 col-md-8">
                                <RadioList @bind-Value="genderSelectionType">
                                    <RadioItem Value="0" Title="Hide Gender" />
                                    <RadioItem Value="1" Title="Clear Gender" />
                                </RadioList>
                            </div>
                        </div>

                            <EntitySearch Service="enumSearchService">
                                <DropdownList TValue="CustomerType" @bind-Value="context.CustomerType" ColSpan="8" OnSearch="SearchOnCustomerType" />
                                @if (showGender || genderSelectionType == 1)
                                {
                                    <DropdownList @bind-Value="context.Gender" ColSpan="8" />
                                }
                            </EntitySearch>
                            <div class="pt-3">
                                <DataGrid TEntity="Customer" Service="enumSearchService" ShowInsertIcon="false">
                                    <Columns>
                                        <GridColumn Field='t => t.CustomerType == CustomerType.Real ? t.FName + " " + t.LName : t.CompanyName' Title="Name" />
                                        <GridColumn Field="t => t.CustomerType.EnumText()" />
                                        <GridColumn Field="t => t.Gender.EnumText()" />
                                    </Columns>
                                </DataGrid>
                            </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <div class="pe-3">
                            <h4>Search on foreign key</h4>
                            <span class="pe-4 c-demo-description">
                                In this example, we define a variable of City type and bind CountryId for search.
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <EntitySearch Service="CityService">
                            <ComboBox TEntity="Country" TValue="int" @bind-Value="context.CountryId" TextExpression="t => t.Title" ColSpan="8" />
                        </EntitySearch>
                        <div class="pt-3">
                            <DataGrid TEntity="City" Service="CityService" ShowInsertIcon="false">
                                <Columns>
                                    <GridColumn Field="t => t.Country.Title" Title="Country" />
                                    <GridColumn Field="t => t.Title" />
                                </Columns>
                            </DataGrid>
                        </div>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document FolderName="Grid-Search" FileName="Grid-Search" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
<h3 class="pt-3">Search on number, date and time</h3>
<p>
    Usually we search <b>in range</b> for <b>number, date and time</b>. For example <b>from date-to date</b>.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6 pe-4">
                        <h4>Search on number</h4>
                        <span class="c-demo-description">In this example, we define a variable of <b>Customer type</b> and <b>bind first name, last name and company name</b> for search. </span>
                    </div>
                    <div class="col-md-6">
                        <div class="row pb-3 c-controls ps-3 pe-3">
                            <div class="col-md-4">
                                <label>From price</label>
                            </div>
                            <div class="col-md-8">
                                <NumericTextBox @bind-Value="fromPrice" />
                            </div>
                            <div class="col-md-4">
                                <label>To price</label>
                            </div>
                            <div class="col-md-8">
                                <NumericTextBox @bind-Value="toPrice" />
                            </div>
                        </div>
                        <DataGrid TEntity="Product" >
                            <Columns>
                                <GridColumn Field="t => t.ProductCategory.Title" Title="Product category" />
                                <GridColumn Field="t => t.Title" />
                                <GridColumn Field="t => t.Price.DigitGrouping()" @bind-From="fromPrice" @bind-To="toPrice" />
                            </Columns>
                        </DataGrid>
                    </div>
                    <div class="col-md-6 pe-4">
                        <hr />
                        <h4>Search on date</h4>
                        <span class="c-demo-description">In this example, we define a variable of <b>Customer type</b> and <b>bind first name, last name and company name</b> for search. </span>
                    </div>
                    <div class="col-md-6">
                        <hr />
                        <EntitySearch Service="OrderDetailService">
                            <div class="col-md-4">
                                <label>From date</label>
                            </div>
                            <div class="col-md-8">
                                <DatePicker @bind-Value="fromDate" />
                            </div>
                            <div class="col-md-4">
                                <label>To date</label>
                            </div>
                            <div class="col-md-8">
                                <DatePicker @bind-Value="toDate" />
                            </div>
                        </EntitySearch>
                        <DataGrid TEntity="OrderDetail">
                            <Columns>
                                <GridColumn Field="t => t.Order.Date" Title="Order date" @bind-From="fromDate" @bind-To="toDate" />
                                <GridColumn Field="t => t.Product.Title" />
                                <GridColumn Field="t => t.Quantity" />
                            </Columns>
                        </DataGrid>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document FolderName="Grid-Search" FileName="Search-Range" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
<h3 class="pt-3">Custom search</h3>
<p>
    In some cases we want to search with a specific format.
</p>
<TabPanel>
    <Tabs>
        <TabPanelItem Title="<i class='fa fa-bar-chart'></i>Demo">
            <div class="d-content">
                <div class="row">
                    <div class="col-md-6 pe-4">
                        <h4>Custom search:</h4>
                        <span class="c-demo-description">
                            In this example, the <b>isOutOfStock</b> variable is <b>nullable boolean</b>, if isOutOfStock <b>is null</b>, we have <b>no filter</b>, otherwise we filter based on the isOutOfStock variable.
                        </span>
                    </div>
                    <div class="col-md-6">
                        <div class="row pb-3 c-controls ps-3 pe-3">
                            <div class="col-md-6">
                                <label>Out of stock</label>
                            </div>
                            <div class="col-md-6">
                                <CheckBox @bind-Value="isOutOfStock" OnChange="() => gridProduct.EnableLoading()" />
                            </div>
                        </div>
                        <DataGrid @ref="gridProduct" TEntity="Product" ConditionExpr="t => isOutOfStock == null || t.OutofStock == isOutOfStock">
                            <Columns>
                                <GridColumn Field="t => t.Title" />
                                <GridColumn Field="t => t.Price.DigitGrouping()" />
                                <GridColumn Field="t => t.OutofStock" />
                            </Columns>
                        </DataGrid>
                    </div>
                </div>
            </div>
        </TabPanelItem>
        <TabPanelItem Title="<i class='fa fa-code'></i>Razor">
            <Document FolderName="Grid-Search" FileName="Search-Custom" />
        </TabPanelItem>
    </Tabs>
</TabPanel>
@code 
{
    //Default search
    bool showGender;
    int genderSelectionType;
    City citySearch = new City();
    Customer customerStringSearch = new ();
    ISearchService<Customer> enumSearchService;
    object fromPrice;
    object toPrice;
    object fromDate;
    object toDate;
    //
    bool? isOutOfStock;
    DataGrid<Product> gridProduct;
    IServiceScope scope;

    protected override void OnInitialized()
    {
        scope = ServiceScopeFactory.CreateScope();
        enumSearchService = scope.ServiceProvider.GetService<ISearchService<Customer>>();
        base.OnInitialized();
    }

    public override void Dispose()
    {
        scope.Dispose();
    }

    void SearchOnCustomerType(IEnumerable<CustomerType> customerTypes)
    {
        if (genderSelectionType == 0) ///Hide Gender
            showGender = customerTypes.Contains(CustomerType.Real);
        else ///Clear Gender
        {
            if (!customerTypes.Contains(CustomerType.Real))
                (Service ).GetEnumField(t => t.Gender.Value).SetValues();
        }
    }
}
