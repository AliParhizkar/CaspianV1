@typeparam TValue
@namespace Demo.Web.Pages
@inherits LookupWindow<AccountCoding, TValue>
<div class="c-lookup-page" style="width:700px;">
    <EntitySearch TEntity="AccountCoding" Service="Service">
        <StringTextBox @ref="txtCode" @bind-Value="searchCode" Title="کد" ColSpan="2" TotalSpan="4" />
        <StringTextBox @ref="txtTitle" @bind-Value="context.Title" ColSpan="6" TotalSpan="8" />
    </EntitySearch>
    <div class="p-2">
        <DataGrid Service="Service" TEntity="AccountCoding" ContentHeight="200" 
                  ConditionExpr="t => t.Level == level && ((code + searchCode)== null || t.Code.StartsWith(code + searchCode))">
            <Columns>
                <GridColumn Field="t => t.Code" Title="کد حساب">
                    <Template>
                        <span>@context.Data.Code.Substring(lenth)</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="t => t.Title" />
                <GridColumn DataField Field="t => t.Level" />
            </Columns>
        </DataGrid>
    </div>

    <div class="a-titles ps-3">
        @for (var i = 1; i < level; i++)
        {
            <span>@(titles[i - 1])</span>
            if (i < level - 1)
            {
                <span class="fa fa-angle-double-right"></span>
            }
        }
    </div>
</div>

@code
{
    StringTextBox txtTitle, txtCode;
    string code, searchCode;
    int level = 1, lenth;
    string[] titles = new string[5];

    protected override void OnInitialized()
    {
        OnSelect = async t =>
        {
            var grid = Service.DataView as DataGrid<AccountCoding>;
            var coding = grid.GetSelectedData();
            code = coding.Code;
            lenth = code.Length;
            titles[level - 1] = coding.Title;
            level = coding.Level + 1;
            await grid.ReloadAsync();
            grid.SelectFirstRow();
            if (Service.Search.Code.HasValue())
                await txtCode.SetValueOnClientAsync("");
            if (Service.Search.Title.HasValue())
                await txtTitle.SetValueOnClientAsync("");

        };
        base.OnInitialized();
    }
}
