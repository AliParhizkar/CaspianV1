@page "/Demo/Test"
@namespace Demo.Web.Pages
<div class="row c-controls ps-3 pe-3">
    <div class="col-md-2">
        <label>سال</label>
    </div>
    <div class="col-md-3">
        <DropdownList @bind-Value="year" Source="years" OnChange="CreateMenus" />
    </div>
    <div class="col-md-2"></div>
    <div class="col-md-2">
        <label>ماه</label>
    </div>
    <div class="col-md-3">
        <DropdownList @bind-Value="month" OnChange="CreateMenus" />
    </div>
</div>
<div class="main">
    <div class="days-week">
        <div class="c-day-week">ایام هفته</div>
        @foreach(var item in DayOfPersianWeek.Tus.DisplayNames().Select(t => t.Key))
        {
            <div class="c-day-week">@(item)</div>
        }
    </div>
    <div class="weeks">
        <div class="weeks-title">
            @for (var i = 0; i < weeksCount; i++)
            {
                <div class="week-title week-@(weeksCount)">هفته @weeksName[i]</div>
            }
        </div>
        <div class="d-calendar">
            @foreach (var date in dates)
            {
                var className = $"day-month week-{weeksCount}";
                @if (date.HasValue)
                {
                    if (selectedDates.Contains(date.Value))
                        className += " d-Selected";
                    <div class="@className" @onclick="e => ToggleDate(e, date.Value)">
                        <span>@date.ToPersianDateString()</span>
                    </div>
                }
                else
                {
                    <div class="@(className)"></div>
                }
            }
        </div>
    </div>
</div>


@code
{
    List<DateTime> selectedDates = new ();
    List<SelectListItem> years;
    int weeksCount, year = DateTime.Now.ToPersianDate().Year.Value;
    PersianMonth month = DateTime.Now.ToPersianDate().Month.Value;
    string[] weeksName = {"اول", "دوم", "سوم", "چهارم", "پنجم", "ششم"};
    IList<DateTime?> dates;

    void ToggleDate(MouseEventArgs e, DateTime date)
    {
        if (e.CtrlKey)
        {
            if (selectedDates.Contains(date))
                selectedDates.Remove(date);
            else
                selectedDates.Add(date);
        }
        else
        {
            selectedDates.Clear();
            selectedDates.Add(date);
        }
    }

    protected override void OnInitialized()
    {
        years = new();
        for(int i = 1400; i <= 1410; i++)
            years.Add(new SelectListItem(i.ToString(), i.ToString()));
        CreateMenus();
        base.OnInitialized();
    }

    void CreateMenus()
    {
        dates = PersianDate.GetDaysOfMonth(year, month);
        weeksCount = dates.Count / 7;
    }
}