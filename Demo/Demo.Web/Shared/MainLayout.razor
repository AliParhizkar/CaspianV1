@namespace Demo.Web
@using System.Reflection
@inherits LayoutComponentBase
@using Caspian.Engine.Shared
<MainLayoutComponent PageId="pageId">
    @Body
</MainLayoutComponent>
@code 
{
    int? pageId;
    protected override void OnParametersSet()
    {
        var sourceAttribute = (Body.Target as RouteView)?.RouteData.PageType.GetCustomAttribute<SourceAttribute>();
        if (sourceAttribute == null)
            throw new CaspianException("sourceAttribute is null it should be add to any page that has PageAttribute");
        pageId = (Body.Target as RouteView)?.RouteData.PageType.GetCustomAttribute<SourceAttribute>().Id;
        base.OnParametersSet();
    }
}