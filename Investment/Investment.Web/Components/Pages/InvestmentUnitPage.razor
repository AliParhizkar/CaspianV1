@page "/Investment/InvestmentUnit"
@inject IUIService<InvestmentUnit> Service
@attribute [Source(1, "نوع اموال")]
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div class="p-3">
    <EntitySearch Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Title" ColSpan="4" />
        <StringTextBox @bind-Value="context.Code" ColSpan="4" />
    </EntitySearch>
    <DataGrid TEntity="InvestmentUnit" Service="Service" ContentHeight="350">
        <Columns>
            <GridColumn Field="t => t.Title" />
            <GridColumn Field="t => t.Code" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="نوع اموال" Style="width:450px">
    <CaspianForm TEntity="InvestmentUnit" Service="Service">
        <Content Context="city">
            <StringTextBox @bind-Value="city.Title" ColSpan="8" />
            <StringTextBox @bind-Value="city.Code" ColSpan="8" Style="direction:ltr" />
            <FormCommandButton ColSpan="8" />
        </Content>
    </CaspianForm>
</Window>

