@page "/Investment/OrganUnit"
@inherits BasePage
@attribute [Source(2, "واحد سازمانی")]
@inject IUIService<OrganUnit> Service
@{
    base.BuildRenderTree(__builder);
}
<div style="width:600px;margin:5px auto" class="row">
    <div class="col-md-1 text-center pt-1">
        <span class="d-tree-icon" @onclick="async () => await ShowEditForm(null, false)">
            <span class="fa fa-plus"></span>
        </span>
    </div>
    <div class="col-md-7 pb-1">
        <StringTextBox @bind-Value="@categorySearch" OnChange="async () => await tree.ReloadAsync()" BindingType="BindingType.OnInput" placeholder="جستجو گروه محصول" />
    </div>
    <div class="col-md-4 pb-1 pe-2">
        <CheckBox @bind-Value="onlyActiveOrganUnit" Title="فقط واحدهای سازمانی فعال" OnChange="async () => await tree.ReloadAsync() " />
    </div>
    <TreeView @ref="tree" TEntity="OrganUnit" style="height:500px" TextFunc="t => t.Title"
              FilterFunc="t => (!categorySearch.HasValue() || t.Title.StartsWith(categorySearch)) && (!onlyActiveOrganUnit || t.ActiveStatus == ActiveStatus.Active)">
        <AfterNodeTemplate>
            <span class="d-tree-icon">
                <span @onclick="async () => await ShowEditForm(context, false)" class="fa fa-plus"></span>
            </span>
            <span class="d-tree-icon" @onclick="async () => await ShowEditForm(context, true)">
                <span class="fa fa-pencil"></span>
            </span>
            <span class="d-tree-icon" @onclick="async () => await DeleteOrganUnit(context)">
                <span class="fa fa-trash"></span>
            </span>
            @if (context.Children == null || context.Children.Count == 0)
            {
                <span class="d-tree-icon" title="گروههای سازمانی">
                    <a href="/Investment/OrganPost/@(context.Value)">
                        <span class="fa fa-wpforms"></span>
                    </a>
                </span>
            }
        </AfterNodeTemplate>
    </TreeView>
</div>

<Window @bind-Status="status" Style="width:450px;" OnOpen="async () => await firstControl.FocusAsync()" Title="گروه محصول">
    <CaspianForm Model="organUnit" TEntity="OrganUnit" OnValidSubmit="UpsertCategory">
        @if (title.HasValue())
        {
            <StringTextBox @bind-Value="title" ColSpan="9" Title="گروه اصلی" Disabled />
        }
        <StringTextBox @ref="firstControl" @bind-Value="context.Title" ColSpan="9" />
        <DropdownList @bind-Value="context.ActiveStatus" ColSpan="9" />
        <WindowCommandButtons ColSpan="9" />
    </CaspianForm>
</Window>
@code
{
    bool onlyActiveOrganUnit = true;
    string title;
    string categorySearch;
    TreeView<OrganUnit> tree;
    OrganUnit organUnit;
    WindowStatus status;
    IControl firstControl;

    async Task ShowEditForm(NodeView nodeView, bool isUpdate)
    {
        using var service = CreateScope().GetService<OrganUnitService>();
        if (isUpdate)
        {
            //For Edit
            var organUnitId = Convert.ToInt32(nodeView.Value);
            organUnit = await service.SingleAsync(organUnitId);
            title = null;
        }
        else
        {
            organUnit = new OrganUnit();
            organUnit.ActiveStatus = ActiveStatus.Active;
            organUnit.ParentOrganUnitId = nodeView == null ? null : Convert.ToInt32(nodeView.Value);
            title = nodeView?.Text;
        }
        status = WindowStatus.Open;
    }

    async Task DeleteOrganUnit(NodeView node)
    {
        var organUnitId = Convert.ToInt32(node.Value);
        using var service = CreateScope().GetService<OrganUnitService>();
        var organUnit = await service.SingleAsync(organUnitId);
        var result = await service.ValidateRemoveAsync(organUnit);
        if (result.IsValid)
        {
            if (await Confirm("آیا با حذف واحد سازمانی موافقید؟"))
            {
                service.Remove(organUnit);
                await service.SaveChangesAsync();
                tree.RemoveFromTree(organUnit);
            }
        }
        else
            ShowMessage(result.Errors.First().ErrorMessage);
    }


    async Task<bool> UpsertCategory()
    {
        using var service = CreateScope().GetService<OrganUnitService>();
        if (organUnit.Id == 0)
            await service.AddAsync(organUnit);
        else
            await service.UpdateAsync(organUnit);
        await service.SaveChangesAsync();
        tree.UpsertInTree(organUnit);
        status = WindowStatus.Close;
        StateHasChanged();
        return true;
    }
}
