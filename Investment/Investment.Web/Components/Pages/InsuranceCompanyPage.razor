@page "/Investment/InsuranceCompany"
@inject IUIService<InsuranceCompany> Service
@attribute [Source(15, "شرکت های بیمه")]
@inherits BasePage
@{
    base.BuildRenderTree(__builder);
}
<div class="p-3">
    <EntitySearch Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Code" ColSpan="4" />
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
    </EntitySearch>
    <DataGrid TEntity="InsuranceCompany" Service="Service" ContentHeight="350">
        <Columns>
            <GridColumn Field="t => t.Code" />
            <GridColumn Field="t => t.Name" />
            <GridColumn Field="t => t.InsuranceCompanyType.EnumText()" />
            <GridColumn Field="t => t.NationalCode" />
            <GridColumn Field="t => t.EconomicCode" />
            <GridColumn Field="t => t.City.Title" Title="شهر" />
            <GridColumn Field="t => t.Tell" />
            <GridColumn Field="t => t.Fax" />
            <GridCommandColumns />
        </Columns>
    </DataGrid>
</div>

<Window Service="Service" Title="شرکت های بیمه" Style="width:800px">
    <CaspianForm TEntity="InsuranceCompany" Service="Service" ColumnsCount="2">
        <StringTextBox @bind-Value="context.Code" ColSpan="4" Style="direction:ltr" />
        <StringTextBox @bind-Value="context.Name" ColSpan="4" />
        <DropdownList @bind-Value="context.InsuranceCompanyType" ColSpan="4" />
        <StringTextBox @bind-Value="context.NationalCode" Style="direction:ltr" ColSpan="4" />
        <StringTextBox @bind-Value="context.EconomicCode" Style="direction:ltr" ColSpan="4" />
        <Lookup TValue="int" TEntity="AccountingCode" @bind-Value="context.AccountingCodeId" TextExpression="t => t.Name" OnSelecting="CheckStatus" ColSpan="4">
            <Accounting.Component.CodingLookup />
        </Lookup>
        <ComboBox TValue="int" TEntity="Location" @bind-Value="context.ProvinceId" TextExpression="t => t.Title" ColSpan="4" 
                  ConditionExpression="t => t.LocationType == LocationType.Province" OnChange="() => cmbCities.EnableLoading()" />
        <ComboBox @ref="cmbCities" TValue="int?" TEntity="Location" @bind-Value="context.CityId" TextExpression="t => t.Title" ColSpan="4" ConditionExpression="t => t.ParentId == context.ProvinceId" />
        <StringTextBox @bind-Value="context.Tell" Style="direction:ltr" ColSpan="4" />
        <StringTextBox @bind-Value="context.Fax" Style="direction:ltr" ColSpan="4" />
        <StringTextBox @bind-Value="context.Address" ColSpan="10" TotalSpan="12" MultiLine Rows="2" />
        <StringTextBox @bind-Value="context.Description" ColSpan="10" TotalSpan="12" MultiLine Rows="2" />
        <FormCommandButton ColSpan="8" />
    </CaspianForm>
</Window>

@code
{
    ComboBox<Location, int?> cmbCities;

    async Task CheckStatus(SelectStatus status)
    {
        using var service = CreateScope().GetService<AccountingCodeService>();
        status.Cancel = await service.GetAll().AnyAsync(t => t.ParentCodeId == status.Id);
    }
}
