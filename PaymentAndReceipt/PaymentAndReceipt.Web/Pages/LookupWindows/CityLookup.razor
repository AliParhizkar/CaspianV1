@typeparam TValue
@namespace PaymentAndReceipt.Web
@inherits LookupWindow<City, TValue>
<div class="c-lookup-page" style="width:700px;">
    <div class="p-2">
        <DataGrid Service="Service" TEntity="City" ContentHeight="200">
            <Columns>
                <GridColumn Field="t => t.Province.Name" Title="استان" />
                <GridColumn Field="t => t.Name" />
            </Columns>
        </DataGrid>
    </div>
</div>

@code
{
    protected override void OnInitialized()
    {
        InitialSearchExpression(t => LookupStringSearchValue == null || t.Name.Contains(LookupStringSearchValue));
        base.OnInitialized();
    }
}
